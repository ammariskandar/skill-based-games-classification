{
  "name": "skill-based-games-classification",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "source apps/backend/.venv/bin/activate && python apps/backend/manage.py runserver",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "test:frontend": "npm run test --workspace=apps/frontend",
    "test:backend": "apps/backend/.venv/bin/python apps/backend/manage.py test apps/backend --settings=config.settings.test --noinput",
    "test:backend:discovery": "scripts/backend-test-discovery.sh",
    "test:backend:reverse": "apps/backend/.venv/bin/python apps/backend/manage.py test apps/backend --settings=config.settings.test --noinput --reverse",
    "test:backend:shuffle": "apps/backend/.venv/bin/python apps/backend/manage.py test apps/backend --settings=config.settings.test --noinput --shuffle",
    "test:backend:warnings": "apps/backend/.venv/bin/python -Wa apps/backend/manage.py test apps/backend --settings=config.settings.test --noinput 2>&1",
    "test:backend:postgresql": "scripts/backend-test-postgresql.sh",
    "typecheck:backend": "apps/backend/.venv/bin/basedpyright --project .",
    "test": "npm run test:frontend && npm run test:backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm run lint --workspace=apps/frontend",
    "lint:backend": "apps/backend/.venv/bin/ruff check apps/backend",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "npm run format --workspace=apps/frontend",
    "format:backend": "apps/backend/.venv/bin/ruff format apps/backend",
    "format:check": "npm run format:check --workspace=apps/frontend && apps/backend/.venv/bin/ruff format --check apps/backend",
    "check": "npm run check:frontend && npm run check:backend",
    "check:frontend": "npm run check --workspace=apps/frontend",
    "check:backend": "apps/backend/.venv/bin/python apps/backend/manage.py check",
    "check:backend:deploy": "scripts/backend-deploy-check.sh",
    "migrate": "source apps/backend/.venv/bin/activate && python apps/backend/manage.py migrate",
    "install:backend": "python3 -m venv apps/backend/.venv && apps/backend/.venv/bin/python -m pip install -r apps/backend/requirements.txt",
    "ci": "npm run format:check && npm run lint && npm run test:backend:discovery && npm run check:backend:deploy && npm run check && npm run test && npm run check:design-reference && npm run build:frontend",
    "check:design-reference": "! grep -r --include='*.astro' --include='*.ts' --include='*.tsx' --include='*.js' --include='*.mjs' --include='*.css' -l 'design-reference' apps/frontend/src apps/frontend/astro.config.mjs 2>/dev/null",
    "update:skills-context": "apps/backend/.venv/bin/python scripts/update-skills-context.py"
  }
}

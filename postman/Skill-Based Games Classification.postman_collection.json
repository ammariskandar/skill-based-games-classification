{
  "info": {
    "name": "Skill-Based Games Classification",
    "description": "Postman collection for the SBGC-57 authorized Steam import and refresh HTTP API. Requires a locally running Django development server and an authenticated staff session (session + CSRF). No secrets are committed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 System",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health returns 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('health body is ok', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health",
                ""
              ]
            },
            "description": "Public liveness probe. No authentication, no database, no Steam."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Acquire CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let token = '';",
                  "const setCookie = pm.response.headers.get('Set-Cookie');",
                  "if (setCookie) {",
                  "    const m = setCookie.match(/csrftoken=([^;]+)/);",
                  "    if (m) token = m[1];",
                  "}",
                  "if (!token) {",
                  "    const cookie = pm.cookies.get('csrftoken');",
                  "    token = typeof cookie === 'string' ? cookie : (cookie && cookie.value) || '';",
                  "}",
                  "if (token) {",
                  "    pm.environment.set('csrf_token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{admin_url_path}}/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{admin_url_path}}",
                "login",
                ""
              ]
            },
            "description": "Fetches the Django Admin login page to obtain the csrftoken cookie. The cookie value is captured into {{csrf_token}} for the Login request."
          },
          "response": []
        },
        {
          "name": "Login (establish staff session)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('session cookie established', function () {",
                  "    pm.expect(pm.cookies.get('sessionid')).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "csrfmiddlewaretoken",
                  "value": "{{csrf_token}}",
                  "type": "text"
                },
                {
                  "key": "next",
                  "value": "/{{admin_url_path}}/",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/{{admin_url_path}}/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{admin_url_path}}",
                "login",
                ""
              ]
            },
            "description": "Authenticates against Django's existing Admin login to establish a session. Uses {{username}}/{{password}} (local-only, empty in this repo) and the csrftoken acquired in the previous request. After login, Django rotates the CSRF cookie; subsequent mutation requests read the fresh csrftoken from the cookie jar."
          },
          "response": []
        }
      ]
    },
    {
      "name": "10 Steam Import",
      "item": [
        {
          "name": "Valid import",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('status is a valid import status', function () {",
                  "    pm.expect(['created', 'updated', 'unchanged', 'unavailable']).to.include(body.status);",
                  "});",
                  "pm.test('app_id echoes request', function () {",
                  "    pm.expect(body.app_id).to.eql(pm.variables.get('steam_app_id'));",
                  "});",
                  "if (body.game) {",
                  "    pm.test('game.source_type is steam', function () {",
                  "        pm.expect(body.game.source_type).to.eql('steam');",
                  "    });",
                  "    pm.test('game.external_id matches requested app id', function () {",
                  "        pm.expect(body.game.external_id).to.eql(pm.variables.get('steam_app_id'));",
                  "    });",
                  "    pm.environment.set('game_id', body.game.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_id\": \"{{steam_app_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/games/steam/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "steam",
                "import"
              ]
            },
            "description": "Imports (or re-imports) the Steam App ID from {{steam_app_id}}. Captures the resulting canonical game_id into {{game_id}} for the refresh requests. Requires an authenticated staff session (run 01 Authentication first)."
          },
          "response": []
        },
        {
          "name": "Re-import same app",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('re-import is unchanged or updated', function () {",
                  "    pm.expect(['unchanged', 'updated']).to.include(body.status);",
                  "});",
                  "if (body.game) {",
                  "    pm.test('same game identity', function () {",
                  "        pm.expect(body.game.id).to.eql(Number(pm.environment.get('game_id')));",
                  "    });",
                  "    pm.environment.set('game_id', body.game.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_id\": \"{{steam_app_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/games/steam/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "steam",
                "import"
              ]
            },
            "description": "Re-imports the same App ID. Must return the same canonical game_id; status is UNCHANGED (or UPDATED if upstream Steam metadata changed since the first import)."
          },
          "response": []
        },
        {
          "name": "Invalid App ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});",
                  "pm.test('error code is BAD_REQUEST', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('BAD_REQUEST');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_id\": \"not-a-number\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/games/steam/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "steam",
                "import"
              ]
            },
            "description": "Domain-level invalid App ID (a non-decimal string). The request schema accepts it as a string, but the Steam service rejects it; the API maps it to 400 BAD_REQUEST."
          },
          "response": []
        },
        {
          "name": "Missing body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', function () {",
                  "    pm.expect(pm.response.code).to.eql(422);",
                  "});",
                  "pm.test('error code is VALIDATION_ERROR', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/games/steam/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "steam",
                "import"
              ]
            },
            "description": "Missing/empty request body. The import request schema requires app_id, so this returns 422 VALIDATION_ERROR before any service call."
          },
          "response": []
        },
        {
          "name": "Unauthorized import",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () {",
                  "    pm.expect(pm.response.code).to.eql(401);",
                  "});",
                  "pm.test('error code is AUTHENTICATION_ERROR', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('AUTHENTICATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_id\": \"{{steam_app_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/games/steam/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "steam",
                "import"
              ]
            },
            "description": "Anonymous import attempt. Run with no session (clear cookies or run before 01 Authentication). Expected 401 AUTHENTICATION_ERROR."
          },
          "response": []
        }
      ]
    },
    {
      "name": "20 Steam Refresh",
      "item": [
        {
          "name": "Refresh captured Game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('status is updated/unchanged/unavailable', function () {",
                  "    pm.expect(['updated', 'unchanged', 'unavailable']).to.include(body.status);",
                  "});",
                  "pm.test('game identity preserved', function () {",
                  "    pm.expect(body.game.id).to.eql(Number(pm.environment.get('game_id')));",
                  "});",
                  "if (body.status !== 'unavailable') {",
                  "    pm.test('refresh timestamp present when FOUND', function () {",
                  "        pm.expect(body.game.last_steam_refresh_at).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/games/{{game_id}}/steam/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "{{game_id}}",
                "steam",
                "refresh"
              ]
            },
            "description": "Refreshes the Steam Game captured by the import requests. The Game is identified by its internal ID ({{game_id}}); the persisted Steam identity is the only App ID used. Requires an authenticated staff session."
          },
          "response": []
        },
        {
          "name": "Manual Game rejection",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});",
                  "pm.test('error code is BAD_REQUEST', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('BAD_REQUEST');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/games/{{manual_game_id}}/steam/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "{{manual_game_id}}",
                "steam",
                "refresh"
              ]
            },
            "description": "Attempts to refresh a manual (non-Steam) Game. The service rejects it (SteamRefreshError) without any Steam network call; the API maps it to 400 BAD_REQUEST. Set {{manual_game_id}} to an existing manual Game ID."
          },
          "response": []
        },
        {
          "name": "Game not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () {",
                  "    pm.expect(pm.response.code).to.eql(404);",
                  "});",
                  "pm.test('error code is NOT_FOUND', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/games/999999/steam/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "999999",
                "steam",
                "refresh"
              ]
            },
            "description": "Nonexistent internal Game ID. Returns 404 NOT_FOUND before any Steam service/network call."
          },
          "response": []
        },
        {
          "name": "Unauthorized refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () {",
                  "    pm.expect(pm.response.code).to.eql(401);",
                  "});",
                  "pm.test('error code is AUTHENTICATION_ERROR', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('AUTHENTICATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/games/{{game_id}}/steam/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "{{game_id}}",
                "steam",
                "refresh"
              ]
            },
            "description": "Anonymous refresh attempt. Run with no session. Expected 401 AUTHENTICATION_ERROR."
          },
          "response": []
        }
      ]
    }
  ]
}
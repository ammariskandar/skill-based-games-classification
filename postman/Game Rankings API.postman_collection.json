    {
      "name": "03 Dominant Filter",
      "item": [
        {
          "name": "Unified Micro dominant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('count is a non-negative integer', function () {",
                  "    pm.expect(Number.isInteger(body.count)).to.be.true;",
                  "    pm.expect(body.count).to.be.at.least(0);",
                  "});",
                  "pm.test('results length matches count and page_size', function () {",
                  "    pm.expect(body.results.length).to.be.at.most(body.page_size);",
                  "    pm.expect(body.results.length).to.be.at.most(body.count);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rankings/?profile=unified&dominant=micro",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rankings", ""],
              "query": [
                { "key": "profile", "value": "unified" },
                { "key": "dominant", "value": "micro" }
              ]
            },
            "description": "Fetches the Unified ranking filtered to Games whose summed Challenge+Reward Micro dimension is strictly highest. Asserts the response is well-formed (count may be 0 when no Game has a dominant category)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 Pagination",
      "item": [
        {
          "name": "Paginated (page 2, size 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('page and page_size reflect the request', function () {",
                  "    pm.expect(body.page).to.eql(2);",
                  "    pm.expect(body.page_size).to.eql(5);",
                  "});",
                  "pm.test('results length does not exceed page_size', function () {",
                  "    pm.expect(Array.isArray(body.results)).to.be.true;",
                  "    pm.expect(body.results.length).to.be.at.most(5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rankings/?page=2&page_size=5",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rankings", ""],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "page_size", "value": "5" }
              ]
            },
            "description": "Fetches page 2 with page_size 5 and asserts the pagination fields reflect the request (results length at most 5)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 Validation",
      "item": [
        {
          "name": "Invalid profile → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', function () {",
                  "    pm.expect(pm.response.code).to.eql(422);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('error code is VALIDATION_ERROR', function () {",
                  "    pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rankings/?profile=bogus",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rankings", ""],
              "query": [
                { "key": "profile", "value": "bogus" }
              ]
            },
            "description": "Sends an invalid `profile` value and asserts the standard 422 validation envelope (not a silent fallback)."
          },
          "response": []
        }
      ]
    }
  ]
}

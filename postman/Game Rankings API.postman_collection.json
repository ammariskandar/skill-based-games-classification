{
  "info": {
    "name": "Game Rankings API",
    "description": "Postman collection for the SBGC-81 public Game rankings endpoint (`GET /api/v1/rankings/`). Covers the five human checks: Unified Micro desc, Challenge Macro asc, Reward Mystiko desc, one dominant filter, and one paginated request, plus an invalid-enum validation check. Public read-only — no authentication, no Steam, no CSRF. Requires a locally running Django development server and the `base_url` variable from `local.postman_environment.json`. Unified scores may be `.5`; this is expected and not rounded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Unified",
      "item": [
        {
          "name": "Unified Micro desc (defaults)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('envelope has pagination fields', function () {",
                  "    pm.expect(body).to.have.property('count');",
                  "    pm.expect(body).to.have.property('page');",
                  "    pm.expect(body).to.have.property('page_size');",
                  "    pm.expect(body).to.have.property('total_pages');",
                  "    pm.expect(body).to.have.property('results');",
                  "});",
                  "pm.test('defaults are page 1 and page_size 24', function () {",
                  "    pm.expect(body.page).to.eql(1);",
                  "    pm.expect(body.page_size).to.eql(24);",
                  "});",
                  "pm.test('each item exposes the ranking keys', function () {",
                  "    body.results.forEach(function (item) {",
                  "        pm.expect(item).to.have.property('slug');",
                  "        pm.expect(item).to.have.property('name');",
                  "        pm.expect(item).to.have.property('hero_url');",
                  "        pm.expect(item).to.have.property('score');",
                  "    });",
                  "});",
                  "pm.test('score is a number', function () {",
                  "    body.results.forEach(function (item) {",
                  "        pm.expect(typeof item.score).to.eql('number');",
                  "    });",
                  "});",
                  "pm.test('scores are descending (non-increasing)', function () {",
                  "    const scores = body.results.map(function (r) { return r.score; });",
                  "    for (let i = 1; i < scores.length; i++) {",
                  "        pm.expect(scores[i - 1] >= scores[i]).to.be.true;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rankings/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rankings", ""]
            },
            "description": "Fetches the default ranking (Unified profile, Micro dimension, descending). Asserts the envelope shape, the ranking item keys, numeric scores, and descending order."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Challenge & Reward",
      "item": [
        {
          "name": "Challenge Macro asc",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('scores are ascending (non-decreasing)', function () {",
                  "    const scores = body.results.map(function (r) { return r.score; });",
                  "    for (let i = 1; i < scores.length; i++) {",
                  "        pm.expect(scores[i - 1] <= scores[i]).to.be.true;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rankings/?profile=challenge&dimension=macro&direction=asc",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rankings", ""],
              "query": [
                { "key": "profile", "value": "challenge" },
                { "key": "dimension", "value": "macro" },
                { "key": "direction", "value": "asc" }
              ]
            },
            "description": "Fetches the Challenge Macro ranking in ascending order and asserts the scores are non-decreasing."
          },
          "response": []
        },

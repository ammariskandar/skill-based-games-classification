              "raw": "{{base_url}}/api/v1/rankings/?profile=reward&dimension=mystiko&direction=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rankings", ""],
              "query": [
                { "key": "profile", "value": "reward" },
                { "key": "dimension", "value": "mystiko" },
                { "key": "direction", "value": "desc" }
              ]

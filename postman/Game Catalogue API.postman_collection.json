{
  "info": {
    "name": "Game Catalogue API",
    "description": "Postman collection for the SBGC-76 public Game catalogue endpoint (`GET /api/v1/games/`). Covers the three human checks: base catalogue, search/filters, and pagination/classification truth. Public read-only — no authentication, no Steam, no CSRF. Requires a locally running Django development server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Base Catalogue",
      "item": [
        {
          "name": "List all games (default pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('envelope has pagination fields', function () {",
                  "    pm.expect(body).to.have.property('count');",
                  "    pm.expect(body).to.have.property('page');",
                  "    pm.expect(body).to.have.property('page_size');",
                  "    pm.expect(body).to.have.property('total_pages');",
                  "    pm.expect(body).to.have.property('results');",
                  "});",
                  "pm.test('count is a non-negative integer', function () {",
                  "    pm.expect(Number.isInteger(body.count)).to.be.true;",
                  "    pm.expect(body.count).to.be.at.least(0);",
                  "});",
                  "pm.test('defaults are page 1 and page_size 24', function () {",
                  "    pm.expect(body.page).to.eql(1);",
                  "    pm.expect(body.page_size).to.eql(24);",
                  "});",
                  "pm.test('results length does not exceed page_size', function () {",
                  "    pm.expect(Array.isArray(body.results)).to.be.true;",
                  "    pm.expect(body.results.length).to.be.at.most(body.page_size);",
                  "});",
                  "pm.test('each item has the catalogue keys', function () {",
                  "    body.results.forEach(function (item) {",
                  "        pm.expect(item).to.have.property('slug');",
                  "        pm.expect(item).to.have.property('name');",
                  "        pm.expect(item).to.have.property('source');",
                  "        pm.expect(item).to.have.property('image_url');",
                  "        pm.expect(item).to.have.property('library_capsule_url');",
                  "        pm.expect(item).to.have.property('classification');",
                  "    });",
                  "});",
                  "pm.test('source is steam or manual', function () {",
                  "    body.results.forEach(function (item) {",
                  "        pm.expect(['steam', 'manual']).to.include(item.source);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/games/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "games", ""]
            },
            "description": "Fetches the first page of the public catalogue with default pagination. Asserts the envelope shape, default page/page_size, and that each item exposes the expected public fields."
          },
          "response": []
        },
        {
          "name": "Stable ordering (name ascending)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('results ordered by name ascending', function () {",
                  "    const names = body.results.map(function (r) { return r.name; });",
                  "    for (let i = 1; i < names.length; i++) {",
                  "        pm.expect(names[i - 1] <= names[i]).to.be.true;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/games/?page_size=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "games", ""],
              "query": [
                { "key": "page_size", "value": "50" }
              ]
            },
            "description": "Fetches a larger page and asserts deterministic ordering (`name ASC, id ASC`)."
          },
          "response": []
        }
      ]
    },

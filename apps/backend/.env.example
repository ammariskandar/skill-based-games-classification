# Secret key — keep this value secret, never commit a real key.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Production refuses to boot with DEBUG enabled (DJANGO_DEBUG must be
# false/0/no/off or omitted outside development).
# DJANGO_DEBUG=False

# Comma-separated hostnames — no wildcards, schemes, paths, or credentials.
# Development: 127.0.0.1,localhost
# Production:  your-render-app.onrender.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins trusted for CSRF cookie-authenticated requests.
# Must use HTTPS in production.  No paths, queries, or fragments.
# Development: http://localhost:4321
# Production:  https://your-render-app.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:4321
# Leave unset or blank for local SQLite development.
# For Neon, use a direct non-pooler connection string.
# Hosts containing "-pooler" are pooled connections and must not be used
# for the current connection mode (SBGC-39 uses direct connections only).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
DATABASE_URL=
# Require TLS for PostgreSQL connections (true/false/1/0/yes/no).  Production
# defaults to enabled; development defaults to disabled.
# DB_SSL_REQUIRE=False

# Steam Web API key — optional at startup, required only for authenticated
# Steam API calls.  Sent only through the x-webapi-key header, never in
# query strings, logs, or errors.
# STEAM_WEB_API_KEY=

# reCAPTCHA v3 secret — required in production (the score gate bypasses when
# unset, which is DEBUG/test behaviour only).  Local development can leave it
# blank: DEBUG mode accepts the canonical "test-recaptcha-token".
# RECAPTCHA_SECRET_KEY=

# Local mail delivery via smtp4dev (SBGC-218/219).
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=2525
# DEFAULT_FROM_EMAIL=noreply@mygamedna.local

# ADMIN_URL_PATH must be a single relative path segment (letters, digits,
# hyphens, underscores only; starts with letter or digit).  The segment
# "api" is reserved.  Changing the default adds defence-in-depth but is
# not a primary security control.
ADMIN_URL_PATH=mygamedna-admin

# HSTS duration in seconds — production default is 31536000 (1 year) with
# includeSubDomains + preload enabled (SBGC-105).  Lower temporarily only to
# stage a rollout; never commit a production "0".
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Steam HTTP client timeouts and retry limits.
# STEAM_CONNECT_TIMEOUT_SECONDS=3.05
# STEAM_READ_TIMEOUT_SECONDS=10
# STEAM_MAX_RETRIES=2
# STEAM_RETRY_BACKOFF_SECONDS=0.25
# STEAM_RETRY_SLEEP_MAX_SECONDS=5
# STEAM_MAX_RESPONSE_BYTES=2097152

# Comma-separated trusted Steam CDN hostnames (exact match, no wildcards).
# Empty means all CDN URLs are rejected until configured.
# STEAM_CDN_ALLOWED_HOSTS=

# SBGC-183 — scheduled Steam metadata refresh.
# Comma-separated fallback recipient emails for the daily Steam-refresh
# failure alert.  Used only when no valid active Superuser email exists.
# This is configuration, not a secret — leave blank to rely on Superuser
# recipients only.
# STEAM_REFRESH_FALLBACK_EMAILS=

# Sender address for operational alert emails (scheduled Steam refresh).
# DEFAULT_FROM_EMAIL=webmaster@localhost

# SBGC-43 — logging level (INFO, DEBUG, WARNING, ERROR, CRITICAL).
# DJANGO_LOG_LEVEL=INFO

# Gunicorn worker count.
# WEB_CONCURRENCY=2

# SBGC-106 — reCAPTCHA v3 site key (public; rendered into the admin login
# page).  Required in production alongside RECAPTCHA_SECRET_KEY.  Local dev
# can leave it blank: the admin login page omits the challenge.
# RECAPTCHA_SITE_KEY=

# SBGC-106 — username of the system owner allowed to reactivate a
# security-locked account.  Leave blank to disable owner-exclusive unlock.
# DJANGO_OWNER_USERNAME=your_owner_username

# SBGC-107 — comma-separated explicit IP addresses (no hostnames) trusted to
# supply X-Client-Real-IP.  Anything else is treated as an untrusted caller.
# TRUSTED_INTERNAL_PROXIES=127.0.0.1,::1

# =============================================================================
# SBGC-185 — least-privilege database roles & SQLi scan-branch toggles
# =============================================================================

# Runtime connection for Gunicorn/Django workers.  Use the scoped DML-only
# role (scripts/db-provision-app-role.sql) — never the Neon project owner.
# When using Neon's PgBouncer, point this at the -pooler hostname; Django runs
# with CONN_MAX_AGE=0 in production so pooled connections never persist state.
# DATABASE_URL=

# Direct (non-pooled) connection for schema migrations and createcachetable.
# Release phase only (scripts/backend-migrate.sh): uses the project-owner role
# which holds DDL privileges.  backend-migrate.sh refuses pooled hosts.
# MIGRATION_DATABASE_URL=

# DML role provisioning (run against MIGRATION_DATABASE_URL):
#   psql "$MIGRATION_DATABASE_URL" \
#     -v app_user="$APP_DJANGO_DB_USER" \
#     -v app_password="$APP_DJANGO_DB_PASSWORD" \
#     -f scripts/db-provision-app-role.sql
# APP_DJANGO_DB_USER=
# APP_DJANGO_DB_PASSWORD=

# SBGC-185 — application rate-limiting toggles (both default to enabled).
# Set to false ONLY on a dedicated security scan/preview branch so automated
# SQLi probes (sqlmap, time-blind payloads) are not swallowed by the SBGC-107
# load-shedders.  Never disable on a production-traffic branch.
# API_RATE_LIMITING_ENABLED=true
# ADMIN_THROTTLING_ENABLED=true

# =============================================================================
# SBGC-186 — dual-superuser quota & inactivity rotation
# =============================================================================

# System owner: exempt from the superuser quota and the only account able to
# reactivate a security-locked account.
# DJANGO_OWNER_USERNAME=your_owner_username

# The two designated superusers subject to the dual-superuser quota.  Production
# requires both (and the owner) to be non-empty and mutually distinct.
# DJANGO_SUPERUSER_1=
# DJANGO_SUPERUSER_2=

# Days of inactivity before a designated superuser is demoted and a top
# moderator is temporarily promoted (default 180 = 6 months).
# SUPERUSER_INACTIVITY_DAYS=180

# Name of the group whose members are eligible for temporary promotion.  This
# group cannot be renamed or deleted through Django Admin.
# MODERATOR_GROUP_NAME=Moderator

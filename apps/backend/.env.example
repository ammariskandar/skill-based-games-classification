# Secret key — keep this value secret, never commit a real key.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames — no wildcards, schemes, paths, or credentials.
# Development: 127.0.0.1,localhost
# Production:  your-render-app.onrender.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins trusted for CSRF cookie-authenticated requests.
# Must use HTTPS in production.  No paths, queries, or fragments.
# Development: http://localhost:4321
# Production:  https://your-render-app.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:4321
# Leave unset or blank for local SQLite development.
# For Neon, use a direct non-pooler connection string.
# Hosts containing "-pooler" are pooled connections and must not be used
# for the current connection mode (SBGC-39 uses direct connections only).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
DATABASE_URL=
# STEAM_WEB_API_KEY=
# ADMIN_URL_PATH must be a single relative path segment (letters, digits,
# hyphens, underscores only; starts with letter or digit).  The segment
# "api" is reserved.  Changing the default adds defence-in-depth but is
# not a primary security control.
ADMIN_URL_PATH=mygamedna-admin

# HSTS duration in seconds — production default is zero until initial
# HTTPS deployment is verified.  Stage at 3600, then increase to 31536000.
# DJANGO_SECURE_HSTS_SECONDS=0

# Steam Web API key — optional at startup, required only for authenticated
# Steam API calls.  Sent only through the x-webapi-key header, never in
# query strings, logs, or errors.
# STEAM_WEB_API_KEY=

# Steam HTTP client timeouts and retry limits.
# STEAM_CONNECT_TIMEOUT_SECONDS=3.05
# STEAM_READ_TIMEOUT_SECONDS=10
# STEAM_MAX_RETRIES=2
# STEAM_RETRY_BACKOFF_SECONDS=0.25
# STEAM_RETRY_SLEEP_MAX_SECONDS=5
# STEAM_MAX_RESPONSE_BYTES=2097152

# Comma-separated trusted Steam CDN hostnames (exact match, no wildcards).
# Empty means all CDN URLs are rejected until configured.
# STEAM_CDN_ALLOWED_HOSTS=

# SBGC-43 — logging level (INFO, DEBUG, WARNING, ERROR, CRITICAL).
# DJANGO_LOG_LEVEL=INFO

# Gunicorn worker count.
# WEB_CONCURRENCY=2

# ─────────────────────────────────────────────────────────────────────────────
# Server-only (Astro SSR / BFF) — never expose these to client JS.
# Only variables prefixed PUBLIC_ are inlined into the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────
DJANGO_API_URL=http://127.0.0.1:8000
# Optional alias used by auth BFF relays when DJANGO_API_URL is not set.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Reserved: internal BFF shared-secret header (not yet enforced).
# INTERNAL_BFF_SECRET=

# Public site origin (canonical URL building).
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_GOOGLE_ANALYTICS_ID=

# Client-public reCAPTCHA v3 site key (browser bundle).
# Leave blank in local dev: the DEBUG backend accepts a test token instead.
PUBLIC_RECAPTCHA_SITE_KEY=

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import { buildCanonicalUrl, resolveSiteOrigin } from "../lib/seo";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: string;
  /** Discovery routes enable a low-priority background Search-index preload. */
  preloadGameSearchIndex?: boolean;
}

const DEFAULT_DESCRIPTION =
  "Classifying games through the lens of skill, using Micro, Mystiko, and Macro dimensions within separate Challenge and Reward profiles.";

const titleTemplate = Astro.props.title
  ? `${Astro.props.title} | MyGameDNA`
  : "MyGameDNA";

const description = Astro.props.description ?? DEFAULT_DESCRIPTION;

const preloadSearch = Astro.props.preloadGameSearchIndex ?? false;

const siteOrigin = resolveSiteOrigin(import.meta.env.PUBLIC_SITE_URL);
const canonicalUrl = Astro.props.canonicalPath
  ? buildCanonicalUrl(siteOrigin, Astro.props.canonicalPath)
  : siteOrigin;

const image = Astro.props.image ?? null;
const imageAlt = Astro.props.imageAlt ?? null;
const jsonLd = Astro.props.jsonLd ?? null;
const twitterCard = image ? "summary_large_image" : "summary";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleTemplate}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={Astro.props.robots ?? "index, follow"} />

    <meta property="og:site_name" content="MyGameDNA" />
    <meta property="og:title" content={titleTemplate} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {
      image && (
        <>
          <meta property="og:image" content={image} />
          {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        </>
      )
    }

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={titleTemplate} />
    <meta name="twitter:description" content={description} />
    {
      image && (
        <>
          <meta name="twitter:image" content={image} />
          {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
        </>
      )
    }

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <GoogleAnalytics />
  </head>
  <body
    class="min-h-screen bg-bg text-text antialiased"
    data-preload-search={preloadSearch ? "true" : "false"}
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-blue focus:px-4 focus:py-2 focus:text-bg focus:outline-none"
    >
      Skip to content
    </a>

    <Header />

    <main id="main-content" class="shell-gutter py-8 sm:py-12">
      <slot />
    </main>

    <Footer />
  </body>
</html>

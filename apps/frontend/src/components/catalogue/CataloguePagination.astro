---
import {
  catalogueHrefFromState,
  type CatalogueQueryState,
} from "../../lib/catalogue-presentation";

interface Props {
  page: number;
  totalPages: number;
  /** Full active query state so pagination preserves filters/sort/search. */
  state: CatalogueQueryState;
}

const { page, totalPages, state } = Astro.props;
const hasPrevious = page > 1;
const hasNext = page < totalPages;

// SBGC-241: instant page revisits. The catalogue markup stays server-owned, so
// rather than caching slices in JavaScript the browser is asked to prerender the
// pagination targets once hover intent is shown; a revisit then activates an
// already rendered document with no intermediate loading state. Engines without
// speculation support fall back to the `rel="prefetch"` hints on the links
// below. Rendered from the frontmatter because a bare JSON literal in a script
// element is not valid JavaScript for the toolchain parsers.
const speculationRules = {
  prerender: [
    {
      where: { selector_matches: "a.catalogue-pagination__link" },
      eagerness: "moderate",
    },
  ],
};
---

<nav class="catalogue-pagination" aria-label="Catalogue pagination">
  {
    hasPrevious ? (
      <a
        class="catalogue-pagination__link"
        href={catalogueHrefFromState(state, page - 1)}
        rel="prefetch"
      >
        Previous
      </a>
    ) : (
      <span
        class="catalogue-pagination__link catalogue-pagination__link--disabled"
        aria-disabled="true"
      >
        Previous
      </span>
    )
  }

  <span class="catalogue-pagination__status">
    Page <span aria-current="page">{page}</span> of {totalPages}
  </span>

  {
    hasNext ? (
      <a
        class="catalogue-pagination__link"
        href={catalogueHrefFromState(state, page + 1)}
        rel="prefetch"
      >
        Next
      </a>
    ) : (
      <span
        class="catalogue-pagination__link catalogue-pagination__link--disabled"
        aria-disabled="true"
      >
        Next
      </span>
    )
  }
</nav>

<script
  type="speculationrules"
  is:inline
  set:html={JSON.stringify(speculationRules)}
/>

<style>
  .catalogue-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .catalogue-pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .catalogue-pagination__link:hover {
    border-color: var(--color-border-2);
    background: var(--color-surface-2);
  }

  .catalogue-pagination__link:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  .catalogue-pagination__link--disabled {
    color: var(--color-dim);
    cursor: not-allowed;
    background: transparent;
  }

  .catalogue-pagination__link--disabled:hover {
    border-color: var(--color-border);
    background: transparent;
  }

  .catalogue-pagination__status {
    font-size: 0.875rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
</style>

---
import Navigation from "./Navigation.astro";
import HeaderSearch from "./HeaderSearch.astro";
import NavbarAuth from "./NavbarAuth.astro";

// Desktop renders About outside the shared Navigation list, so it owns its
// own active-state detection (mirrors Navigation.astro's rule).
const pathname = Astro.url.pathname;
const isAboutActive = pathname === "/about" || pathname.startsWith("/about/");
---

<header
  class="relative border-b border-border bg-surface/80 backdrop-blur-sm"
  data-header
>
  <div class="shell-gutter">
    <!-- ── Desktop row (lg and above) ── -->
    <div
      class="desktop-nav-row hidden lg:flex items-center justify-between gap-4 py-3"
      data-desktop-row
    >
      <a
        href="/"
        class="shrink-0 text-lg font-bold tracking-tight text-text hover:text-blue transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue rounded"
      >
        MyGameDNA
      </a>

      <div class="ml-auto flex items-center gap-1 sm:gap-2">
        <div class="flex items-center gap-1 sm:gap-2" data-desktop-collapsible>
          <div>
            <Navigation omit={["About"]} />
          </div>
          <a
            href="/about"
            aria-current={isAboutActive ? "page" : undefined}
            class:list={[
              "inline-block rounded px-3 py-1.5 text-sm font-medium transition-colors",
              "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue",
              isAboutActive
                ? "bg-surface-2 text-text"
                : "text-muted hover:bg-surface-2 hover:text-text",
            ]}
          >
            About
          </a>
          <NavbarAuth />
        </div>
        <HeaderSearch />
      </div>
    </div>

    <!-- ── Compact bar (below lg) ── -->
    <div
      class="compact-nav-bar flex lg:hidden items-center py-3"
      data-compact-bar
    >
      <div class="flex w-full items-center" data-compact-collapsible>
        <details id="nav-disclosure">
          <summary
            class="list-none cursor-pointer p-2 -ml-2 rounded hover:bg-surface-2 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
            aria-expanded="false"
            aria-controls="nav-panel"
          >
            <span class="sr-only">Navigation menu</span>
            <svg
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <line x1="2" y1="5" x2="18" y2="5"></line>
              <line x1="2" y1="10" x2="18" y2="10"></line>
              <line x1="2" y1="15" x2="18" y2="15"></line>
            </svg>
          </summary>
          <div
            id="nav-panel"
            class="absolute left-0 right-0 top-full z-40 border-t border-border bg-surface/95 backdrop-blur-sm"
          >
            <div class="shell-gutter py-3">
              <Navigation class="flex-col items-start gap-1" />
              <NavbarAuth compact class="mt-2" />
            </div>
          </div>
        </details>

        <a
          href="/"
          class="flex-1 text-center text-lg font-bold tracking-tight text-text hover:text-blue transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue rounded"
        >
          MyGameDNA
        </a>
      </div>

      <div class="flex-shrink-0">
        <HeaderSearch compact />
      </div>
    </div>
  </div>

  <!-- Pre-paint auth swap (SBGC-217): runs synchronously during HTML parsing,
       before the browser paints, so the cached username never "pops in" after
       the logged-out navbar is already visible.  The processed module script
       below cannot do this — it is deferred until after first paint.
       Cache key must mirror lib/auth-status.ts AUTH_STATUS_CACHE_KEY. -->
  <script is:inline>
    (() => {
      const AUTH_CACHE_KEY = "mygamedna:auth-status:v1";
      const LOGGED_OUT = { authenticated: false, username: null };

      const readCache = () => {
        try {
          const raw = sessionStorage.getItem(AUTH_CACHE_KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (
            parsed &&
            typeof parsed === "object" &&
            parsed.authenticated === true &&
            typeof parsed.username === "string"
          ) {
            return parsed;
          }
          return null;
        } catch {
          return null;
        }
      };

      const writeCache = (status) => {
        try {
          sessionStorage.setItem(AUTH_CACHE_KEY, JSON.stringify(status));
        } catch {
          /* storage unavailable */
        }
      };

      const clearCache = () => {
        try {
          sessionStorage.removeItem(AUTH_CACHE_KEY);
        } catch {
          /* storage unavailable */
        }
      };

      const paintAll = (status) => {
        const isAuthenticated =
          status.authenticated === true && typeof status.username === "string";
        for (const root of document.querySelectorAll("[data-navbar-auth]")) {
          const loggedOut = root.querySelector("[data-auth-logged-out]");
          const loggedIn = root.querySelector("[data-auth-logged-in]");
          const username = root.querySelector("[data-auth-username]");
          if (loggedOut) loggedOut.classList.toggle("hidden", isAuthenticated);
          if (loggedIn) {
            loggedIn.classList.toggle("hidden", !isAuthenticated);
            loggedIn.classList.toggle("flex", isAuthenticated);
          }
          if (isAuthenticated && username && status.username) {
            username.textContent = status.username;
            username.setAttribute("title", `Profile: ${status.username}`);
          }
        }
      };

      // A logout just happened in this tab (the BFF set the flash toast before
      // the 303 redirect): never flash a stale cached username.
      if (document.cookie.includes("flash_toast=logout_success")) {
        clearCache();
        paintAll(LOGGED_OUT);
        return;
      }

      // Paint the cached username synchronously — before first paint — then
      // re-validate against the BFF in the background.
      const cached = readCache();
      if (cached) paintAll(cached);

      fetch("/api/auth/status", { headers: { Accept: "application/json" } })
        .then((res) => (res.ok ? res.json() : LOGGED_OUT))
        .then((status) => {
          paintAll(status);
          writeCache(status);
        })
        .catch(() => {
          /* best-effort refresh — keep whatever is painted */
        });
    })();
  </script>
</header>

<script>
  (() => {
    const details = document.getElementById("nav-disclosure");
    if (!details) return;

    const summary = details.querySelector("summary");
    if (!summary) return;

    const panel = document.getElementById("nav-panel");
    const links = panel ? panel.querySelectorAll("a") : [];

    const MQL = window.matchMedia("(min-width: 64rem)");

    // Sync aria-expanded after every native toggle (click, Enter, Space, no-JS)
    details.addEventListener("toggle", () => {
      summary.setAttribute(
        "aria-expanded",
        details.hasAttribute("open") ? "true" : "false",
      );
    });

    // Escape closes and returns focus (not native in all browsers)
    summary.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && details.hasAttribute("open")) {
        details.removeAttribute("open");
        summary.focus();
      }
    });

    // Close panel when a nav link is activated
    for (const link of links) {
      link.addEventListener("click", () => {
        details.removeAttribute("open");
      });
    }

    // Reset stale open state when crossing into desktop layout
    MQL.addEventListener("change", (e) => {
      if (e.matches) details.removeAttribute("open");
    });
  })();
</script>

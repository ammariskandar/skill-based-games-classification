---
import GameImage from "../game/GameImage.astro";
import type { GameDetailGame } from "../../lib/server/api";

interface Props {
  /** `null` means Hades could not be resolved; the copy still renders. */
  game: GameDetailGame | null;
}

const { game } = Astro.props;
---

<section class="homepage-showcase" aria-labelledby="homepage-showcase-heading">
  <div class="homepage-showcase__grid">
    <div class="homepage-showcase__art">
      {
        game ? (
          <GameImage
            src={game.image_url}
            name={game.name}
            slug={game.slug}
            source={game.source}
            libraryHeroUrl={game.library_hero_url}
            libraryCapsuleUrl={game.library_capsule_url}
          />
        ) : (
          <div
            class="homepage-showcase__art-placeholder"
            role="img"
            aria-label="Example game artwork unavailable"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <circle cx="8.5" cy="10" r="1.5" />
              <path d="M21 15l-5-5L5 20" />
            </svg>
          </div>
        )
      }
    </div>

    <div class="homepage-showcase__copy">
      <h2 id="homepage-showcase-heading" class="homepage-showcase__heading">
        Every game has its own skill DNA
      </h2>

      <p>
        Every game on MyGameDNA is evaluated through separate Challenge and
        Reward skill profiles. Expert assessments and player submissions are
        combined through a rigorous statistical methodology designed to preserve
        expert insight without overriding the broader player consensus. The
        result is a distinct skill “DNA” for every game. Learn how the model
        works in our{" "}
        <a href="/methodology" class="homepage-showcase__link"> Methodology </a>
        .
      </p>

      <p>
        Contribute by creating an account and submitting classifications for
        games you know, or simply explore MyGameDNA to discover games with skill
        profiles similar to the ones you already love. MyGameDNA is, and will
        always remain, free to use.
      </p>
    </div>
  </div>
</section>

<style>
  .homepage-showcase {
    margin-top: 3rem;
  }

  .homepage-showcase__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .homepage-showcase__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .homepage-showcase__heading {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .homepage-showcase__copy p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .homepage-showcase__copy p + p {
    margin-top: 1rem;
  }

  .homepage-showcase__link {
    color: var(--color-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .homepage-showcase__link:hover {
    text-decoration-thickness: 2px;
  }

  .homepage-showcase__link:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .homepage-showcase__art-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-dim);
  }

  .homepage-showcase__art-placeholder svg {
    width: 2.5rem;
    height: 2.5rem;
  }
</style>

---
import type { HomepageCarouselCard } from "../../lib/server/api";

interface Props {
  /** `null` means the backend endpoint is unavailable; `[]` means no matches. */
  games: HomepageCarouselCard[] | null;
}

const { games } = Astro.props;
const unavailable = games === null;
const resolved = games ?? [];
const hasGames = resolved.length > 0;
---

<section class="homepage-carousel" aria-labelledby="homepage-carousel-heading">
  <div class="homepage-carousel__header">
    <h2 id="homepage-carousel-heading" class="homepage-carousel__heading">
      Explore Steam games
    </h2>
    {
      hasGames && (
        <div class="homepage-carousel__controls">
          <button
            type="button"
            class="homepage-carousel__button"
            data-carousel-prev
            aria-label="Previous games"
          >
            <span aria-hidden="true">←</span>
          </button>
          <button
            type="button"
            class="homepage-carousel__button"
            data-carousel-next
            aria-label="Next games"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      )
    }
  </div>

  {
    unavailable ? (
      <p class="homepage-carousel__empty">
        Games are unavailable right now. Please check back shortly.
      </p>
    ) : !hasGames ? (
      <p class="homepage-carousel__empty">No Steam games to show yet.</p>
    ) : (
      <div
        class="homepage-carousel__track"
        data-carousel-track
        tabindex="0"
        aria-label="Steam games carousel"
      >
        {resolved.map((game) => (
          <a
            class="homepage-carousel__card"
            data-carousel-card
            href={`/games/${game.slug}`}
          >
            <span class="homepage-carousel__media">
              <img
                src={game.library_capsule_url}
                alt={`${game.name} box art`}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="homepage-carousel__title">{game.name}</span>
          </a>
        ))}
      </div>
    )
  }
</section>

<script>
  (() => {
    const track = document.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = document.querySelector<HTMLButtonElement>(
      "[data-carousel-prev]",
    );
    const next = document.querySelector<HTMLButtonElement>(
      "[data-carousel-next]",
    );
    if (!track || !prev || !next) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const step = (): number => {
      const card = track.querySelector<HTMLElement>("[data-carousel-card]");
      if (!card) return Math.floor(track.clientWidth * 0.8);
      const gap =
        parseFloat(
          getComputedStyle(track).columnGap || getComputedStyle(track).gap,
        ) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled =
        track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    prev.addEventListener("click", () => {
      track.scrollBy({
        left: -step(),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    });
    next.addEventListener("click", () => {
      track.scrollBy({
        left: step(),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    });

    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();
</script>

<style>
  .homepage-carousel {
    /* Break out of the shell gutter so the track runs edge-to-edge. */
    margin-inline: calc(-1 * var(--gutter, 1rem));
  }

  .homepage-carousel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--gutter, 1rem);
    margin-bottom: 1.25rem;
  }

  .homepage-carousel__heading {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .homepage-carousel__controls {
    display: flex;
    gap: 0.5rem;
  }

  .homepage-carousel__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .homepage-carousel__button:hover {
    border-color: var(--color-border-2);
    background: var(--color-surface-2);
  }

  .homepage-carousel__button:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  .homepage-carousel__button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .homepage-carousel__empty {
    padding-inline: var(--gutter, 1rem);
    color: var(--color-muted);
  }

  .homepage-carousel__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter, 1rem);
    padding-inline: var(--gutter, 1rem);
    scrollbar-width: none;
  }

  .homepage-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .homepage-carousel__card {
    scroll-snap-align: start;
    flex: 0 0 calc((100% - 1rem) / 2);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text);
    border-radius: var(--radius-md);
    transition: transform 0.2s ease;
  }

  @media (min-width: 40rem) {
    .homepage-carousel__card {
      flex-basis: calc((100% - 2rem) / 3);
    }
  }

  @media (min-width: 64rem) {
    .homepage-carousel__card {
      flex-basis: calc((100% - 4rem) / 5);
    }
  }

  .homepage-carousel__card:hover,
  .homepage-carousel__card:focus-visible {
    transform: scale(1.02);
  }

  .homepage-carousel__card:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  .homepage-carousel__media {
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
  }

  .homepage-carousel__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .homepage-carousel__title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-carousel__card {
      transition: none;
    }

    .homepage-carousel__card:hover,
    .homepage-carousel__card:focus-visible {
      transform: none;
    }
  }
</style>

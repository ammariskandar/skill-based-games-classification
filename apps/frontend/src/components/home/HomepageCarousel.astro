---
import type { HomepageCarouselCard } from "../../lib/server/api";

interface Props {
  /** `null` means the backend endpoint is unavailable; `[]` means no matches. */
  games: HomepageCarouselCard[] | null;
}

const { games } = Astro.props;
const unavailable = games === null;
const resolved = games ?? [];
const hasGames = resolved.length > 0;
---

<section class="homepage-carousel" aria-labelledby="homepage-carousel-heading">
  <div class="homepage-carousel__header">
    <h2 id="homepage-carousel-heading" class="homepage-carousel__heading">
      Explore Steam games
    </h2>
  </div>

  {
    unavailable ? (
      <p class="homepage-carousel__empty">
        Games are unavailable right now. Please check back shortly.
      </p>
    ) : !hasGames ? (
      <p class="homepage-carousel__empty">No Steam games to show yet.</p>
    ) : (
      <div class="homepage-carousel__viewport">
        <div
          class="homepage-carousel__track"
          data-carousel-track
          tabindex="0"
          aria-label="Steam games carousel"
        >
          {resolved.map((game) => (
            <a
              class="homepage-carousel__card"
              data-carousel-card
              href={`/games/${game.slug}`}
            >
              <span class="homepage-carousel__media">
                <img
                  src={game.library_capsule_url}
                  alt={`${game.name} box art`}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="homepage-carousel__title">{game.name}</span>
            </a>
          ))}
        </div>

        <button
          type="button"
          class="homepage-carousel__arrow homepage-carousel__arrow--prev"
          data-carousel-prev
          aria-label="Previous games"
        >
          <svg
            aria-hidden="true"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 5l-7 7 7 7" />
          </svg>
        </button>
        <button
          type="button"
          class="homepage-carousel__arrow homepage-carousel__arrow--next"
          data-carousel-next
          aria-label="Next games"
        >
          <svg
            aria-hidden="true"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    )
  }
</section>

<script>
  import {
    assignCarouselEmphasis,
    visibleCardsForViewport,
  } from "../../lib/homepage-carousel";

  (() => {
    const track = document.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = document.querySelector<HTMLButtonElement>(
      "[data-carousel-prev]",
    );
    const next = document.querySelector<HTMLButtonElement>(
      "[data-carousel-next]",
    );
    if (!track || !prev || !next) return;

    const viewport = track.parentElement;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const cards = Array.from(
      track.querySelectorAll<HTMLElement>("[data-carousel-card]"),
    );

    const step = (): number => {
      const card = cards[0];
      if (!card) return Math.floor(track.clientWidth * 0.8);
      const gap =
        parseFloat(
          getComputedStyle(track).columnGap || getComputedStyle(track).gap,
        ) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    // Vertically center the arrows on the Capsule region (the media), not the
    // taller media + title card. `top: 50%` in CSS is the pre-JS fallback.
    const measureArrows = () => {
      const media = track.querySelector<HTMLElement>(
        ".homepage-carousel__media",
      );
      if (!media || !viewport) return;
      const top = `${media.offsetHeight / 2}px`;
      prev.style.top = top;
      next.style.top = top;
    };

    const applyEmphasis = () => {
      const visibleCount = visibleCardsForViewport(window.innerWidth);
      const trackRect = track.getBoundingClientRect();
      const viewportCenter = trackRect.left + trackRect.width / 2;

      const distances = cards.map((card) => {
        const rect = card.getBoundingClientRect();
        const center = rect.left + rect.width / 2;
        return Math.round(Math.abs(center - viewportCenter));
      });

      const emphasis = assignCarouselEmphasis(distances, visibleCount);
      cards.forEach((card, index) => {
        card.dataset.emphasis = emphasis[index];
      });
    };

    const updateArrows = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled =
        track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    const refresh = () => {
      updateArrows();
      applyEmphasis();
    };

    let rafId = 0;
    const schedule = () => {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = 0;
        refresh();
      });
    };

    prev.addEventListener("click", () => {
      track.scrollBy({
        left: -step(),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    });
    next.addEventListener("click", () => {
      track.scrollBy({
        left: step(),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    });

    track.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", () => {
      measureArrows();
      schedule();
    });
    window.addEventListener("load", () => {
      measureArrows();
      schedule();
    });

    measureArrows();
    refresh();
  })();
</script>

<style>
  .homepage-carousel {
    /* Break out of the shell gutter so the track runs edge-to-edge. */
    margin-inline: calc(-1 * var(--gutter, 1rem));
  }

  .homepage-carousel__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: var(--gutter, 1rem);
    margin-bottom: 1.25rem;
  }

  .homepage-carousel__heading {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .homepage-carousel__empty {
    padding-inline: var(--gutter, 1rem);
    color: var(--color-muted);
  }

  .homepage-carousel__viewport {
    position: relative;
  }

  .homepage-carousel__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter, 1rem);
    padding-inline: var(--gutter, 1rem);
    scrollbar-width: none;
  }

  .homepage-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .homepage-carousel__card {
    scroll-snap-align: start;
    flex: 0 0 calc((100% - 1rem) / 2);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text);
    border-radius: var(--radius-md);
    transition: transform 0.2s ease;
    /* Positional dim base; `data-emphasis` overrides this per card. */
    --carousel-dim: 1;
  }

  @media (min-width: 40rem) {
    .homepage-carousel__card {
      flex-basis: calc((100% - 2rem) / 3);
    }
  }

  @media (min-width: 64rem) {
    .homepage-carousel__card {
      flex-basis: calc((100% - 4rem) / 5);
    }
  }

  .homepage-carousel__card[data-emphasis="intermediate"] {
    --carousel-dim: 0.82;
  }

  .homepage-carousel__card[data-emphasis="darkest"] {
    --carousel-dim: 0.62;
  }

  .homepage-carousel__card:hover,
  .homepage-carousel__card:focus-visible {
    transform: scale(1.02);
  }

  .homepage-carousel__card:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  .homepage-carousel__media {
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
  }

  .homepage-carousel__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--carousel-dim));
    transition: filter 0.25s ease;
  }

  /* Hover/focus lift composes on top of the positional dim rather than
     replacing it, so the center stays the base full-brightness focal card. */
  .homepage-carousel__card:hover .homepage-carousel__media img,
  .homepage-carousel__card:focus-visible .homepage-carousel__media img {
    filter: brightness(var(--carousel-dim)) brightness(1.12);
  }

  .homepage-carousel__title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    color: var(--color-text);
  }

  .homepage-carousel__arrow {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border-2);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-text);
    box-shadow:
      0 4px 16px rgb(0 0 0 / 0.5),
      0 0 0 1px rgb(0 0 0 / 0.25);
    cursor: pointer;
  }

  .homepage-carousel__arrow--prev {
    left: 0.5rem;
  }

  .homepage-carousel__arrow--next {
    right: 0.5rem;
  }

  @media (min-width: 64rem) {
    .homepage-carousel__arrow {
      width: 2.75rem;
      height: 2.75rem;
    }

    .homepage-carousel__arrow--prev {
      left: 0.75rem;
    }

    .homepage-carousel__arrow--next {
      right: 0.75rem;
    }
  }

  .homepage-carousel__arrow:hover {
    background: var(--color-surface-3);
  }

  .homepage-carousel__arrow:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  .homepage-carousel__arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-carousel__card,
    .homepage-carousel__media img {
      transition: none;
    }

    .homepage-carousel__card:hover,
    .homepage-carousel__card:focus-visible {
      transform: none;
    }
  }
</style>

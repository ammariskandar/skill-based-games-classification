---
import type { HomepageCarouselCard } from "../../lib/server/api";

interface Props {
  /** `null` means the backend endpoint is unavailable; `[]` means no matches. */
  games: HomepageCarouselCard[] | null;
}

const { games } = Astro.props;
const unavailable = games === null;
const resolved = games ?? [];
const hasGames = resolved.length > 0;
---

<section class="homepage-carousel" aria-labelledby="homepage-carousel-heading">
  <div class="homepage-carousel__header">
    <h2 id="homepage-carousel-heading" class="homepage-carousel__heading">
      Explore Steam games
    </h2>
  </div>

  {
    unavailable ? (
      <p class="homepage-carousel__empty">
        Games are unavailable right now. Please check back shortly.
      </p>
    ) : !hasGames ? (
      <p class="homepage-carousel__empty">No Steam games to show yet.</p>
    ) : (
      <div class="homepage-carousel__viewport">
        <div
          class="homepage-carousel__track"
          data-carousel-track
          tabindex="0"
          aria-label="Steam games carousel"
        >
          {resolved.map((game) => (
            <a
              class="homepage-carousel__card"
              data-carousel-card
              href={`/games/${game.slug}`}
            >
              <span class="homepage-carousel__media">
                {/* Eager, not lazy: the clone loop reveals off-screen cards on
                    wrap, so deferring fetch caused a visible pop-in when
                    scrolling backward quickly. */}
                <img
                  src={game.library_capsule_url}
                  alt={`${game.name} box art`}
                  loading="eager"
                  decoding="async"
                />
              </span>
              <span class="homepage-carousel__title">{game.name}</span>
            </a>
          ))}
        </div>

        <button
          type="button"
          class="homepage-carousel__arrow homepage-carousel__arrow--prev"
          data-carousel-prev
          aria-label="Previous games"
        >
          <svg
            aria-hidden="true"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 5l-7 7 7 7" />
          </svg>
        </button>
        <button
          type="button"
          class="homepage-carousel__arrow homepage-carousel__arrow--next"
          data-carousel-next
          aria-label="Next games"
        >
          <svg
            aria-hidden="true"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    )
  }
</section>

<script>
  import {
    carouselCloneCount,
    normalizeCarouselScroll,
  } from "../../lib/homepage-carousel";

  (() => {
    const track = document.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = document.querySelector<HTMLButtonElement>(
      "[data-carousel-prev]",
    );
    const next = document.querySelector<HTMLButtonElement>(
      "[data-carousel-next]",
    );
    if (!track || !prev || !next) return;

    const viewport = track.parentElement;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Canonical cards are the real rendered Games; boundary clones are added
    // around them to make the list circular.
    const canonicalCards = Array.from(
      track.querySelectorAll<HTMLElement>("[data-carousel-card]"),
    );
    const length = canonicalCards.length;

    const step = (): number => {
      const card = canonicalCards[0];
      if (!card) return 0;
      const gap =
        parseFloat(
          getComputedStyle(track).columnGap || getComputedStyle(track).gap,
        ) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    // Clones are `cloneNode` copies of the rendered cards, so they keep the
    // Astro scope attributes. They stay clickable/hoverable for pointer users
    // (the same `<a href>`), but are removed from the keyboard tab order and the
    // accessibility tree so canonical links remain the single announced/tabbable
    // destination. `inert` was too strong — it also killed hover and click.
    const cloneCard = (card: HTMLElement): HTMLElement => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.setAttribute("aria-hidden", "true");
      clone.tabIndex = -1;
      clone.dataset.carouselClone = "true";
      return clone;
    };

    let buffer = 0;

    // (Re)build the clone buffer. With intrinsic `rem` card sizing the number
    // of cards visible at once — and therefore the minimum clone buffer —
    // depends on the current viewport, so it is measured here rather than
    // hardcoded to a responsive tier. On a resize rebuild the visible logical
    // card is preserved rather than snapping back to Game 1.
    const buildLoop = (preservePosition: boolean): void => {
      const previousIndex =
        preservePosition && buffer > 0
          ? Math.max(
              0,
              Math.min(
                length - 1,
                Math.round(track.scrollLeft / step()) - buffer,
              ),
            )
          : 0;

      for (const el of track.querySelectorAll<HTMLElement>(
        "[data-carousel-clone]",
      )) {
        el.remove();
      }
      if (length < 2) {
        buffer = 0;
        return;
      }

      const visibleCount = Math.ceil(track.clientWidth / step());
      buffer = carouselCloneCount(length, visibleCount);

      // Tail clones (the last `buffer` cards) prepend before the first
      // canonical card; head clones (the first `buffer` cards) append after the
      // last canonical card.
      for (const card of canonicalCards.slice(length - buffer)) {
        track.insertBefore(cloneCard(card), canonicalCards[0]);
      }
      for (const card of canonicalCards.slice(0, buffer)) {
        track.appendChild(cloneCard(card));
      }

      // Start inside the canonical region (after the tail clones). On a resize
      // rebuild, restore the previously visible logical card.
      const startIndex = preservePosition ? buffer + previousIndex : buffer;
      track.scrollLeft = startIndex * step();
    };

    if (length >= 2) {
      buildLoop(false);
    }

    // Vertically center the arrows on the Capsule region (the media), not the
    // taller media + title card. `top: 50%` in CSS is the pre-JS fallback.
    const measureArrows = () => {
      const media = track.querySelector<HTMLElement>(
        ".homepage-carousel__media",
      );
      if (!media || !viewport) return;
      const top = `${media.offsetHeight / 2}px`;
      prev.style.top = top;
      next.style.top = top;
    };

    // Silently re-enter the canonical region when the scroll crosses a clone
    // boundary, preserving the apparent visual position.  The reposition is
    // instant (no animation) and idempotent.
    const normalize = () => {
      if (length < 2 || buffer === 0) return;
      const current = track.scrollLeft;
      const normalized = normalizeCarouselScroll(
        current,
        length,
        buffer,
        step(),
      );
      if (normalized !== current) {
        track.scrollLeft = normalized;
      }
    };

    // Infinite loop: arrows stay usable whenever the track can scroll; the only
    // degenerate case is a track that cannot scroll at all (no overflow).
    const updateArrows = () => {
      const canScroll = track.scrollWidth > track.clientWidth + 1;
      prev.disabled = !canScroll;
      next.disabled = !canScroll;
    };

    // The loop wrap must not run while a smooth scroll is animating: writing
    // `scrollLeft` mid-animation would cancel the `scrollBy` and could leave the
    // carousel pinned on the same card. Debounce it so `normalize` only fires
    // after the scroll has settled. The wrap itself stays an instant, invisible
    // reposition (a clone and its canonical twin show the same cards).
    let settleId = 0;
    const scheduleSettle = () => {
      window.clearTimeout(settleId);
      settleId = window.setTimeout(normalize, 120);
    };

    prev.addEventListener("click", () => {
      track.scrollBy({
        left: -step(),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    });
    next.addEventListener("click", () => {
      track.scrollBy({
        left: step(),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    });

    track.addEventListener("scroll", scheduleSettle, { passive: true });
    window.addEventListener("resize", () => {
      measureArrows();
      updateArrows();
      if (length >= 2) {
        buildLoop(true);
      }
      scheduleSettle();
    });
    window.addEventListener("load", () => {
      measureArrows();
      updateArrows();
      scheduleSettle();
    });

    measureArrows();
    updateArrows();
    normalize();
  })();
</script>

<style>
  .homepage-carousel {
    /* Break out of the shell gutter so the track runs edge-to-edge. */
    margin-inline: calc(-1 * var(--gutter, 1rem));
  }

  .homepage-carousel__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: var(--gutter, 1rem);
    margin-bottom: 1.25rem;
  }

  .homepage-carousel__heading {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .homepage-carousel__empty {
    padding-inline: var(--gutter, 1rem);
    color: var(--color-muted);
  }

  .homepage-carousel__viewport {
    position: relative;
  }

  .homepage-carousel__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter, 1rem);
    padding-inline: var(--gutter, 1rem);
    scrollbar-width: none;
  }

  .homepage-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .homepage-carousel__card {
    scroll-snap-align: start;
    /* Intrinsic `rem` width so browser zoom scales the Capsules naturally
       (SBGC-194). A viewport-fraction basis would keep cards at roughly the
       same physical size under zoom. ~11rem ≈ two cards on a phone. */
    flex: 0 0 11rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text);
    border-radius: var(--radius-md);
    transition: transform 0.2s ease;
  }

  @media (min-width: 40rem) {
    .homepage-carousel__card {
      flex-basis: 15rem;
    }
  }

  .homepage-carousel__card:hover,
  .homepage-carousel__card:focus-visible {
    transform: scale(1.02);
  }

  .homepage-carousel__card:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  .homepage-carousel__media {
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
  }

  .homepage-carousel__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.65);
    transition: filter 0.25s ease;
  }

  /* Hover and keyboard focus reveal full-brightness artwork. */
  .homepage-carousel__card:hover .homepage-carousel__media img,
  .homepage-carousel__card:focus-visible .homepage-carousel__media img {
    filter: brightness(1);
  }

  .homepage-carousel__title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    color: var(--color-text);
  }

  .homepage-carousel__arrow {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border-2);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-text);
    box-shadow:
      0 4px 16px rgb(0 0 0 / 0.5),
      0 0 0 1px rgb(0 0 0 / 0.25);
    cursor: pointer;
  }

  .homepage-carousel__arrow--prev {
    left: 0.5rem;
  }

  .homepage-carousel__arrow--next {
    right: 0.5rem;
  }

  @media (min-width: 64rem) {
    .homepage-carousel__arrow {
      width: 2.75rem;
      height: 2.75rem;
    }

    .homepage-carousel__arrow--prev {
      left: 0.75rem;
    }

    .homepage-carousel__arrow--next {
      right: 0.75rem;
    }
  }

  .homepage-carousel__arrow:hover {
    background: var(--color-surface-3);
  }

  .homepage-carousel__arrow:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  .homepage-carousel__arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-carousel__card,
    .homepage-carousel__media img {
      transition: none;
    }

    .homepage-carousel__card:hover,
    .homepage-carousel__card:focus-visible {
      transform: none;
    }
  }
</style>

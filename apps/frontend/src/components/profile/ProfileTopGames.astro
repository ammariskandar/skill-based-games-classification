---
import type { TopGameDto } from "../../lib/server/api/users";

interface Props {
  topGames: TopGameDto[];
  isSteamLinked: boolean;
}

const { topGames, isSteamLinked } = Astro.props;
---

<section class="profile-top-games" aria-labelledby="top-games-heading">
  <h2 id="top-games-heading" class="text-xl font-semibold text-text">
    Top 6 Games
  </h2>

  {
    !isSteamLinked ? (
      <div class="mt-4 rounded-xl border border-border bg-surface p-6 text-center">
        <p class="text-sm text-muted">
          This user has not linked their Steam account.
        </p>
      </div>
    ) : topGames.length === 0 ? (
      <div class="mt-4 rounded-xl border border-border bg-surface p-6 text-center">
        <p class="text-sm text-muted">No top games yet.</p>
      </div>
    ) : (
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {topGames.map((game) => (
          <a href={`/games/${game.slug}`} class="group block">
            <div class="relative aspect-[2/3] overflow-hidden rounded-lg border border-border bg-surface-2">
              {game.capsule_url ? (
                <img
                  src={game.capsule_url}
                  alt=""
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center p-2 text-center text-xs text-muted">
                  {game.game_name}
                </div>
              )}
            </div>
            <span class="mt-1.5 block truncate text-xs font-medium text-text transition-colors group-hover:text-blue">
              {game.game_name}
            </span>
          </a>
        ))}
      </div>
    )
  }
</section>

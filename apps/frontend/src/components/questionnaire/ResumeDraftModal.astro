---
/**
 * Resume-draft prompt — SBGC-180.
 *
 * Native `<dialog>` shown on mount when a valid local draft exists for this
 * game.  The questionnaire root owns the show/close + button handling so the
 * draft stays a single source of truth.
 */
interface Props {
  gameName?: string;
}

const { gameName = "this game" } = Astro.props;
---

<dialog
  id="resume-draft-modal"
  class="m-auto w-full max-w-md rounded-xl border border-(--color-border) bg-(--color-surface-2) p-6 text-(--color-text) shadow-2xl backdrop:bg-black/70"
  aria-modal="true"
  aria-labelledby="resume-dialog-title"
>
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-3">
      <div
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-(--color-surface-3) text-(--color-blue)"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h3
        id="resume-dialog-title"
        class="text-lg font-bold text-(--color-text)"
      >
        Resume incomplete assessment
      </h3>
    </div>

    <p class="text-sm leading-relaxed text-(--color-muted)">
      An unsubmitted assessment for <span
        class="font-semibold text-(--color-text)">{gameName}</span
      > was found on this device. Continue where you left off?
    </p>

    <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:justify-end">
      <button
        type="button"
        data-resume-discard
        class="inline-flex items-center justify-center rounded-lg border border-(--color-border) bg-surface-2 px-4 py-2 text-xs font-semibold text-(--color-text) transition hover:opacity-90"
      >
        Start over
      </button>
      <button
        type="button"
        data-resume-confirm
        class="inline-flex items-center justify-center rounded-lg bg-(--color-blue) px-4 py-2 text-xs font-semibold text-bg transition hover:opacity-90"
      >
        Resume progress
      </button>
    </div>
  </div>
</dialog>

---
/**
 * Offline / reconnecting indicator — SBGC-180.
 *
 * Non-intrusive banner shown while the browser reports no connectivity.  It is
 * purely advisory: answers keep accumulating in local state and the draft
 * cache, and submission is gated separately.
 */
---

<aside
  id="network-notice"
  class="fixed right-4 bottom-4 z-50 hidden max-w-sm rounded-lg border border-(--color-border) bg-(--color-surface-2) p-4 shadow-xl"
  role="status"
  aria-live="polite"
>
  <div class="flex items-center gap-3">
    <span
      class="h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-orange) motion-safe:animate-pulse"
      aria-hidden="true"></span>
    <div>
      <p class="text-xs font-semibold text-(--color-text)">Connection lost</p>
      <p class="mt-0.5 text-xs text-(--color-muted)">
        Your progress is saved locally. Reconnecting…
      </p>
    </div>
  </div>
</aside>

<script>
  function updateNetworkNotice(): void {
    const banner = document.getElementById("network-notice");
    if (!banner) return;
    banner.classList.toggle("hidden", navigator.onLine);
  }

  window.addEventListener("online", updateNetworkNotice);
  window.addEventListener("offline", updateNetworkNotice);
  updateNetworkNotice();
</script>

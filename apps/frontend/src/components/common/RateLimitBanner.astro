---
interface Props {
  id?: string;
}
const { id = "rate-limit-banner" } = Astro.props;
---

<div
  id={id}
  class="mb-4 hidden rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-sm text-amber-200"
  role="alert"
>
  <div class="flex items-center gap-2">
    <span class="font-bold">⚠️ Rate limit active:</span>
    <span id={`${id}-message`}>Please pause requests.</span>
    <span class="font-mono font-semibold" id={`${id}-countdown`}></span>
  </div>
</div>

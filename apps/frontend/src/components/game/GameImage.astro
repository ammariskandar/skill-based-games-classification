---
interface Props {
  src: string;
  name: string;
  slug: string;
  source: "steam" | "manual";
  libraryHeroUrl?: string | null;
  libraryCapsuleUrl?: string | null;
}

const { src, name, slug, source, libraryHeroUrl, libraryCapsuleUrl } =
  Astro.props;

const isSteam = source === "steam";
const hero = (libraryHeroUrl ?? "").trim();
const capsule = (libraryCapsuleUrl ?? "").trim();
const header = src.trim();

// Layered Steam presentation fallback ladder (SBGC-184 correction):
//   A) Hero + Capsule  → softened Hero background + sharp Capsule foreground
//   B) Hero only       → softened Hero background + contained header fallback
//   C) Capsule only    → softened header background + sharp Capsule foreground
//   D) neither         → existing header-only full-frame behaviour
//   E) no image        → placeholder (no enhancement)
let backgroundSrc = "";
let foregroundSrc = "";
let foregroundRole: "library-capsule" | "header" | "manual-primary" = "header";
let foregroundContained = false;

if (isSteam) {
  if (hero !== "") {
    backgroundSrc = hero;
    if (capsule !== "") {
      foregroundSrc = capsule;
      foregroundRole = "library-capsule";
      foregroundContained = true;
    } else if (header !== "") {
      foregroundSrc = header;
      foregroundRole = "header";
      foregroundContained = true;
    }
  } else if (capsule !== "") {
    backgroundSrc = header;
    foregroundSrc = capsule;
    foregroundRole = "library-capsule";
    foregroundContained = true;
  } else if (header !== "") {
    foregroundSrc = header;
    foregroundRole = "header";
    foregroundContained = false;
  }
} else {
  foregroundSrc = header;
  foregroundRole = "manual-primary";
  foregroundContained = false;
}

const hasBackground = backgroundSrc !== "";
const hasForeground = foregroundSrc !== "";
const hasImage = hasBackground || hasForeground;

const foregroundClass = foregroundContained
  ? foregroundRole === "library-capsule"
    ? "game-image__enhance--capsule"
    : "game-image__enhance--card"
  : "game-image__enhance--fullframe";

// Steam's image CDN consistently sends `Access-Control-Allow-Origin: *`, so
// `crossorigin="anonymous"` enables pixel-read upscaling without breaking the
// image. The Hero background is decorative (never enhanced) and carries no
// `crossorigin`. Manual images may point at arbitrary origins, so no
// `crossorigin` there: they still render, and enhancement is skipped if
// pixel-read is blocked.
const foregroundCrossorigin = isSteam ? "anonymous" : undefined;
---

{
  hasImage ? (
    <div class="game-image" data-game-image>
      <div class="game-image__frame">
        {hasBackground && (
          <img
            class="game-image__background"
            src={backgroundSrc}
            alt=""
            aria-hidden="true"
            loading="eager"
          />
        )}
        {hasForeground && (
          <div
            class={`game-image__enhance ${foregroundClass}`}
            data-game-image-enhance
            data-asset-role={foregroundRole}
            data-game-slug={slug}
            data-source-url={foregroundSrc}
          >
            <img
              src={foregroundSrc}
              alt={`${name} cover image`}
              class="game-image__original"
              data-game-image-original
              loading="eager"
              crossorigin={foregroundCrossorigin}
            />
            <img
              class="game-image__enhanced"
              data-game-image-enhanced
              alt=""
              aria-hidden="true"
              hidden
            />
          </div>
        )}
      </div>
    </div>
  ) : (
    <div
      class="flex aspect-video w-full flex-col items-center justify-center gap-2 rounded-lg border border-border bg-surface"
      role="img"
      aria-label={`${name} cover image unavailable`}
    >
      <svg
        aria-hidden="true"
        class="h-8 w-8 text-dim"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="8.5" cy="10" r="1.5" />
        <path d="M21 15l-5-5L5 20" />
      </svg>
      <span aria-hidden="true" class="text-sm text-muted">
        Image unavailable
      </span>
    </div>
  )
}

<script>
  import { mountGameImageEnhancer } from "../../lib/game-image-upscale-client";
  import type { AssetRole } from "../../lib/game-image-upscale";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-game-image-enhance]",
  )) {
    const gameSlug = root.dataset.gameSlug;
    const assetRole = root.dataset.assetRole;
    const sourceUrl = root.dataset.sourceUrl;
    if (gameSlug && assetRole && sourceUrl) {
      mountGameImageEnhancer({
        root,
        gameSlug,
        assetRole: assetRole as AssetRole,
        sourceUrl,
      });
    }
  }
</script>

<style>
  .game-image__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .game-image__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Restrained softening: readable atmosphere, not an obviously blurred
       wallpaper. The slight overscale hides the soft blur at the edges. */
    filter: blur(6px) brightness(0.6);
    transform: scale(1.05);
  }

  .game-image__enhance {
    position: relative;
  }

  .game-image__enhance--fullframe {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .game-image__enhance--capsule {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 72%;
    aspect-ratio: 2 / 3;
    max-width: 90%;
  }

  .game-image__enhance--card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 62%;
    aspect-ratio: 460 / 215;
    max-height: 70%;
  }

  .game-image__original {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-image__enhanced {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-image__enhance--capsule .game-image__original,
  .game-image__enhance--capsule .game-image__enhanced,
  .game-image__enhance--card .game-image__original,
  .game-image__enhance--card .game-image__enhanced {
    object-fit: contain;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
  }

  /* Wipe reveal (top-to-bottom) — header/manual full-frame. */
  .game-image__enhanced[data-transition="wipe"] {
    clip-path: inset(0 0 100% 0);
  }

  .game-image__enhanced[data-transition="wipe"][data-reveal="animated"] {
    animation: game-image-reveal 500ms ease forwards;
  }

  .game-image__enhanced[data-transition="wipe"][data-reveal="instant"] {
    clip-path: inset(0 0 0 0);
  }

  /* Crossfade reveal — Library Capsule. */
  .game-image__enhanced[data-transition="crossfade"] {
    opacity: 0;
  }

  .game-image__enhanced[data-transition="crossfade"][data-reveal="animated"] {
    animation: game-image-crossfade 200ms ease forwards;
  }

  .game-image__enhanced[data-transition="crossfade"][data-reveal="instant"] {
    opacity: 1;
  }

  @keyframes game-image-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes game-image-crossfade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-image__enhanced[data-reveal="animated"] {
      animation: none;
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }
</style>

---
interface Props {
  src: string;
  name: string;
}

const { src, name } = Astro.props;
const resolvedSrc = src.trim();
const hasImage = resolvedSrc !== "";
---

{
  hasImage ? (
    <div class="overflow-hidden rounded-lg border border-border bg-surface">
      <img
        src={resolvedSrc}
        alt={`${name} cover image`}
        class="aspect-video h-auto w-full object-cover"
        loading="lazy"
      />
    </div>
  ) : (
    <div
      class="flex aspect-video w-full flex-col items-center justify-center gap-2 rounded-lg border border-border bg-surface"
      role="img"
      aria-label={`${name} cover image unavailable`}
    >
      <svg
        aria-hidden="true"
        class="h-8 w-8 text-dim"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="8.5" cy="10" r="1.5" />
        <path d="M21 15l-5-5L5 20" />
      </svg>
      <span aria-hidden="true" class="text-sm text-muted">
        Image unavailable
      </span>
    </div>
  )
}

---
interface Props {
  src: string;
  name: string;
  slug: string;
  source: "steam" | "manual";
}

const { src, name, slug, source } = Astro.props;
const resolvedSrc = src.trim();
const hasImage = resolvedSrc !== "";
// Steam's image CDN consistently sends `Access-Control-Allow-Origin: *`, so
// `crossorigin="anonymous"` enables pixel-read upscaling without breaking the
// image. Manual images may point at arbitrary origins, so no crossorigin there:
// they still render, and enhancement is skipped if pixel-read is blocked.
const crossorigin = source === "steam" ? "anonymous" : undefined;
---

{
  hasImage ? (
    <div
      class="game-image"
      data-game-image
      data-game-slug={slug}
      data-source-url={resolvedSrc}
    >
      <div class="game-image__frame">
        <img
          src={resolvedSrc}
          alt={`${name} cover image`}
          class="game-image__original"
          data-game-image-original
          loading="lazy"
          crossorigin={crossorigin}
        />
        <img
          class="game-image__enhanced"
          data-game-image-enhanced
          alt=""
          aria-hidden="true"
          hidden
        />
      </div>
    </div>
  ) : (
    <div
      class="flex aspect-video w-full flex-col items-center justify-center gap-2 rounded-lg border border-border bg-surface"
      role="img"
      aria-label={`${name} cover image unavailable`}
    >
      <svg
        aria-hidden="true"
        class="h-8 w-8 text-dim"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="8.5" cy="10" r="1.5" />
        <path d="M21 15l-5-5L5 20" />
      </svg>
      <span aria-hidden="true" class="text-sm text-muted">
        Image unavailable
      </span>
    </div>
  )
}

<script>
  import { mountGameImageEnhancer } from "../../lib/game-image-upscale-client";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-game-image]",
  )) {
    const gameSlug = root.dataset.gameSlug;
    const sourceUrl = root.dataset.sourceUrl;
    if (gameSlug && sourceUrl) {
      mountGameImageEnhancer({ root, gameSlug, sourceUrl });
    }
  }
</script>

<style>
  .game-image__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .game-image__original {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .game-image__enhanced {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 0 100% 0);
  }

  .game-image__enhanced[data-reveal="animated"] {
    animation: game-image-reveal 500ms ease forwards;
  }

  .game-image__enhanced[data-reveal="instant"] {
    clip-path: inset(0 0 0 0);
  }

  @keyframes game-image-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-image__enhanced[data-reveal="animated"] {
      animation: none;
      clip-path: inset(0 0 0 0);
    }
  }
</style>

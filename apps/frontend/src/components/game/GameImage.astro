---
import { resolveGameImageLayout } from "../../lib/game-image-layout";

interface Props {
  src: string;
  name: string;
  slug: string;
  source: "steam" | "manual";
  libraryHeroUrl?: string | null;
  libraryCapsuleUrl?: string | null;
}

const { src, name, slug, source, libraryHeroUrl, libraryCapsuleUrl } =
  Astro.props;

const layout = resolveGameImageLayout({
  src,
  source,
  libraryHeroUrl,
  libraryCapsuleUrl,
});

const {
  backgroundSrc,
  foregroundSrc,
  foregroundRole,
  foregroundContained,
  showVisualizationSlot,
} = layout;

const hasBackground = backgroundSrc !== "";
const hasForeground = foregroundSrc !== "";
const hasImage = layout.kind === "image";

const foregroundClass = foregroundContained
  ? foregroundRole === "library-capsule"
    ? "game-image__enhance--capsule"
    : "game-image__enhance--card"
  : "game-image__enhance--fullframe";

// Steam's image CDN consistently sends `Access-Control-Allow-Origin: *`, so
// `crossorigin="anonymous"` enables pixel-read upscaling without breaking the
// image. The Hero background is decorative (never enhanced) and carries no
// `crossorigin`. Manual images may point at arbitrary origins, so no
// `crossorigin` there: they still render, and enhancement is skipped if
// pixel-read is blocked.
const foregroundCrossorigin = source === "steam" ? "anonymous" : undefined;
const isDev = import.meta.env.DEV;
---

{
  hasImage ? (
    <div class="game-image" data-game-image>
      <div class="game-image__frame">
        {hasBackground && (
          <img
            class="game-image__background"
            src={backgroundSrc}
            alt=""
            aria-hidden="true"
            loading="eager"
          />
        )}
        {hasForeground && (
          <div
            class={`game-image__foreground${showVisualizationSlot ? " game-image__foreground--group" : ""}`}
          >
            <div
              class={`game-image__enhance ${foregroundClass}`}
              data-game-image-enhance
              data-asset-role={foregroundRole}
              data-game-slug={slug}
              data-source-url={foregroundSrc}
            >
              <img
                src={foregroundSrc}
                alt={`${name} cover image`}
                class="game-image__original"
                data-game-image-original
                loading="eager"
                crossorigin={foregroundCrossorigin}
              />
              <img
                class="game-image__enhanced"
                data-game-image-enhanced
                alt=""
                aria-hidden="true"
                hidden
              />
            </div>
            {showVisualizationSlot && (
              <div
                class="game-image__visualization"
                data-classification-visualization
                hidden={!isDev}
              >
                {isDev && (
                  <span class="game-image__visualization-label">
                    Visualization slot
                  </span>
                )}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  ) : (
    <div
      class="flex aspect-video w-full flex-col items-center justify-center gap-2 rounded-lg border border-border bg-surface"
      role="img"
      aria-label={`${name} cover image unavailable`}
    >
      <svg
        aria-hidden="true"
        class="h-8 w-8 text-dim"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="8.5" cy="10" r="1.5" />
        <path d="M21 15l-5-5L5 20" />
      </svg>
      <span aria-hidden="true" class="text-sm text-muted">
        Image unavailable
      </span>
    </div>
  )
}

<script>
  import { mountGameImageEnhancer } from "../../lib/game-image-upscale-client";
  import type { AssetRole } from "../../lib/game-image-upscale";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-game-image-enhance]",
  )) {
    const gameSlug = root.dataset.gameSlug;
    const assetRole = root.dataset.assetRole;
    const sourceUrl = root.dataset.sourceUrl;
    if (gameSlug && assetRole && sourceUrl) {
      mountGameImageEnhancer({
        root,
        gameSlug,
        assetRole: assetRole as AssetRole,
        sourceUrl,
      });
    }
  }
</script>

<style>
  .game-image__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .game-image__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Restrained softening: readable atmosphere, not an obviously blurred
       wallpaper. The slight overscale hides the soft blur at the edges. */
    filter: blur(6px) brightness(0.6);
    transform: scale(1.05);
  }

  .game-image__enhance {
    position: relative;
  }

  .game-image__enhance--fullframe {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .game-image__enhance--capsule {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 72%;
    aspect-ratio: 2 / 3;
    max-width: 90%;
  }

  .game-image__enhance--card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 62%;
    aspect-ratio: 460 / 215;
    max-height: 70%;
  }

  /* Case A only: a centered group holding the Capsule and the reserved square
     classification-visualization slot. Every other case passes through
     unchanged via `display: contents` (the wrapper generates no box). */
  .game-image__foreground {
    display: contents;
  }

  .game-image__foreground--group {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    height: 72%;
    max-width: 90%;
  }

  .game-image__foreground--group .game-image__enhance--capsule {
    position: relative;
    top: auto;
    left: auto;
    height: 100%;
    aspect-ratio: 2 / 3;
    max-width: none;
    transform: none;
    flex: none;
  }

  .game-image__visualization {
    position: relative;
    height: 100%;
    aspect-ratio: 1 / 1;
    flex: none;
  }

  /* The slot carries `hidden` (rendered only when a visualization exists;
     currently dev-only). SBGC-12 renders real content and drops the `hidden`
     attribute, at which point it participates in the two-slot layout. */
  .game-image__visualization-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    text-align: center;
    border: 1px dashed var(--color-border-2);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  /* Narrow/mobile: stack the reserved layout rather than squeezing the
     portrait Capsule and square slot side by side. Only when the slot is
     actually present (not `hidden`) do we split the shared height. */
  @media (max-width: 640px) {
    .game-image__foreground--group {
      flex-direction: column;
      gap: 0.5rem;
    }

    .game-image__foreground--group:has(.game-image__visualization:not([hidden]))
      .game-image__enhance--capsule,
    .game-image__foreground--group:has(.game-image__visualization:not([hidden]))
      .game-image__visualization {
      height: 50%;
    }
  }

  .game-image__original {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-image__enhanced {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-image__enhance--capsule .game-image__original,
  .game-image__enhance--capsule .game-image__enhanced,
  .game-image__enhance--card .game-image__original,
  .game-image__enhance--card .game-image__enhanced {
    object-fit: contain;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
  }

  /* Wipe reveal (top-to-bottom) — header/manual full-frame. */
  .game-image__enhanced[data-transition="wipe"] {
    clip-path: inset(0 0 100% 0);
  }

  .game-image__enhanced[data-transition="wipe"][data-reveal="animated"] {
    animation: game-image-reveal 500ms ease forwards;
  }

  .game-image__enhanced[data-transition="wipe"][data-reveal="instant"] {
    clip-path: inset(0 0 0 0);
  }

  /* Crossfade reveal — Library Capsule. */
  .game-image__enhanced[data-transition="crossfade"] {
    opacity: 0;
  }

  .game-image__enhanced[data-transition="crossfade"][data-reveal="animated"] {
    animation: game-image-crossfade 200ms ease forwards;
  }

  .game-image__enhanced[data-transition="crossfade"][data-reveal="instant"] {
    opacity: 1;
  }

  @keyframes game-image-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes game-image-crossfade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-image__enhanced[data-reveal="animated"] {
      animation: none;
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }
</style>

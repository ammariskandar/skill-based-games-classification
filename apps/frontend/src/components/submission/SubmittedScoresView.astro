---
// Presentational shell for the "already submitted" state (SBGC-215).
// The parent modal populates the `data-submitted` cells from the local cache;
// this component owns no client script and no persistence.
---

<div class="submitted-scores">
  <p class="submitted-scores__lead">
    You have already submitted a classification score for this game:
  </p>

  <div class="submitted-scores__aesthetics">
    <p class="submitted-scores__aesthetic">
      Primary Aesthetic:
      <span class="submitted-scores__tag" data-submitted="aesthetic">–</span>
    </p>
    <p class="submitted-scores__aesthetic">
      Secondary Aesthetic:
      <span class="submitted-scores__tag" data-submitted="secondary-aesthetic">
        –
      </span>
    </p>
  </div>

  <div class="submitted-scores__grid">
    <div class="submitted-scores__profile">
      <h3 class="submitted-scores__title">Challenge</h3>
      <dl class="submitted-scores__list">
        <div class="submitted-scores__row">
          <dt>Micro</dt>
          <dd data-submitted="challenge.micro">–</dd>
        </div>
        <div class="submitted-scores__row">
          <dt>Mystiko</dt>
          <dd data-submitted="challenge.mystiko">–</dd>
        </div>
        <div class="submitted-scores__row">
          <dt>Macro</dt>
          <dd data-submitted="challenge.macro">–</dd>
        </div>
      </dl>
    </div>

    <div class="submitted-scores__profile">
      <h3 class="submitted-scores__title">Reward</h3>
      <dl class="submitted-scores__list">
        <div class="submitted-scores__row">
          <dt>Micro</dt>
          <dd data-submitted="reward.micro">–</dd>
        </div>
        <div class="submitted-scores__row">
          <dt>Mystiko</dt>
          <dd data-submitted="reward.mystiko">–</dd>
        </div>
        <div class="submitted-scores__row">
          <dt>Macro</dt>
          <dd data-submitted="reward.macro">–</dd>
        </div>
      </dl>
    </div>
  </div>

  <p class="submitted-scores__timestamp">
    Submitted at <span data-submitted-timestamp>—</span>
  </p>
</div>

<style>
  .submitted-scores__lead {
    color: var(--color-text);
  }

  .submitted-scores__aesthetics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
  }

  .submitted-scores__aesthetic {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .submitted-scores__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--color-purple) 35%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-purple) 12%, transparent);
    color: var(--color-purple);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .submitted-scores__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 32rem) {
    .submitted-scores__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .submitted-scores__profile {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .submitted-scores__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .submitted-scores__list {
    display: grid;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
  }

  .submitted-scores__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
  }

  .submitted-scores__row dt {
    color: var(--color-muted);
  }

  .submitted-scores__row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .submitted-scores__timestamp {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
</style>

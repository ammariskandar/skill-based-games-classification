---
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "danger";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
}

const variant = Astro.props.variant ?? "primary";
const type = Astro.props.type ?? "button";
const loading = Astro.props.loading ?? false;
const fullWidth = Astro.props.fullWidth ?? false;

const base =
  "inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue disabled:pointer-events-none disabled:opacity-50 motion-reduce:transition-none";

const variants: Record<string, string> = {
  primary: "bg-blue text-bg hover:bg-blue/90",
  secondary: "bg-surface-2 text-text border border-border hover:bg-surface-3",
  ghost: "text-muted hover:bg-surface-2 hover:text-text",
  danger: "bg-red text-bg hover:bg-red/90",
};
---

<button
  type={type}
  disabled={loading || Astro.props.disabled}
  aria-busy={loading ? "true" : undefined}
  class:list={[base, variants[variant], fullWidth ? "w-full" : ""]}
>
  {
    loading && (
      <span aria-hidden="true" class="motion-reduce:hidden">
        …
      </span>
    )
  }
  <span>{loading ? "Loading…" : null}<slot /></span>
</button>

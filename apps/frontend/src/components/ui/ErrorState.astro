---
interface Props {
  title?: string;
  message: string;
}
---

<div
  class="flex flex-col items-center py-16 text-center"
  role={Astro.props.title ? "alert" : undefined}
>
  <h2 class="text-lg font-semibold text-text">
    {Astro.props.title ?? "Something went wrong"}
  </h2>
  <p class="mt-2 max-w-md text-sm text-muted">{Astro.props.message}</p>
  {
    Astro.slots.has("default") && (
      <div class="mt-6">
        <slot />
      </div>
    )
  }
</div>

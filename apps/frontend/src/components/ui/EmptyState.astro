---
interface Props {
  title: string;
  description?: string;
}
---

<div class="flex flex-col items-center justify-center py-16 text-center">
  <slot name="icon" />
  <h2 class="mt-4 text-lg font-semibold text-text">{Astro.props.title}</h2>
  {
    Astro.props.description && (
      <p class="mt-2 max-w-md text-sm text-muted">{Astro.props.description}</p>
    )
  }
  <div class="mt-6">
    <slot />
  </div>
</div>

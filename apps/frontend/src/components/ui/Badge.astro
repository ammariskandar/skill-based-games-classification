---
interface Props {
  variant?: "neutral" | "positive" | "warning" | "negative" | "info";
  label?: string;
}

const variant = Astro.props.variant ?? "neutral";

const variants: Record<string, string> = {
  neutral: "bg-surface-2 text-muted border-border",
  positive: "bg-green/15 text-green border-green/30",
  warning: "bg-yellow/15 text-yellow border-yellow/30",
  negative: "bg-red/15 text-red border-red/30",
  info: "bg-blue/15 text-blue border-blue/30",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium",
    variants[variant],
  ]}
>
  <slot>{Astro.props.label}</slot>
</span>

---
interface Props {
  id: string;
  name: string;
  rows?: number;
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
  describedBy?: string;
}

const describedBy = Astro.props.describedBy ?? "";
---

<textarea
  id={Astro.props.id}
  name={Astro.props.name}
  rows={Astro.props.rows ?? 4}
  placeholder={Astro.props.placeholder}
  required={Astro.props.required}
  disabled={Astro.props.disabled}
  readonly={Astro.props.readonly}
  aria-invalid={Astro.props.invalid ? "true" : undefined}
  aria-describedby={describedBy || undefined}
  class:list={[
    "block w-full rounded-md bg-surface px-3 py-2 text-sm text-text placeholder:text-dim",
    "border focus:outline-none focus:ring-2 focus:ring-blue",
    Astro.props.invalid ? "border-red" : "border-border focus:border-blue",
    Astro.props.disabled ? "opacity-50 cursor-not-allowed" : "",
  ]}><slot /></textarea
>

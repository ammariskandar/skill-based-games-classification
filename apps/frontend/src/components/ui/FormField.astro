---
interface Props {
  label: string;
  for?: string;
  required?: boolean;
  helpText?: string;
  error?: string;
}
---

<div>
  <label for={Astro.props.for} class="block text-sm font-medium text-text">
    {Astro.props.label}
    {
      Astro.props.required && (
        <span aria-hidden="true" class="text-red">
          {" "}
          *
        </span>
      )
    }
  </label>
  {
    Astro.props.helpText && (
      <p id={"help-" + (Astro.props.for ?? "")} class="mt-1 text-xs text-muted">
        {Astro.props.helpText}
      </p>
    )
  }
  <div class="mt-1.5">
    <slot />
  </div>
  {
    Astro.props.error && (
      <p
        id={"error-" + (Astro.props.for ?? "")}
        class="mt-1 text-xs text-red"
        role="alert"
      >
        {Astro.props.error}
      </p>
    )
  }
</div>

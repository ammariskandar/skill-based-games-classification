---
/**
 * Password strength meter — SBGC-218.
 *
 * Pure-visual component: renders a 4-segment progress bar + label beneath a
 * password input and re-evaluates on every keystroke.  The shared scoring
 * logic lives in `../lib/password-strength` (also used by the sign-up page to
 * gate its submit button).
 */
interface Props {
  /** id attribute of the password `<input>` to monitor. */
  inputId: string;
}

const { inputId } = Astro.props;
---

<div class="mt-2" data-password-meter data-input-id={inputId}>
  <div class="flex gap-1" role="meter" aria-hidden="true">
    <span class="h-1 flex-1 rounded-full bg-surface-3" data-password-bar></span>
    <span class="h-1 flex-1 rounded-full bg-surface-3" data-password-bar></span>
    <span class="h-1 flex-1 rounded-full bg-surface-3" data-password-bar></span>
    <span class="h-1 flex-1 rounded-full bg-surface-3" data-password-bar></span>
  </div>
  <p class="mt-1 text-xs text-muted" data-password-label>Password strength</p>
</div>

<script>
  import { evaluatePasswordStrength } from "../../lib/password-strength";

  const TIER_COLORS: Record<string, string> = {
    Weak: "bg-red",
    Fair: "bg-orange",
    Good: "bg-yellow",
    Strong: "bg-green",
  };
  const INACTIVE = "bg-surface-3";

  function initMeter(root: HTMLElement): void {
    const inputId = root.dataset.inputId;
    const input = inputId
      ? (document.getElementById(inputId) as HTMLInputElement | null)
      : null;
    const bars = root.querySelectorAll<HTMLElement>("[data-password-bar]");
    const label = root.querySelector<HTMLElement>("[data-password-label]");
    if (!input) return;

    const render = (): void => {
      const { tier } = evaluatePasswordStrength(input.value);
      const activeBars =
        tier === "Weak" ? 1 : tier === "Fair" ? 2 : tier === "Good" ? 3 : 4;
      bars.forEach((bar, index) => {
        const color = index < activeBars ? TIER_COLORS[tier] : INACTIVE;
        bar.className = `h-1 flex-1 rounded-full ${color}`;
      });
      if (label) label.textContent = `Password strength: ${tier}`;
    };

    input.addEventListener("input", render);
    render();
  }

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-password-meter]",
  )) {
    initMeter(root);
  }
</script>

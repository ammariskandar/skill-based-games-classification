---
import { NAV_DESTINATIONS } from "../lib/nav-destinations";

const { pathname } = Astro.url;

interface Props {
  pathname?: string;
  class?: string;
}

const current = Astro.props.pathname ?? pathname;
---

<nav aria-label="Main navigation">
  <ul
    class:list={[
      "flex flex-wrap items-center gap-1 text-sm font-medium sm:gap-2",
      Astro.props.class ?? "",
    ]}
  >
    {
      NAV_DESTINATIONS.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "inline-block rounded px-3 py-1.5 transition-colors",
              "hover:bg-surface-2 hover:text-text",
              "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue",
              current === link.href || current.startsWith(link.href + "/")
                ? "bg-surface-2 text-text"
                : "text-muted",
            ]}
            aria-current={
              current === link.href ||
              (link.href !== "/" && current.startsWith(link.href + "/"))
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

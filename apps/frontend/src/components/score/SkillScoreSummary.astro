---
import { DIMENSION_LIST } from "../../lib/skill-dimensions";

interface Props {
  type: "challenge" | "reward";
  micro: number;
  mystiko: number;
  macro: number;
}

const total = Astro.props.micro + Astro.props.mystiko + Astro.props.macro;
const dims = DIMENSION_LIST;
---

<div class="text-sm" aria-label={`${Astro.props.type} profile summary`}>
  <p class="font-semibold text-text capitalize">
    {Astro.props.type}
  </p>
  <dl class="mt-1 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5">
    {
      dims.map((d) => {
        const val =
          d.id === "micro"
            ? Astro.props.micro
            : d.id === "mystiko"
              ? Astro.props.mystiko
              : Astro.props.macro;
        return (
          <>
            <dt class="inline-flex items-center gap-1 text-muted">
              <span aria-hidden="true" class={`text-xs text-${d.token}`}>
                {d.symbol}
              </span>
              {d.label}
            </dt>
            <dd class="text-text tabular-nums">{val}%</dd>
          </>
        );
      })
    }
  </dl>
  <p class="mt-1 text-xs text-muted">
    Total: <span class="tabular-nums">{total}</span> / 100
  </p>
</div>

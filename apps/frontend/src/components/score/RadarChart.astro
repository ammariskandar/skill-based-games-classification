---
import { buildRadarHtml } from "../../lib/radar-render";
import type {
  SkillProfileKind,
  SkillProfileVector,
} from "../../lib/skill-dimensions";

interface Props {
  challenge: SkillProfileVector | null;
  reward: SkillProfileVector | null;
  initialProfile?: SkillProfileKind;
  size?: number;
  gameTitle?: string;
  class?: string;
  showToggle?: boolean;
}

const html = buildRadarHtml({
  challenge: Astro.props.challenge,
  reward: Astro.props.reward,
  initialProfile: Astro.props.initialProfile,
  size: Astro.props.size,
  gameTitle: Astro.props.gameTitle,
  class: Astro.props.class,
  showToggle: Astro.props.showToggle,
});
---

<Fragment set:html={html} />

<script>
  import { initRadarChart } from "../../lib/radar-controller";

  const cleanups: Array<() => void> = [];

  function mountAll() {
    document
      .querySelectorAll<HTMLElement>("[data-radar-chart]")
      .forEach((el) => {
        if (el.hasAttribute("data-radar-initialized")) return;
        el.setAttribute("data-radar-initialized", "");
        cleanups.push(initRadarChart(el).destroy);
      });
  }

  function unmountAll() {
    for (const cleanup of cleanups) cleanup();
    cleanups.length = 0;
  }

  document.addEventListener("astro:page-load", mountAll);
  window.addEventListener("pagehide", unmountAll);
  mountAll();
</script>

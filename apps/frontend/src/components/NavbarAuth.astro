---
/**
 * Navbar authentication island — SBGC-217.
 *
 * Client-hydrated: the SSR markup always renders the logged-out state so
 * pre-rendered pages (`/about`, `/methodology`) stay 100% static with no
 * layout shift.  On load the island fetches `/api/auth/status` and swaps in
 * the username + logout control when a session exists.
 *
 * Rendered once per Header breakpoint (desktop + compact).  The `compact`
 * prop only changes the root data-attribute so the script can address each
 * instance independently — there are no shared element IDs.
 */
interface Props {
  compact?: boolean;
  class?: string;
}

const { compact = false } = Astro.props;
const idPrefix = compact ? "compact" : "desktop";
---

<div
  class:list={["flex items-center gap-3", Astro.props.class ?? ""]}
  data-navbar-auth={idPrefix}
>
  <!-- Logged out (SSR default) -->
  <div data-auth-logged-out class="flex items-center">
    <a
      href="/login"
      class="inline-block whitespace-nowrap rounded px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
    >
      Login / Sign Up
    </a>
  </div>

  <!-- Logged in (hidden until /api/auth/status confirms a session) -->
  <div data-auth-logged-in class="hidden items-center gap-3">
    <a
      data-auth-username
      href="/profile"
      title="View Profile"
      class="inline-block max-w-[120px] truncate whitespace-nowrap rounded border border-border bg-surface px-2.5 py-1 text-sm font-medium text-text transition-colors hover:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
    >
      User
    </a>
    <form action="/api/auth/logout" method="POST" class="inline">
      <button
        type="submit"
        class="inline-block whitespace-nowrap rounded px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
      >
        Logout
      </button>
    </form>
  </div>
</div>

<script>
  import {
    clearCachedAuthStatus,
    readCachedAuthStatus,
    writeCachedAuthStatus,
    type AuthStatus,
  } from "../lib/auth-status";

  function paintIsland(root: HTMLElement, status: AuthStatus): void {
    const loggedOut = root.querySelector<HTMLElement>("[data-auth-logged-out]");
    const loggedIn = root.querySelector<HTMLElement>("[data-auth-logged-in]");
    const username = root.querySelector<HTMLAnchorElement>(
      "[data-auth-username]",
    );

    const isAuthenticated = Boolean(status.authenticated && status.username);
    loggedOut?.classList.toggle("hidden", isAuthenticated);
    if (loggedIn) {
      loggedIn.classList.toggle("hidden", !isAuthenticated);
      loggedIn.classList.toggle("flex", isAuthenticated);
    }
    if (isAuthenticated && username && status.username) {
      username.textContent = status.username;
      username.setAttribute("title", `Profile: ${status.username}`);
    }
  }

  /** Re-validate against the BFF and update the cache in the background. */
  function refreshStatus(root: HTMLElement): void {
    fetch("/api/auth/status", { headers: { Accept: "application/json" } })
      .then((res) =>
        res.ok
          ? (res.json() as Promise<AuthStatus>)
          : { authenticated: false, username: null },
      )
      .then((status) => {
        paintIsland(root, status);
        writeCachedAuthStatus(status);
      })
      .catch(() => {
        // Best-effort refresh — keep whatever is already painted.
      });
  }

  function initAuthIsland(root: HTMLElement): void {
    // A logout just happened in this tab (BFF set the flash toast before the
    // 303 redirect): never flash the stale cached username.
    if (document.cookie.includes("flash_toast=logout_success")) {
      clearCachedAuthStatus();
      paintIsland(root, { authenticated: false, username: null });
      return;
    }

    // Paint known state instantly from the cache, then re-validate in the
    // background so the auth controls never wait on a network round-trip.
    const cached = readCachedAuthStatus();
    if (cached) {
      paintIsland(root, cached);
    }
    refreshStatus(root);
  }

  function initAll(): void {
    for (const root of document.querySelectorAll<HTMLElement>(
      "[data-navbar-auth]",
    )) {
      initAuthIsland(root);
    }
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>

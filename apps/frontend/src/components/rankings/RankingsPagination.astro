---
import { rankingsHref } from "../../lib/rankings-state";
import type { RankingsState } from "../../lib/rankings-state";

interface Props {
  state: RankingsState;
  totalPages: number;
}

const { state, totalPages } = Astro.props;

// SBGC-241: instant page revisits. The ranking markup stays server-owned
// (SBGC-200), so rather than caching slices in JavaScript the browser is asked
// to prerender the pagination targets once hover intent is shown; a revisit then
// activates an already rendered document with no intermediate loading state.
// Engines without speculation support fall back to the `rel="prefetch"` hints
// on the links below. Rendered from the frontmatter because a bare JSON literal
// in a script element is not valid JavaScript for the toolchain parsers.
const speculationRules = {
  prerender: [
    {
      where: { selector_matches: "a.rankings-pagination__link" },
      eagerness: "moderate",
    },
  ],
};

const hasPrev = state.page > 1;
const hasNext = state.page < totalPages;
const prevHref = rankingsHref({ ...state, page: state.page - 1 });
const nextHref = rankingsHref({ ...state, page: state.page + 1 });
---

<!-- Both links are always rendered (hidden when inapplicable) so the client
     controller can update href + visibility in place during transitions. -->
<nav
  class="rankings-pagination"
  aria-label="Ranking pages"
  data-rankings-pagination
>
  <a
    href={prevHref}
    class="rankings-pagination__link rankings-pagination__prev"
    data-rankings-prev
    rel="prefetch"
    hidden={!hasPrev}
  >
    Previous
  </a>
  <a
    href={nextHref}
    class="rankings-pagination__link rankings-pagination__next"
    data-rankings-next
    rel="prefetch"
    hidden={!hasNext}
  >
    Next Page
  </a>
</nav>

<script
  type="speculationrules"
  is:inline
  set:html={JSON.stringify(speculationRules)}
/>

<style>
  .rankings-pagination {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .rankings-pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-2);
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }

  .rankings-pagination__link[hidden] {
    display: none;
  }

  .rankings-pagination__link:hover {
    background: var(--color-surface-3);
  }

  .rankings-pagination__link:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  .rankings-pagination__prev,
  .rankings-pagination__next {
    flex: 1 1 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .rankings-pagination__link {
      transition: none;
    }
  }
</style>

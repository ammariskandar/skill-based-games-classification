---
import { formatRankingScore } from "../../lib/rankings-state";
import type { RankingItem } from "../../lib/server/api";

interface Props {
  game: RankingItem;
  selected: boolean;
  eager?: boolean;
}

const { game, selected, eager = false } = Astro.props;
const score = formatRankingScore(game.score);
const heroUrl = (game.hero_url ?? "").trim();
const hasHero = heroUrl !== "";
---

<button
  type="button"
  class:list={["ranking-row", selected && "is-selected"]}
  data-ranking-row
  data-slug={game.slug}
  aria-pressed={selected ? "true" : "false"}
  aria-label={`${game.name}, ranking score ${score}`}
>
  <span class="ranking-row__media">
    {
      hasHero && (
        <img
          src={heroUrl}
          alt=""
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
      )
    }
  </span>
  <span class="ranking-row__name">{game.name}</span>
  <span class="ranking-row__score" aria-hidden="true">{score}</span>
</button>

<!-- `is:global` is deliberate: the ranking list rows are replaced at runtime
     by the same-origin client transition, so their scoped selectors would not
     match newly-created DOM.  The class names are rankings-specific. -->
<style is:global>
  .ranking-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem;
    text-align: left;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .ranking-row:hover {
    border-color: var(--color-border-2);
    background: var(--color-surface-2);
  }

  .ranking-row:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  /* Selected is distinct from hover/focus and is never colour-only: a heavier
     border plus an accent bar. */
  .ranking-row.is-selected {
    border-color: var(--color-blue);
    box-shadow: inset 3px 0 0 var(--color-blue);
  }

  .ranking-row__media {
    flex: none;
    width: 14rem;
    aspect-ratio: 460 / 215;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }

  .ranking-row__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ranking-row__name {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ranking-row__score {
    flex: none;
    min-width: 2.25rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .ranking-row {
      transition: none;
    }
  }
</style>

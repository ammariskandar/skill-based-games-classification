---
import BaseLayout from "../layouts/BaseLayout.astro";
import ErrorState from "../components/ui/ErrorState.astro";

// The Astro server renders this page for unhandled render errors (500).
// Setting the status explicitly also makes a direct visit self-consistent.
Astro.response.status = 500;
---

<BaseLayout
  title="Something went wrong"
  description="An unexpected error occurred. Please try again."
  robots="noindex, nofollow"
>
  <ErrorState
    title="Something went wrong"
    message="An unexpected error occurred. Please try again in a moment."
    headingLevel="h1"
  >
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={Astro.url.pathname}
        class="text-sm font-medium text-blue hover:underline"
      >
        Try again →
      </a>
      <a href="/" class="text-sm font-medium text-blue hover:underline">
        Go Home →
      </a>
      <a
        href="/catalogue"
        class="text-sm font-medium text-blue hover:underline"
      >
        Browse Catalogue →
      </a>
    </div>
  </ErrorState>
</BaseLayout>

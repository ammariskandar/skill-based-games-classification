---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameCatalogueCard from "../components/catalogue/GameCatalogueCard.astro";
import CataloguePagination from "../components/catalogue/CataloguePagination.astro";
import CatalogueFilters from "../components/catalogue/CatalogueFilters.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import ErrorState from "../components/ui/ErrorState.astro";
import {
  catalogueHref,
  catalogueHrefFromState,
  catalogueNeedsNoindex,
  formatResultSummary,
  parseCatalogueQuery,
} from "../lib/catalogue-presentation";
import {
  getGameCatalogue,
  type GameCatalogueResponse,
} from "../lib/server/api";

// The catalogue depends on live persisted Game data: render on demand, never
// statically, so each request reads the current page from Django.
export const prerender = false;

const state = parseCatalogueQuery(Astro.url.searchParams);

type PageState =
  | { kind: "ready"; catalogue: GameCatalogueResponse }
  | { kind: "service-error" };

let pageState: PageState;
try {
  pageState = {
    kind: "ready",
    catalogue: await getGameCatalogue(
      {
        page: state.page,
        q: state.q || undefined,
        source: state.source ?? undefined,
        classified: state.classified ?? undefined,
        sort: state.sort,
        profile: state.profile,
        dominant: state.dominant ?? undefined,
        coverlessLast: state.coverlessLast,
      },
      { signal: Astro.request.signal },
    ),
  };
} catch {
  // Timeout, network, Django 5xx, or a malformed response all mean the service
  // is unavailable — never "no games found". 503 reflects the upstream outage.
  Astro.response.status = 503;
  pageState = { kind: "service-error" };
}

const catalogue = pageState.kind === "ready" ? pageState.catalogue : null;
const count = catalogue?.count ?? 0;
const totalPages = catalogue?.total_pages ?? 0;
const games = catalogue?.results ?? [];
const summary =
  catalogue !== null
    ? formatResultSummary(count, state.page, catalogue.page_size)
    : "";

const searching = state.q !== "";
// Result-reducing filters (source/classification/dominant) — used to pick the
// truthful filtered-empty state. Sort/profile/cover-last do not reduce count.
const hasResultFilters =
  state.source !== null || state.classified !== null || state.dominant !== null;
// Whether the filter panel should open on first paint (any non-default
// filter/sort/cover-last state).
const filtersActive =
  state.source !== null ||
  state.classified !== null ||
  state.sort !== "name_asc" ||
  state.profile !== "challenge" ||
  state.dominant !== null ||
  !state.coverlessLast;

const heading = searching ? `Search results for “${state.q}”` : "Catalogue";
// Search/filter/non-default sort states are ephemeral query pages — index the
// base catalogue only, not an infinite set of crawled facet URLs.
const robots = catalogueNeedsNoindex(state) ? "noindex, follow" : undefined;

// Canonical: the shared SEO helper accepts only a pathname (it strips query
// strings), so every catalogue page intentionally canonicalizes to the base
// /catalogue URL.  Documented in docs/frontend-architecture.md (SBGC-77).
---

<BaseLayout
  title={heading}
  description="Browse the MyGameDNA game catalogue and compare Challenge and Reward skill profiles across Micro, Macro, and Mystiko."
  canonicalPath="/catalogue"
  robots={robots}
  preloadGameSearchIndex
>
  <div class="mb-8 flex flex-col gap-2">
    <h1
      class="text-3xl font-bold tracking-tight text-(--color-text) sm:text-4xl"
    >
      {heading}
    </h1>
    {
      searching ? (
        <p class="max-w-4xl text-base text-muted sm:text-lg">
          Matching public Games by name for “{state.q}”.
        </p>
      ) : (
        <p class="max-w-4xl text-base text-muted sm:text-lg">
          Browse MyGameDNA's public Game catalogue and compare Challenge and
          Reward skill profiles.
        </p>
      )
    }
  </div>

  {
    pageState.kind === "ready" && (
      <CatalogueFilters state={state} open={filtersActive} />
    )
  }

  {
    pageState.kind === "service-error" ? (
      <ErrorState
        title="The catalogue is temporarily unavailable."
        message="Please try again in a moment."
        headingLevel="h2"
      />
    ) : searching && count === 0 ? (
      <EmptyState title={`No games found for “${state.q}”.`}>
        <a
          href={catalogueHref()}
          class="text-sm font-medium text-blue hover:underline"
        >
          View full catalogue
        </a>
      </EmptyState>
    ) : hasResultFilters && count === 0 ? (
      <EmptyState title="No games match the current filters.">
        <a
          href={catalogueHref({ q: state.q || undefined })}
          class="text-sm font-medium text-blue hover:underline"
        >
          Reset filters
        </a>
      </EmptyState>
    ) : count === 0 ? (
      <EmptyState title="No games are currently available in the catalogue." />
    ) : games.length === 0 ? (
      <EmptyState title="No games are available on this page.">
        <a
          href={catalogueHrefFromState(state, 1)}
          class="text-sm font-medium text-blue hover:underline"
        >
          Back to first page
        </a>
      </EmptyState>
    ) : (
      <>
        <p class="mt-6 text-sm text-muted">{summary}</p>

        <ul
          class="catalogue-grid mt-6 list-none"
          data-catalogue-grid
          data-cover-last={state.coverlessLast ? "true" : "false"}
        >
          {games.map((game, index) => (
            <li>
              <GameCatalogueCard game={game} eager={index < 4} index={index} />
            </li>
          ))}
        </ul>

        {totalPages > 1 && (
          <CataloguePagination
            page={state.page}
            totalPages={totalPages}
            state={state}
          />
        )}
      </>
    )
  }
</BaseLayout>

<script>
  import {
    createReorderScheduler,
    partitionCoverless,
    resolveCoverStateFromImage,
    type CoverState,
  } from "../lib/catalogue-cover";

  const grid = document.querySelector<HTMLElement>("[data-catalogue-grid]");
  if (grid) {
    // Runtime cover-last is an enhancement over the backend's global
    // no-Capsule partition: it moves confirmed broken-Capsule cards to the end
    // of the CURRENT page. It only runs when the cover-last checkbox is on.
    const coverLast = grid.dataset.coverLast === "true";

    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>("[data-catalogue-index]"),
    );

    // Partition confirmed coverless cards to the end of the CURRENT page only,
    // preserving original API order within each group. No cross-page sort.
    const reorder = () => {
      const ordered = partitionCoverless(
        cards.map((card) => ({
          value: card,
          index: Number(card.dataset.catalogueIndex ?? "0"),
          state: (card.dataset.coverState ?? "unknown") as CoverState,
        })),
      );
      for (const { value } of ordered) {
        const item = value.closest("li");
        if (item) grid.appendChild(item);
      }
    };

    const scheduler = createReorderScheduler(reorder, requestAnimationFrame);

    for (const card of cards) {
      const image = card.querySelector<HTMLImageElement>("img");
      if (!image) continue;

      const isCover = image.hasAttribute("data-catalogue-cover");

      const showPlaceholder = () => {
        const art = image.closest<HTMLElement>(".catalogue-card__art");
        if (art) art.dataset.failed = "true";
      };
      const markNoCover = () => {
        showPlaceholder();
        if (!isCover) return;
        card.dataset.coverState = "no-cover";
        if (coverLast) scheduler.schedule();
      };
      const markHasCover = () => {
        if (isCover) card.dataset.coverState = "has-cover";
      };

      const settled = resolveCoverStateFromImage(image);
      if (settled === "has-cover") {
        markHasCover();
      } else if (settled === "no-cover") {
        markNoCover();
      } else {
        image.addEventListener("load", markHasCover, { once: true });
        image.addEventListener("error", markNoCover, { once: true });
      }
    }
  }
</script>

<style>
  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Catalogue"
  description="Browse the MyGameDNA game catalogue, classified by separate Challenge and Reward profiles across Micro, Mystiko, and Macro dimensions."
  canonicalPath="/catalogue"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Catalogue</h1>
  <p class="mt-4 max-w-2xl text-lg text-muted">
    The game catalogue is under development. Games will be listed here,
    searchable and filterable by skill dimensions once the backend data layer is
    connected.
  </p>
</BaseLayout>

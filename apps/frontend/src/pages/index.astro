---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  description="MyGameDNA classifies games through the lens of skill, using Micro, Mystiko, and Macro dimensions within separate Challenge and Reward profiles."
  canonicalPath="/"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">MyGameDNA</h1>
  <p class="mt-4 max-w-2xl text-lg text-muted">
    Classifying games through the lens of skill, using Micro, Mystiko, and Macro
    dimensions within separate Challenge and Reward profiles.
  </p>
</BaseLayout>

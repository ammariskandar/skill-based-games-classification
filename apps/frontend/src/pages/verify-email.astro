---
import BaseLayout from "../layouts/BaseLayout.astro";

// SSR: confirm the emailed token server-to-server, then render the result.
export const prerender = false;

const BACKEND_URL = import.meta.env.DJANGO_API_URL || "http://127.0.0.1:8000";

const token = Astro.url.searchParams.get("token") ?? "";
let verified = false;
if (token) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/v1/auth/confirm-email`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token }),
    });
    verified = res.ok;
  } catch {
    verified = false;
  }
}
---

<BaseLayout title="Verify Email - MyGameDNA">
  <main
    class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-4 py-16 text-center"
  >
    {
      verified ? (
        <>
          <h1
            id="verify-success-heading"
            class="text-4xl font-bold tracking-tight text-text sm:text-5xl"
          >
            You can close this tab now.
          </h1>
          <p class="mt-4 text-base text-muted">
            Your email is verified — head back to the sign-up tab to continue.
          </p>
        </>
      ) : (
        <>
          <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
            Verification link invalid
          </h1>
          <p class="mt-4 max-w-md text-base text-muted">
            This verification link is invalid or has expired. Please request a
            new verification email from the sign-up page.
          </p>
          <a
            href="/signup"
            class="mt-6 inline-flex items-center rounded-lg bg-blue px-4 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
          >
            Back to Sign Up
          </a>
        </>
      )
    }
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    // The verification link opens in a new tab; the browser forbids closing it
    // programmatically, so instead tell the sign-up tab (same origin) that the
    // challenge is verified.  It flips to "Verified ✓" and flashes its title.
    if (!document.getElementById("verify-success-heading")) return;
    try {
      new BroadcastChannel("mygamedna:email-verification").postMessage(
        "verified",
      );
    } catch {
      /* BroadcastChannel unsupported — the sign-up page's 10s poll covers it */
    }
  })();
</script>

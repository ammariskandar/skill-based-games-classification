---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ErrorState from "../../components/ui/ErrorState.astro";
import QuestionnaireRoot from "../../components/questionnaire/QuestionnaireRoot.astro";
import {
  QuestionnaireApiError,
  getQuestionnaireSession,
} from "../../lib/server/api/questionnaire";
import type { QuestionnaireSessionResponse } from "../../lib/questionnaire/types";

const gameSlug = Astro.url.searchParams.get("game");

if (!gameSlug) {
  return Astro.redirect("/catalogue");
}

const sessionId = Astro.cookies.get("sessionid")?.value;

// SSR authentication wall: no questionnaire markup or scripts for guests.
if (!sessionId) {
  const next = encodeURIComponent(`/questionnaire?game=${gameSlug}`);
  return Astro.redirect(`/login?next=${next}`, 302);
}

type PageState =
  | { kind: "session"; session: QuestionnaireSessionResponse }
  | { kind: "service-error" };

let state: PageState;
try {
  state = {
    kind: "session",
    session: await getQuestionnaireSession(gameSlug, {
      sessionId,
      signal: Astro.request.signal,
    }),
  };
} catch (error: unknown) {
  if (error instanceof QuestionnaireApiError && error.status === 401) {
    // The session cookie is stale/invalid: re-authenticate.
    const next = encodeURIComponent(`/questionnaire?game=${gameSlug}`);
    return Astro.redirect(`/login?next=${next}`, 302);
  }
  if (error instanceof QuestionnaireApiError && error.status === 404) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }
  Astro.response.status = 503;
  state = { kind: "service-error" };
}

const session = state.kind === "session" ? state.session : null;
---

<BaseLayout
  title={session
    ? `DNA Assessment: ${session.game_name}`
    : "Something went wrong"}
  description={session
    ? `Answer the MyGameDNA questionnaire to classify ${session.game_name} across Challenge and Reward.`
    : undefined}
  canonicalPath="/questionnaire"
  robots={session ? "noindex, nofollow" : "noindex, nofollow"}
>
  {
    state.kind === "service-error" ? (
      <ErrorState
        headingLevel="h1"
        title="Questionnaire unavailable"
        message="We could not load this assessment right now. Please try again later."
      />
    ) : (
      <QuestionnaireRoot
        gameSlug={session?.game_slug}
        gameName={session?.game_name}
        canonicalAesthetic={session?.canonical_aesthetic}
        hasConflict={session?.precedence.has_conflict}
        requiresUserChoice={session?.precedence.requires_user_choice}
        manualSubmissionId={session?.precedence.manual_submission_id}
        ageDays={session?.precedence.age_days}
        previousResult={session?.previous_result}
      />
    )
  }
</BaseLayout>

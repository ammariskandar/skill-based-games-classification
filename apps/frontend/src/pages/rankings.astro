---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Rankings"
  description="Top-ranked games by skill dimension on MyGameDNA. See which games lead in Micro, Mystiko, and Macro across both Challenge and Reward profiles."
  canonicalPath="/rankings"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Rankings</h1>

  <div class="mt-8 space-y-6">
    <div class="rounded-lg border border-border bg-surface p-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-muted">
        Awaiting Backend
      </p>
      <h2 class="mt-2 text-xl font-semibold text-text">Rankings coming soon</h2>
      <p class="mt-2 mx-auto max-w-lg text-sm text-muted">
        Rankings by skill dimension will be available once the data pipeline is
        ready. You will be able to compare games by Challenge Micro, Mystiko,
        and Macro, and by Reward Micro, Mystiko, and Macro — six independent
        ranking dimensions.
      </p>
      <p class="mt-3 text-xs text-dim">
        Each profile independently totals 100. Percentages describe skill
        composition, not difficulty, quality, or fun.
      </p>
    </div>
  </div>
</BaseLayout>

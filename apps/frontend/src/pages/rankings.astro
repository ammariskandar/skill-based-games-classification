---
import BaseLayout from "../layouts/BaseLayout.astro";
import RankingsTabs from "../components/rankings/RankingsTabs.astro";
import RankingsSortControl from "../components/rankings/RankingsSortControl.astro";
import RankingRow from "../components/rankings/RankingRow.astro";
import RankingsDetailPane from "../components/rankings/RankingsDetailPane.astro";
import RankingsPagination from "../components/rankings/RankingsPagination.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import ErrorState from "../components/ui/ErrorState.astro";
import {
  parseRankingsState,
  rankingsEmptyKind,
  rankingsHref,
  rankingsNeedsNoindex,
  resolveRankingSelection,
} from "../lib/rankings-state";
import {
  getGameDetail,
  getGameRankings,
  type RankingResponse,
} from "../lib/server/api";
import { presentClassification } from "../lib/classification-presentation";
import type { SkillProfileVector } from "../lib/skill-dimensions";

// Rankings depends on live persisted data: render on demand, never statically.
export const prerender = false;

// SSR renders the full page at a fixed page size; navigation (tabs, sort,
// pagination, selection) is plain MPA via semantic links/forms — the server is
// the single markup authority (SBGC-200 / R4-06).
const SSR_PAGE_SIZE = 5;

const state = parseRankingsState(Astro.url.searchParams);

type PageState =
  | {
      kind: "ready";
      ranking: RankingResponse;
      selectedGame: { slug: string; name: string } | null;
      selectedChallenge: SkillProfileVector | null;
      selectedReward: SkillProfileVector | null;
    }
  | { kind: "service-error" };

let pageState: PageState;
try {
  const ranking = await getGameRankings(
    {
      profile: state.profile,
      dimension: state.dimension,
      direction: state.direction,
      page: state.page,
      pageSize: SSR_PAGE_SIZE,
    },
    { signal: Astro.request.signal },
  );

  // Resolve the detail-pane selection.  A requested slug already on the page
  // wins; otherwise try the game-detail endpoint, and fall back to the
  // top-ranked row when the slug cannot be resolved at all (SBGC-83).
  let resolvedDetail: { slug: string; name: string } | null = null;
  if (
    state.game !== null &&
    !ranking.results.some((game) => game.slug === state.game)
  ) {
    try {
      const detail = await getGameDetail(state.game, {
        signal: Astro.request.signal,
      });
      resolvedDetail = { slug: detail.game.slug, name: detail.game.name };
    } catch {
      resolvedDetail = null;
    }
  }
  const selectedGame = resolveRankingSelection(
    state.game,
    ranking.results,
    resolvedDetail,
  );

  let selectedChallenge: SkillProfileVector | null = null;
  let selectedReward: SkillProfileVector | null = null;
  if (selectedGame) {
    try {
      const detail = await getGameDetail(selectedGame.slug, {
        signal: Astro.request.signal,
      });
      const selectedPresentation = presentClassification(
        detail.classification,
        selectedGame.slug,
      );
      if (selectedPresentation.kind === "ready") {
        selectedChallenge = selectedPresentation.challenge;
        selectedReward = selectedPresentation.reward;
      }
    } catch {
      // Leave unavailable (null) — the radar renders its honest empty state.
    }
  }

  pageState = {
    kind: "ready",
    ranking,
    selectedGame,
    selectedChallenge,
    selectedReward,
  };
} catch {
  // Timeout, network, Django 5xx, or a malformed response all mean the service
  // is unavailable — never "no games ranked". 503 reflects the upstream outage.
  Astro.response.status = 503;
  pageState = { kind: "service-error" };
}

const ranking = pageState.kind === "ready" ? pageState.ranking : null;
const selectedGame = pageState.kind === "ready" ? pageState.selectedGame : null;
const selectedChallenge =
  pageState.kind === "ready" ? pageState.selectedChallenge : null;
const selectedReward =
  pageState.kind === "ready" ? pageState.selectedReward : null;
const games = ranking?.results ?? [];
const count = ranking?.count ?? 0;
const totalPages = ranking?.total_pages ?? 0;
const emptyKind = rankingsEmptyKind(count, games.length);

// Base /rankings is the default state and stays indexable; every non-default
// query state is a transient view (noindex).
const robots = rankingsNeedsNoindex(state) ? "noindex, follow" : undefined;
---

<BaseLayout
  title="Rankings"
  description="Compare games by skill dimension across Unified, Challenge, and Reward profiles on MyGameDNA."
  canonicalPath="/rankings"
  robots={robots}
  preloadGameSearchIndex
  viewportContained
>
  {
    pageState.kind === "service-error" ? (
      <ErrorState
        title="Rankings are temporarily unavailable."
        message="Please try again in a moment."
        code="SERVICE_UNAVAILABLE"
        headingLevel="h1"
      />
    ) : emptyKind === "no-games" ? (
      <EmptyState
        title="No games are currently ranked."
        description="Rankings will appear once games have published skill classifications."
      />
    ) : emptyKind === "page-empty" ? (
      <EmptyState title="No games are available on this page.">
        <a
          href={rankingsHref({ ...state, page: 1 })}
          class="text-sm font-medium text-blue hover:underline"
        >
          Back to first page
        </a>
      </EmptyState>
    ) : (
      <div class="rankings">
        <div class="rankings__controls">
          <RankingsTabs state={state} />
          <RankingsSortControl state={state} />
        </div>

        <section class="rankings__list" aria-label="Ranking list">
          <ul class="rankings__rows">
            {games.map((game, index) => (
              <li>
                <RankingRow
                  game={game}
                  selected={game.slug === selectedGame?.slug}
                  eager={index < 3}
                  href={rankingsHref({ ...state, game: game.slug })}
                />
              </li>
            ))}
          </ul>
        </section>

        <div class="rankings__pagination">
          <RankingsPagination state={state} totalPages={totalPages} />
        </div>

        <section class="rankings__detail">
          <RankingsDetailPane
            selectedGame={selectedGame}
            challenge={selectedChallenge}
            reward={selectedReward}
            profile={state.profile}
          />
        </section>
      </div>
    )
  }
</BaseLayout>

<style>
  .rankings {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "controls detail"
      "list detail"
      "pagination detail";
    column-gap: 1.5rem;
    width: 100%;
    height: 100%;
  }

  .rankings__controls {
    grid-area: controls;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    /* Breathing room between the page shell boundary and the left panel's
       profile tabs / sort control (SBGC-212). Fluid: scales down on mobile. */
    padding-top: clamp(0.75rem, 1.5vw, 1.25rem);
    padding-bottom: 0.75rem;
  }

  .rankings__list {
    grid-area: list;
    min-height: 0;
    min-width: 0;
    overflow-y: auto;
  }

  .rankings__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .rankings__pagination {
    grid-area: pagination;
    padding-top: 0.75rem;
  }

  .rankings__detail {
    grid-area: detail;
    min-height: 0;
    min-width: 0;
    border-left: 1px solid var(--color-border);
    padding-left: 1.5rem;
  }

  @media (max-width: 64rem) {
    .rankings {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        "controls"
        "detail"
        "list"
        "pagination";
      row-gap: 0.75rem;
    }

    .rankings__detail {
      border-left: none;
      padding-left: 0;
    }
  }
</style>

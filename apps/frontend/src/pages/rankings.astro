---
import BaseLayout from "../layouts/BaseLayout.astro";
import RankingsTabs from "../components/rankings/RankingsTabs.astro";
import RankingsSortControl from "../components/rankings/RankingsSortControl.astro";
import RankingRow from "../components/rankings/RankingRow.astro";
import RankingsDetailPane from "../components/rankings/RankingsDetailPane.astro";
import RankingsPagination from "../components/rankings/RankingsPagination.astro";
import RankingsSkeleton from "../components/rankings/RankingsSkeleton.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import ErrorState from "../components/ui/ErrorState.astro";
import {
  parseRankingsState,
  rankingsHref,
  rankingsNeedsNoindex,
} from "../lib/rankings-state";
import {
  getGameDetail,
  getGameRankings,
  type RankingResponse,
} from "../lib/server/api";

// Rankings depends on live persisted data: render on demand, never statically.
export const prerender = false;

// SSR renders with a conservative default page size; the client measures the
// viewport and corrects it (never zero, minimum 1).
const SSR_PAGE_SIZE = 5;

const state = parseRankingsState(Astro.url.searchParams);

type PageState =
  | {
      kind: "ready";
      ranking: RankingResponse;
      selectedGame: { slug: string; name: string } | null;
    }
  | { kind: "service-error" };

let pageState: PageState;
try {
  const ranking = await getGameRankings({
    profile: state.profile,
    dimension: state.dimension,
    direction: state.direction,
    page: state.page,
    pageSize: SSR_PAGE_SIZE,
  });

  let selectedGame: { slug: string; name: string } | null = null;
  if (state.game !== null) {
    // Prefer the already-loaded row; otherwise resolve the name for the detail
    // pane without downloading a second ranking page.
    const inPage = ranking.results.find((game) => game.slug === state.game);
    if (inPage) {
      selectedGame = { slug: inPage.slug, name: inPage.name };
    } else {
      try {
        const detail = await getGameDetail(state.game);
        selectedGame = { slug: detail.game.slug, name: detail.game.name };
      } catch {
        selectedGame = null;
      }
    }
  }

  pageState = { kind: "ready", ranking, selectedGame };
} catch {
  // Timeout, network, Django 5xx, or a malformed response all mean the service
  // is unavailable — never "no games ranked".
  Astro.response.status = 500;
  pageState = { kind: "service-error" };
}

const ranking = pageState.kind === "ready" ? pageState.ranking : null;
const selectedGame = pageState.kind === "ready" ? pageState.selectedGame : null;
const games = ranking?.results ?? [];
const count = ranking?.count ?? 0;
const totalPages = ranking?.total_pages ?? 0;

// Base /rankings is the default state and stays indexable; every non-default
// query state is a transient view (noindex).
const robots = rankingsNeedsNoindex(state) ? "noindex, follow" : undefined;
---

<BaseLayout
  title="Rankings"
  description="Compare games by skill dimension across Unified, Challenge, and Reward profiles on MyGameDNA."
  canonicalPath="/rankings"
  robots={robots}
  preloadGameSearchIndex
  viewportContained
>
  {
    pageState.kind === "service-error" ? (
      <ErrorState
        title="Rankings are temporarily unavailable."
        message="Please try again in a moment."
        headingLevel="h1"
      />
    ) : count === 0 ? (
      <EmptyState
        title="No games are currently ranked."
        description="Rankings will appear once games have published skill classifications."
      />
    ) : games.length === 0 ? (
      <EmptyState title="No games are available on this page.">
        <a
          href={rankingsHref({ ...state, page: 1 })}
          class="text-sm font-medium text-blue hover:underline"
        >
          Back to first page
        </a>
      </EmptyState>
    ) : (
      <div
        class="rankings"
        data-rankings
        data-page-size={SSR_PAGE_SIZE}
        data-selected-name={selectedGame?.name ?? ""}
      >
        <div class="rankings__controls">
          <RankingsTabs state={state} />
          <RankingsSortControl state={state} />
        </div>

        <section
          class="rankings__list"
          data-rankings-list-region
          aria-label="Ranking list"
        >
          <RankingsSkeleton count={SSR_PAGE_SIZE} />
          <ul class="rankings__rows" data-rankings-list>
            {games.map((game, index) => (
              <li>
                <RankingRow
                  game={game}
                  selected={game.slug === selectedGame?.slug}
                  eager={index < 3}
                />
              </li>
            ))}
          </ul>
        </section>

        <div class="rankings__pagination">
          <RankingsPagination state={state} totalPages={totalPages} />
        </div>

        <section class="rankings__detail" data-rankings-detail-pane>
          <RankingsDetailPane selectedGame={selectedGame} />
        </section>
      </div>
    )
  }
</BaseLayout>

<script>
  import {
    SORT_OPTIONS,
    calculatePageSize,
    formatRankingScore,
    parseRankingsState,
    rankingsHref,
    sortKeyFor,
  } from "../lib/rankings-state";
  import type { RankingProfile } from "../lib/rankings-state";

  (() => {
    const root = document.querySelector<HTMLElement>("[data-rankings]");
    if (!root) return;

    const listRegion = root.querySelector<HTMLElement>(
      "[data-rankings-list-region]",
    );
    const list = root.querySelector<HTMLElement>("[data-rankings-list]");
    const skeleton = root.querySelector<HTMLElement>(
      "[data-rankings-skeleton]",
    );
    const detailPane = root.querySelector<HTMLElement>(
      "[data-rankings-detail-pane]",
    );
    const tabs = Array.from(
      root.querySelectorAll<HTMLAnchorElement>("[data-rankings-tab]"),
    );
    const sort = root.querySelector<HTMLSelectElement>("[data-rankings-sort]");
    const prevLink = root.querySelector<HTMLAnchorElement>(
      "[data-rankings-prev]",
    );
    const nextLink = root.querySelector<HTMLAnchorElement>(
      "[data-rankings-next]",
    );

    if (!listRegion || !list || !skeleton || !detailPane || !sort) return;

    let state = parseRankingsState(new URLSearchParams(window.location.search));
    let pageSize = Number(root.dataset.pageSize) || 5;
    let selectedGame: { slug: string; name: string } | null = state.game
      ? { slug: state.game, name: root.dataset.selectedName ?? state.game }
      : null;

    const escapeHtml = (value: string): string =>
      value.replace(/[&<>"']/g, (ch) => {
        switch (ch) {
          case "&":
            return "&amp;";
          case "<":
            return "&lt;";
          case ">":
            return "&gt;";
          case '"':
            return "&quot;";
          default:
            return "&#39;";
        }
      });

    const rowHtml = (game: {
      slug: string;
      name: string;
      hero_url: string;
      score: number;
    }): string => {
      const selected = selectedGame?.slug === game.slug;
      const score = formatRankingScore(game.score);
      const hero = (game.hero_url ?? "").trim();
      const media = hero
        ? `<img src="${escapeHtml(hero)}" alt="" loading="lazy" decoding="async">`
        : "";
      return `<li><button type="button" class="ranking-row${
        selected ? " is-selected" : ""
      }" data-ranking-row data-slug="${escapeHtml(
        game.slug,
      )}" aria-pressed="${selected ? "true" : "false"}" aria-label="${escapeHtml(
        game.name,
      )}, ranking score ${score}"><span class="ranking-row__media">${media}</span><span class="ranking-row__name">${escapeHtml(
        game.name,
      )}</span><span class="ranking-row__score" aria-hidden="true">${score}</span></button></li>`;
    };

    const detailHtml = (
      game: { slug: string; name: string } | null,
    ): string => {
      if (game === null) {
        return `<div class="rankings-detail rankings-detail--empty" data-rankings-detail><p class="rankings-detail__empty">Select one of the games to see details</p></div>`;
      }
      const href = `/games/${encodeURIComponent(game.slug)}`;
      return `<div class="rankings-detail" data-rankings-detail><h2 class="rankings-detail__heading">${escapeHtml(
        game.name,
      )}</h2><div class="rankings-detail__region" aria-hidden="true"><span class="rankings-detail__region-label">Radar / Dominant type</span></div><div class="rankings-detail__actions"><a href="${href}" class="rankings-detail__view" data-rankings-view>View Game</a></div><div class="rankings-detail__region" aria-hidden="true"><span class="rankings-detail__region-label">Similar games</span></div></div>`;
    };

    const showSkeleton = (): void => {
      skeleton.hidden = false;
      list.hidden = true;
    };

    const hideSkeleton = (): void => {
      skeleton.hidden = true;
      list.hidden = false;
    };

    const renderDetail = (): void => {
      detailPane.innerHTML = detailHtml(selectedGame);
    };

    const renderControls = (current: typeof state): void => {
      for (const tab of tabs) {
        const profile = tab.dataset.profile;
        if (!profile) continue;
        const active = profile === current.profile;
        tab.classList.toggle("is-active", active);
        if (active) tab.setAttribute("aria-current", "page");
        else tab.removeAttribute("aria-current");
        tab.href = rankingsHref({
          ...current,
          profile: profile as RankingProfile,
          page: 1,
        });
      }

      const key = sortKeyFor(current.dimension, current.direction);
      if (sort.value !== key) sort.value = key;
    };

    const renderPagination = (current: typeof state, total: number): void => {
      if (prevLink) {
        const hasPrev = current.page > 1;
        prevLink.hidden = !hasPrev;
        prevLink.href = rankingsHref({ ...current, page: current.page - 1 });
      }
      if (nextLink) {
        const hasNext = current.page < total;
        nextLink.hidden = !hasNext;
        nextLink.href = rankingsHref({ ...current, page: current.page + 1 });
      }
    };

    let inflight = 0;

    const load = async (
      target: typeof state,
      targetPageSize: number,
      replace = false,
    ): Promise<void> => {
      const id = ++inflight;
      showSkeleton();
      try {
        const params = new URLSearchParams({
          profile: target.profile,
          dimension: target.dimension,
          direction: target.direction,
          page: String(target.page),
          page_size: String(targetPageSize),
        });
        const response = await fetch(`/api/rankings?${params.toString()}`);
        if (!response.ok) throw new Error("ranking fetch failed");
        const data = await response.json();
        if (id !== inflight) return;

        state = { ...target, page: data.page };
        pageSize = data.page_size;
        list.innerHTML = data.results.map(rowHtml).join("");

        // Refresh the selected game's name if it is on the new page; otherwise
        // keep the in-memory name (selection is independent of page).
        if (selectedGame) {
          const onPage = data.results.find(
            (r: { slug: string }) => r.slug === selectedGame!.slug,
          );
          if (onPage) selectedGame = { slug: onPage.slug, name: onPage.name };
        }

        renderControls(state);
        renderPagination(state, data.total_pages);
        hideSkeleton();
        const url = rankingsHref({
          ...state,
          game: selectedGame?.slug ?? null,
        });
        // Page-size recalculation is not user navigation — replace, don't push.
        if (replace) history.replaceState({}, "", url);
        else history.pushState({}, "", url);
      } catch {
        // Fall back to a server render of the target state.
        window.location.href = rankingsHref({
          ...target,
          game: selectedGame?.slug ?? null,
        });
      }
    };

    const pushSelection = (): void => {
      history.pushState(
        {},
        "",
        rankingsHref({ ...state, game: selectedGame?.slug ?? null }),
      );
    };

    // ── tab / sort / pagination transitions ──
    for (const tab of tabs) {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        const profile = tab.dataset.profile;
        if (!profile || profile === state.profile) return;
        void load(
          { ...state, profile: profile as RankingProfile, page: 1 },
          pageSize,
        );
      });
    }

    sort.addEventListener("change", () => {
      const option = SORT_OPTIONS.find(
        (o) => sortKeyFor(o.dimension, o.direction) === sort.value,
      );
      if (!option) return;
      if (
        option.dimension === state.dimension &&
        option.direction === state.direction
      ) {
        return;
      }
      void load(
        {
          ...state,
          dimension: option.dimension,
          direction: option.direction,
          page: 1,
        },
        pageSize,
      );
    });

    if (prevLink) {
      prevLink.addEventListener("click", (event) => {
        event.preventDefault();
        if (state.page <= 1) return;
        void load({ ...state, page: state.page - 1 }, pageSize);
      });
    }
    if (nextLink) {
      nextLink.addEventListener("click", (event) => {
        event.preventDefault();
        void load({ ...state, page: state.page + 1 }, pageSize);
      });
    }

    // ── row selection (event delegation: rows are replaced) ──
    list.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      const row = target?.closest<HTMLElement>("[data-ranking-row]");
      if (!row || !list.contains(row)) return;
      const slug = row.dataset.slug;
      if (!slug) return;
      const name =
        row.querySelector(".ranking-row__name")?.textContent?.trim() ?? slug;
      selectedGame = { slug, name };
      state = { ...state, game: slug };
      renderDetail();
      for (const el of list.querySelectorAll<HTMLElement>(
        "[data-ranking-row]",
      )) {
        const active = el.dataset.slug === slug;
        el.classList.toggle("is-selected", active);
        el.setAttribute("aria-pressed", active ? "true" : "false");
      }
      pushSelection();
    });

    // ── dynamic page size (mount + resize) ──
    const measurePageSize = (): number => {
      const firstRow = list.querySelector<HTMLElement>("[data-ranking-row]");
      if (!firstRow) return pageSize;
      const regionHeight = listRegion.getBoundingClientRect().height;
      const rowHeight = firstRow.getBoundingClientRect().height;
      const gap =
        parseFloat(
          getComputedStyle(list).rowGap || getComputedStyle(list).gap,
        ) || 0;
      return calculatePageSize(regionHeight, rowHeight, gap);
    };

    const applyMeasuredPageSize = (): void => {
      const measured = measurePageSize();
      if (measured !== pageSize) {
        // Reset to page 1 (item boundaries change) but preserve tab/sort/selection.
        void load({ ...state, page: 1 }, measured, true);
      }
    };

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(applyMeasuredPageSize, 200);
    });

    window.addEventListener("popstate", () => {
      // Back/Forward re-render the URL state server-side.
      window.location.reload();
    });

    // Initial measurement corrects the SSR default page size when necessary.
    applyMeasuredPageSize();
  })();
</script>

<style>
  .rankings {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "controls detail"
      "list detail"
      "pagination detail";
    column-gap: 1.5rem;
    height: 100%;
  }

  .rankings__controls {
    grid-area: controls;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .rankings__list {
    grid-area: list;
    min-height: 0;
    overflow-y: auto;
  }

  .rankings__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .rankings__rows[hidden] {
    display: none;
  }

  .rankings__pagination {
    grid-area: pagination;
    padding-top: 0.75rem;
  }

  .rankings__detail {
    grid-area: detail;
    min-height: 0;
    border-left: 1px solid var(--color-border);
    padding-left: 1.5rem;
  }

  @media (max-width: 64rem) {
    .rankings {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        "controls"
        "detail"
        "list"
        "pagination";
      row-gap: 0.75rem;
    }

    .rankings__detail {
      border-left: none;
      padding-left: 0;
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Rankings"
  description="Top-ranked games by skill dimension on MyGameDNA. See which games lead in Micro, Mystiko, and Macro across both Challenge and Reward profiles."
  canonicalPath="/rankings"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Rankings</h1>
  <p class="mt-4 max-w-2xl text-lg text-muted">
    Rankings by skill dimension are under development. You will be able to
    compare games by Micro, Mystiko, and Macro within their Challenge and Reward
    profiles once the data pipeline is ready.
  </p>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import RankingsTabs from "../components/rankings/RankingsTabs.astro";
import RankingsSortControl from "../components/rankings/RankingsSortControl.astro";
import RankingRow from "../components/rankings/RankingRow.astro";
import RankingsDetailPane from "../components/rankings/RankingsDetailPane.astro";
import RankingsPagination from "../components/rankings/RankingsPagination.astro";
import RankingsSkeleton from "../components/rankings/RankingsSkeleton.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import ErrorState from "../components/ui/ErrorState.astro";
import {
  parseRankingsState,
  rankingsEmptyKind,
  rankingsHref,
  rankingsNeedsNoindex,
  resolveRankingSelection,
} from "../lib/rankings-state";
import {
  getGameDetail,
  getGameRankings,
  type RankingResponse,
} from "../lib/server/api";
import { presentClassification } from "../lib/classification-presentation";
import type { SkillProfileVector } from "../lib/skill-dimensions";

// Rankings depends on live persisted data: render on demand, never statically.
export const prerender = false;

// SSR renders with a conservative default page size; the client measures the
// viewport and corrects it (never zero, minimum 1).
const SSR_PAGE_SIZE = 5;

const state = parseRankingsState(Astro.url.searchParams);

type PageState =
  | {
      kind: "ready";
      ranking: RankingResponse;
      selectedGame: { slug: string; name: string } | null;
      selectedChallenge: SkillProfileVector | null;
      selectedReward: SkillProfileVector | null;
    }
  | { kind: "service-error" };

let pageState: PageState;
try {
  const ranking = await getGameRankings(
    {
      profile: state.profile,
      dimension: state.dimension,
      direction: state.direction,
      page: state.page,
      pageSize: SSR_PAGE_SIZE,
    },
    { signal: Astro.request.signal },
  );

  // Resolve the detail-pane selection.  A requested slug already on the page
  // wins; otherwise try the game-detail endpoint, and fall back to the
  // top-ranked row when the slug cannot be resolved at all (SBGC-83).
  let resolvedDetail: { slug: string; name: string } | null = null;
  if (
    state.game !== null &&
    !ranking.results.some((game) => game.slug === state.game)
  ) {
    try {
      const detail = await getGameDetail(state.game, {
        signal: Astro.request.signal,
      });
      resolvedDetail = { slug: detail.game.slug, name: detail.game.name };
    } catch {
      resolvedDetail = null;
    }
  }
  const selectedGame = resolveRankingSelection(
    state.game,
    ranking.results,
    resolvedDetail,
  );

  let selectedChallenge: SkillProfileVector | null = null;
  let selectedReward: SkillProfileVector | null = null;
  if (selectedGame) {
    try {
      const detail = await getGameDetail(selectedGame.slug, {
        signal: Astro.request.signal,
      });
      const selectedPresentation = presentClassification(
        detail.classification,
        selectedGame.slug,
      );
      if (selectedPresentation.kind === "ready") {
        selectedChallenge = selectedPresentation.challenge;
        selectedReward = selectedPresentation.reward;
      }
    } catch {
      // Leave unavailable (null) — the radar renders its honest empty state.
    }
  }

  pageState = {
    kind: "ready",
    ranking,
    selectedGame,
    selectedChallenge,
    selectedReward,
  };
} catch {
  // Timeout, network, Django 5xx, or a malformed response all mean the service
  // is unavailable — never "no games ranked". 503 reflects the upstream outage.
  Astro.response.status = 503;
  pageState = { kind: "service-error" };
}

const ranking = pageState.kind === "ready" ? pageState.ranking : null;
const selectedGame = pageState.kind === "ready" ? pageState.selectedGame : null;
const selectedChallenge =
  pageState.kind === "ready" ? pageState.selectedChallenge : null;
const selectedReward =
  pageState.kind === "ready" ? pageState.selectedReward : null;
const games = ranking?.results ?? [];
const count = ranking?.count ?? 0;
const totalPages = ranking?.total_pages ?? 0;
const emptyKind = rankingsEmptyKind(count, games.length);

// Base /rankings is the default state and stays indexable; every non-default
// query state is a transient view (noindex).
const robots = rankingsNeedsNoindex(state) ? "noindex, follow" : undefined;
---

<BaseLayout
  title="Rankings"
  description="Compare games by skill dimension across Unified, Challenge, and Reward profiles on MyGameDNA."
  canonicalPath="/rankings"
  robots={robots}
  preloadGameSearchIndex
  viewportContained
>
  {
    pageState.kind === "service-error" ? (
      <ErrorState
        title="Rankings are temporarily unavailable."
        message="Please try again in a moment."
        headingLevel="h1"
      />
    ) : emptyKind === "no-games" ? (
      <EmptyState
        title="No games are currently ranked."
        description="Rankings will appear once games have published skill classifications."
      />
    ) : emptyKind === "page-empty" ? (
      <EmptyState title="No games are available on this page.">
        <a
          href={rankingsHref({ ...state, page: 1 })}
          class="text-sm font-medium text-blue hover:underline"
        >
          Back to first page
        </a>
      </EmptyState>
    ) : (
      <div
        class="rankings"
        data-rankings
        data-page-size={SSR_PAGE_SIZE}
        data-selected-slug={selectedGame?.slug ?? ""}
        data-selected-name={selectedGame?.name ?? ""}
      >
        <div class="rankings__controls">
          <RankingsTabs state={state} />
          <RankingsSortControl state={state} />
        </div>

        <section
          class="rankings__list"
          data-rankings-list-region
          aria-label="Ranking list"
        >
          <div class="rankings__error" data-rankings-error role="alert" hidden>
            <p class="rankings__error-message">
              Rankings couldn't be updated. Please try again.
            </p>
            <button
              type="button"
              class="rankings__error-retry"
              data-rankings-retry
            >
              Retry
            </button>
          </div>
          <RankingsSkeleton count={SSR_PAGE_SIZE} />
          <ul class="rankings__rows" data-rankings-list>
            {games.map((game, index) => (
              <li>
                <RankingRow
                  game={game}
                  selected={game.slug === selectedGame?.slug}
                  eager={index < 3}
                />
              </li>
            ))}
          </ul>
        </section>

        <div class="rankings__pagination">
          <RankingsPagination state={state} totalPages={totalPages} />
        </div>

        <section class="rankings__detail" data-rankings-detail-pane>
          <RankingsDetailPane
            selectedGame={selectedGame}
            challenge={selectedChallenge}
            reward={selectedReward}
            profile={state.profile}
          />
        </section>
      </div>
    )
  }
</BaseLayout>

<script>
  import {
    SORT_OPTIONS,
    calculatePageSize,
    formatRankingScore,
    parseRankingsState,
    rankingsHref,
    sortKeyFor,
  } from "../lib/rankings-state";
  import type { RankingProfile } from "../lib/rankings-state";
  import { createRankingsLoader } from "../lib/rankings-load";
  import { buildRadarHtml } from "../lib/radar-render";
  import {
    dominantBadgeHtml,
    dominantForProfile,
    dominantRegionHtml,
    presentClassification,
  } from "../lib/classification-presentation";
  import { getRadarHandle, initRadarChart } from "../lib/radar-controller";
  import type { SkillProfileVector } from "../lib/skill-dimensions";

  (() => {
    const root = document.querySelector<HTMLElement>("[data-rankings]");
    if (!root) return;

    const listRegion = root.querySelector<HTMLElement>(
      "[data-rankings-list-region]",
    );
    const list = root.querySelector<HTMLElement>("[data-rankings-list]");
    const skeleton = root.querySelector<HTMLElement>(
      "[data-rankings-skeleton]",
    );
    const detailPane = root.querySelector<HTMLElement>(
      "[data-rankings-detail-pane]",
    );
    const errorRegion = root.querySelector<HTMLElement>(
      "[data-rankings-error]",
    );
    const retryButton = root.querySelector<HTMLButtonElement>(
      "[data-rankings-retry]",
    );
    const tabs = Array.from(
      root.querySelectorAll<HTMLAnchorElement>("[data-rankings-tab]"),
    );
    const sort = root.querySelector<HTMLSelectElement>("[data-rankings-sort]");
    const prevLink = root.querySelector<HTMLAnchorElement>(
      "[data-rankings-prev]",
    );
    const nextLink = root.querySelector<HTMLAnchorElement>(
      "[data-rankings-next]",
    );

    if (!listRegion || !list || !skeleton || !detailPane || !sort) return;

    let state = parseRankingsState(new URLSearchParams(window.location.search));
    let pageSize = Number(root.dataset.pageSize) || 5;
    const resolvedSlug = root.dataset.selectedSlug ?? "";
    let selectedGame: { slug: string; name: string } | null = resolvedSlug
      ? { slug: resolvedSlug, name: root.dataset.selectedName ?? resolvedSlug }
      : null;
    // The server may have fallen back from an unresolvable `?game=` slug to the
    // top-ranked item; align the client URL state with that resolved selection
    // so subsequent pushState URLs stay canonical (SBGC-83).
    if (state.game !== (resolvedSlug || null)) {
      state = { ...state, game: resolvedSlug || null };
    }

    const escapeHtml = (value: string): string =>
      value.replace(/[&<>"']/g, (ch) => {
        switch (ch) {
          case "&":
            return "&amp;";
          case "<":
            return "&lt;";
          case ">":
            return "&gt;";
          case '"':
            return "&quot;";
          default:
            return "&#39;";
        }
      });

    const rowHtml = (game: {
      slug: string;
      name: string;
      hero_url: string;
      score: number;
    }): string => {
      const selected = selectedGame?.slug === game.slug;
      const score = formatRankingScore(game.score);
      const hero = (game.hero_url ?? "").trim();
      const media = hero
        ? `<img src="${escapeHtml(hero)}" alt="" loading="lazy" decoding="async">`
        : "";
      return `<li><button type="button" class="ranking-row${
        selected ? " is-selected" : ""
      }" data-ranking-row data-slug="${escapeHtml(
        game.slug,
      )}" aria-pressed="${selected ? "true" : "false"}" aria-label="${escapeHtml(
        game.name,
      )}, ranking score ${score}"><span class="ranking-row__media">${media}</span><span class="ranking-row__name">${escapeHtml(
        game.name,
      )}</span><span class="ranking-row__score" aria-hidden="true">${score}</span></button></li>`;
    };

    const detailHtml = (
      game: { slug: string; name: string } | null,
    ): string => {
      if (game === null) {
        return `<div class="rankings-detail rankings-detail--empty" data-rankings-detail><p class="rankings-detail__empty">Select one of the games to see details</p></div>`;
      }
      const href = `/games/${encodeURIComponent(game.slug)}`;
      return `<div class="rankings-detail" data-rankings-detail><h2 class="rankings-detail__heading">${escapeHtml(
        game.name,
      )}</h2><div class="rankings-detail__actions"><a href="${href}" class="rankings-detail__view" data-rankings-view>View Game <span aria-hidden="true">&gt;&gt;</span></a></div><div class="rankings-detail__upper"><div class="rankings-detail__region rankings-detail__region--radar" data-radar-region><span class="rankings-detail__region-label">Radar</span></div><div class="rankings-detail__region rankings-detail__region--dominant"><div class="rankings-detail__dominant" data-dominant-region>${dominantBadgeHtml(
        null,
        false,
      )}</div></div></div><div class="rankings-detail__grow" aria-hidden="true"><span class="rankings-detail__region-label">Suggested Games</span></div></div>`;
    };

    // Present the skeleton only after a short delay so a fast transition never
    // flashes it.  A single owned timer is reused across transitions, and it is
    // cancelled as soon as the request settles (fast or superseded).
    const SKELETON_DELAY_MS = 300;
    let skeletonTimer = 0;

    const showSkeleton = (): void => {
      window.clearTimeout(skeletonTimer);
      skeletonTimer = window.setTimeout(() => {
        skeleton.hidden = false;
        list.hidden = true;
      }, SKELETON_DELAY_MS);
    };

    const hideSkeleton = (): void => {
      window.clearTimeout(skeletonTimer);
      skeleton.hidden = true;
      list.hidden = false;
    };

    // Classification vectors for the selected game, cached so the dominant
    // badge can follow profile-tab switches without refetching.  Seeded from
    // the SSR-rendered pane and reset whenever a new selection is rendered.
    let lastClassification: {
      challenge: SkillProfileVector;
      reward: SkillProfileVector;
    } | null = null;

    const readSeed = (): typeof lastClassification => {
      const pane = detailPane.querySelector<HTMLElement>(
        "[data-rankings-detail]",
      );
      if (!pane) return null;
      const rawChallenge = pane.dataset.challenge;
      const rawReward = pane.dataset.reward;
      if (!rawChallenge || !rawReward) return null;
      try {
        const challenge = JSON.parse(rawChallenge) as SkillProfileVector;
        const reward = JSON.parse(rawReward) as SkillProfileVector;
        return { challenge, reward };
      } catch {
        return null;
      }
    };
    lastClassification = readSeed();

    const renderDominant = (profile: RankingProfile): void => {
      const region = detailPane.querySelector<HTMLElement>(
        "[data-dominant-region]",
      );
      if (!region) return;
      const classification = lastClassification;
      region.innerHTML = dominantRegionHtml(
        profile,
        classification
          ? dominantForProfile(
              profile,
              classification.challenge,
              classification.reward,
            )
          : null,
        classification !== null,
      );
    };

    const renderDetail = (): void => {
      lastClassification = null;
      detailPane.innerHTML = detailHtml(selectedGame);
    };

    let radarRequestId = 0;

    // The radar's Challenge/Reward toggle only shows on the Unified profile;
    // on the Challenge/Reward tabs the active layer is forced to that profile
    // and the toggle is hidden.  Returning to Unified only unhides — no
    // auto-toggle and no reset, so the user's last toggle choice persists.
    const applyRadarProfile = (profile: RankingProfile): void => {
      const region = detailPane.querySelector<HTMLElement>(
        "[data-radar-region]",
      );
      if (!region) return;
      region.classList.toggle("radar-toggle-hidden", profile !== "unified");
      const toggleGroup = region.querySelector<HTMLElement>(
        ".radar-toggle-group",
      );
      if (toggleGroup) {
        toggleGroup.style.display = profile === "unified" ? "" : "none";
      }
      if (profile !== "unified") {
        const chart = region.querySelector<HTMLElement>("[data-radar-chart]");
        const handle = chart ? getRadarHandle(chart) : null;
        handle?.setProfile(profile);
      }
    };

    const loadRadar = async (
      game: { slug: string; name: string },
      profileOverride?: RankingProfile,
    ): Promise<void> => {
      const requestId = ++radarRequestId;
      const region = detailPane.querySelector<HTMLElement>(
        "[data-radar-region]",
      );
      if (!region) return;

      try {
        const response = await fetch(
          `/api/games/${encodeURIComponent(game.slug)}`,
        );
        if (!response.ok) return;
        const data = (await response.json()) as {
          classification: unknown;
        };
        if (requestId !== radarRequestId) return;

        const profile = profileOverride ?? state.profile;
        const presentation = presentClassification(
          data.classification,
          game.slug,
        );
        if (presentation.kind !== "ready") {
          lastClassification = null;
          renderDominant(profile);
          return;
        }

        lastClassification = {
          challenge: presentation.challenge,
          reward: presentation.reward,
        };
        region.innerHTML = buildRadarHtml({
          challenge: presentation.challenge,
          reward: presentation.reward,
          gameTitle: game.name,
          initialProfile: profile === "unified" ? undefined : profile,
        });

        const chart = region.querySelector<HTMLElement>("[data-radar-chart]");
        if (chart) initRadarChart(chart);
        applyRadarProfile(profile);
        renderDominant(profile);
      } catch {
        // Keep the "Radar" placeholder — unclassified or fetch failure.
      }
    };

    const renderControls = (current: typeof state): void => {
      for (const tab of tabs) {
        const profile = tab.dataset.profile;
        if (!profile) continue;
        const active = profile === current.profile;
        tab.classList.toggle("is-active", active);
        if (active) tab.setAttribute("aria-current", "page");
        else tab.removeAttribute("aria-current");
        tab.href = rankingsHref({
          ...current,
          profile: profile as RankingProfile,
          page: 1,
        });
      }

      const key = sortKeyFor(current.dimension, current.direction);
      if (sort.value !== key) sort.value = key;
    };

    const renderPagination = (current: typeof state, total: number): void => {
      if (prevLink) {
        const hasPrev = current.page > 1;
        prevLink.hidden = !hasPrev;
        prevLink.href = rankingsHref({ ...current, page: current.page - 1 });
      }
      if (nextLink) {
        const hasNext = current.page < total;
        nextLink.hidden = !hasNext;
        nextLink.href = rankingsHref({ ...current, page: current.page + 1 });
      }
    };

    // Single-owner transition loader: owns the in-flight request-id guard so a
    // slow/earlier response can never overwrite a newer one (SBGC-83).
    const runLoad = createRankingsLoader((url) => fetch(url));

    const showError = (): void => {
      if (errorRegion) errorRegion.hidden = false;
    };

    const hideError = (): void => {
      if (errorRegion) errorRegion.hidden = true;
    };

    let lastFailedLoad: {
      target: typeof state;
      pageSize: number;
      replace: boolean;
    } | null = null;

    const load = async (
      target: typeof state,
      targetPageSize: number,
      replace = false,
    ): Promise<void> => {
      lastFailedLoad = { target, pageSize: targetPageSize, replace };
      hideError();
      showSkeleton();

      const outcome = await runLoad({
        profile: target.profile,
        dimension: target.dimension,
        direction: target.direction,
        page: target.page,
        pageSize: targetPageSize,
      });

      // A superseded request must not touch the shared UI state.
      if (outcome.kind === "stale") return;

      if (outcome.kind === "error") {
        // Keep the previously rendered list intact and offer an inline retry.
        hideSkeleton();
        showError();
        return;
      }

      const data = outcome.data;
      state = { ...target, page: data.page };
      pageSize = data.page_size;
      list.innerHTML = data.results.map(rowHtml).join("");

      // Refresh the selected game's name if it is on the new page; otherwise
      // keep the in-memory name (selection is independent of page).
      if (selectedGame) {
        const onPage = data.results.find(
          (r: { slug: string }) => r.slug === selectedGame!.slug,
        );
        if (onPage) selectedGame = { slug: onPage.slug, name: onPage.name };
      }

      renderControls(state);
      renderPagination(state, data.total_pages);
      hideSkeleton();
      const url = rankingsHref({
        ...state,
        game: selectedGame?.slug ?? null,
      });
      // Page-size recalculation is not user navigation — replace, don't push.
      if (replace) history.replaceState({}, "", url);
      else history.pushState({}, "", url);
    };

    if (retryButton) {
      retryButton.addEventListener("click", () => {
        if (!lastFailedLoad) return;
        void load(
          lastFailedLoad.target,
          lastFailedLoad.pageSize,
          lastFailedLoad.replace,
        );
      });
    }

    const pushSelection = (): void => {
      history.pushState(
        {},
        "",
        rankingsHref({ ...state, game: selectedGame?.slug ?? null }),
      );
    };

    // ── tab / sort / pagination transitions ──
    for (const tab of tabs) {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        const profile = tab.dataset.profile;
        if (!profile || profile === state.profile) return;
        // The badge is profile-dependent; recompute it immediately from the
        // cached vectors, or fetch them when this selection has no cache yet.
        if (lastClassification) {
          renderDominant(profile as RankingProfile);
        } else if (selectedGame) {
          void loadRadar(selectedGame, profile as RankingProfile);
        }
        applyRadarProfile(profile as RankingProfile);
        void load(
          { ...state, profile: profile as RankingProfile, page: 1 },
          pageSize,
        );
      });
    }

    sort.addEventListener("change", () => {
      const option = SORT_OPTIONS.find(
        (o) => sortKeyFor(o.dimension, o.direction) === sort.value,
      );
      if (!option) return;
      if (
        option.dimension === state.dimension &&
        option.direction === state.direction
      ) {
        return;
      }
      void load(
        {
          ...state,
          dimension: option.dimension,
          direction: option.direction,
          page: 1,
        },
        pageSize,
      );
    });

    if (prevLink) {
      prevLink.addEventListener("click", (event) => {
        event.preventDefault();
        if (state.page <= 1) return;
        void load({ ...state, page: state.page - 1 }, pageSize);
      });
    }
    if (nextLink) {
      nextLink.addEventListener("click", (event) => {
        event.preventDefault();
        void load({ ...state, page: state.page + 1 }, pageSize);
      });
    }

    // ── row selection (event delegation: rows are replaced) ──
    list.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      const row = target?.closest<HTMLElement>("[data-ranking-row]");
      if (!row || !list.contains(row)) return;
      const slug = row.dataset.slug;
      if (!slug) return;
      const name =
        row.querySelector(".ranking-row__name")?.textContent?.trim() ?? slug;
      selectedGame = { slug, name };
      state = { ...state, game: slug };
      renderDetail();
      void loadRadar(selectedGame);
      for (const el of list.querySelectorAll<HTMLElement>(
        "[data-ranking-row]",
      )) {
        const active = el.dataset.slug === slug;
        el.classList.toggle("is-selected", active);
        el.setAttribute("aria-pressed", active ? "true" : "false");
      }
      pushSelection();
    });

    // ── dynamic page size (mount + resize) ──
    const measurePageSize = (): number => {
      const firstRow = list.querySelector<HTMLElement>("[data-ranking-row]");
      if (!firstRow) return pageSize;
      const regionHeight = listRegion.getBoundingClientRect().height;
      const rowHeight = firstRow.getBoundingClientRect().height;
      const gap =
        parseFloat(
          getComputedStyle(list).rowGap || getComputedStyle(list).gap,
        ) || 0;
      return calculatePageSize(regionHeight, rowHeight, gap);
    };

    const applyMeasuredPageSize = (): void => {
      const measured = measurePageSize();
      if (measured !== pageSize) {
        // Reset to page 1 (item boundaries change) but preserve tab/sort/selection.
        void load({ ...state, page: 1 }, measured, true);
      }
    };

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(applyMeasuredPageSize, 200);
    });

    window.addEventListener("popstate", () => {
      // Back/Forward re-render the URL state server-side.
      window.location.reload();
    });

    // Initial measurement corrects the SSR default page size when necessary.
    applyMeasuredPageSize();
  })();
</script>

<style>
  .rankings {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "controls detail"
      "list detail"
      "pagination detail";
    column-gap: 1.5rem;
    width: 100%;
    height: 100%;
  }

  .rankings__controls {
    grid-area: controls;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    /* Breathing room between the page shell boundary and the left panel's
       profile tabs / sort control (SBGC-212). Fluid: scales down on mobile. */
    padding-top: clamp(0.75rem, 1.5vw, 1.25rem);
    padding-bottom: 0.75rem;
  }

  .rankings__list {
    grid-area: list;
    min-height: 0;
    min-width: 0;
    overflow-y: auto;
  }

  .rankings__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .rankings__rows[hidden] {
    display: none;
  }

  .rankings__error {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.625rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-2);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .rankings__error[hidden] {
    display: none;
  }

  .rankings__error-message {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .rankings__error-retry {
    flex: none;

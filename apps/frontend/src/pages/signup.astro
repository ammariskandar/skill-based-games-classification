---
import BaseLayout from "../layouts/BaseLayout.astro";
import PasswordStrengthMeter from "../components/ui/PasswordStrengthMeter.astro";

// SSR only. An already-authenticated visitor is bounced home; the 30-minute
// bot lockout (localStorage) is enforced client-side below.
export const prerender = false;

if (Astro.cookies.has("sessionid")) {
  return Astro.redirect("/");
}
---

<BaseLayout title="Sign Up - MyGameDNA">
  <main
    class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center px-4 py-12"
  >
    <div class="rounded-xl border border-border bg-surface p-8 shadow-sm">
      <header class="mb-6 text-center">
        <h1 class="text-2xl font-bold tracking-tight text-text">
          Create account
        </h1>
        <p class="mt-1 text-sm text-muted">
          Verify your email to create your MyGameDNA account
        </p>
      </header>

      <div
        id="signup-error-banner"
        role="alert"
        class="mb-6 hidden rounded-lg border border-red/30 bg-red/10 p-3 text-sm text-red"
      >
        <span id="signup-error-message">Something went wrong.</span>
      </div>

      <form id="signup-form" class="flex flex-col gap-4" novalidate>
        <!-- Honeypot trap (off-screen) -->
        <input
          type="text"
          name="company_website"
          tabindex="-1"
          autocomplete="off"
          class="hidden-field"
          style="position: absolute; left: -9999px;"
          aria-hidden="true"
        />

        <div>
          <label for="username" class="block text-sm font-medium text-text">
            Username
          </label>
          <input
            id="username"
            name="username"
            type="text"
            required
            minlength="4"
            maxlength="20"
            autocomplete="username"
            class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-dim focus:border-blue focus:outline-none focus:ring-1 focus:ring-blue"
          />
          <span
            id="username-badge"
            class="mt-1 block min-h-4 text-xs text-muted"></span>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-text">
            Email
          </label>
          <div
            id="email-field"
            class="email-field relative mt-1.5 flex items-center gap-2"
          >
            <input
              id="email"
              name="email"
              type="text"
              inputmode="email"
              autocomplete="email"
              autocapitalize="none"
              spellcheck="false"
              maxlength="254"
              aria-invalid="false"
              aria-required="true"
              aria-describedby="email-validation-hint"
              class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-dim focus:border-blue focus:outline-none focus:ring-1 focus:ring-blue"
            />
            <button
              id="verify-button"
              type="button"
              disabled
              class="shrink-0 rounded-lg bg-surface-2 px-3 py-2 text-sm font-medium text-text transition-colors hover:bg-surface-3 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue disabled:opacity-50"
            >
              Verify email
            </button>
            <div
              id="email-validation-hint"
              role="tooltip"
              class="email-validation-hint pointer-events-none absolute left-0 top-full z-20 mt-2 w-max max-w-xs rounded-lg border border-border bg-surface px-3 py-2 text-xs leading-snug text-text shadow-xl"
            >
              Emails must contain @ and a valid web domain after it i.e.
              abc@email.com
            </div>
          </div>
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-text">
            Password
          </label>
          <input
            id="password"
            name="password"
            type="password"
            required
            minlength="8"
            maxlength="128"
            autocomplete="new-password"
            class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-dim focus:border-blue focus:outline-none focus:ring-1 focus:ring-blue"
          />
          <PasswordStrengthMeter inputId="password" />
        </div>

        <button
          id="signup-submit"
          type="submit"
          disabled
          class="mt-2 flex w-full items-center justify-center rounded-lg bg-blue px-4 py-2.5 text-sm font-semibold text-bg shadow-sm transition-opacity hover:opacity-90 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue disabled:opacity-50"
        >
          <span>Sign Up</span>
        </button>
      </form>

      <div class="mt-6 border-t border-border pt-4 text-center">
        <p class="text-sm text-muted">
          Already have an account?{" "}
          <a href="/login" class="font-medium text-blue hover:underline">
            Login &gt;&gt;
          </a>
        </p>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* Custom email-validation tooltip.  Hidden by default; revealed on
     hover/focus of the email row while the JS has flagged the value as an
     incomplete address (data-email-invalid="true").  This replaces the
     browser's native bubble, whose text cannot be customised. */
  .email-validation-hint {
    display: none;
  }

  .email-field[data-email-invalid="true"]:hover .email-validation-hint,
  .email-field[data-email-invalid="true"]:focus-within .email-validation-hint {
    display: block;
  }
</style>

<script>
  import { initAntiTamper } from "../lib/anti-tamper";
  import { isPasswordStrong } from "../lib/password-strength";
  import { writeCachedAuthStatus } from "../lib/auth-status";
  import { captureDeviceSignature } from "../lib/device-signature";
  import {
    canResume,
    clearSignupResume,
    normalizeEmail,
    readSignupResume,
    writeSignupResume,
  } from "../lib/signup-resume";

  const LOCKOUT_MS = 30 * 60 * 1000;
  const LOCKOUT_KEY = "mygamedna:bot_lockout";
  // reCAPTCHA v3 is opt-in: without a site key the page skips it and sends a
  // `test-recaptcha-token` the DEBUG backend accepts (no real reCAPTCHA round-trip).
  const SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || "";

  type Recaptcha = {
    ready: (cb: () => void) => void;
    execute: (siteKey: string, opts: { action: string }) => Promise<string>;
  };
  const grecaptcha = (window as unknown as { grecaptcha?: Recaptcha })
    .grecaptcha;

  function isBotLockedOut(): boolean {
    try {
      const lockedAt = Number(localStorage.getItem(LOCKOUT_KEY) || 0);
      return lockedAt > 0 && Date.now() - lockedAt < LOCKOUT_MS;
    } catch {
      return false;
    }
  }

  function getResumeStorage(): typeof localStorage | null {
    try {
      return window.localStorage;
    } catch {
      return null;
    }
  }

  // Device signature captured once per page session: OS family, browser
  // family, and IANA timezone.  A stored challenge is only resumed when the
  // signature still matches — never across systems (no cross-device resume).
  const deviceSignature = captureDeviceSignature();
  const resumeStorage = getResumeStorage();

  function setBotLockout(): void {
    try {
      localStorage.setItem(LOCKOUT_KEY, String(Date.now()));
    } catch {
      /* storage unavailable */
    }
    window.location.href = "/signup-error";
  }

  if (isBotLockedOut()) {
    window.location.href = "/signup-error";
  }

  initAntiTamper();

  // Load reCAPTCHA v3 dynamically only when a site key is configured.
  if (SITE_KEY) {
    const recaptchaScript = document.createElement("script");
    recaptchaScript.src = `https://www.google.com/recaptcha/api.js?render=${SITE_KEY}`;
    recaptchaScript.async = true;
    document.head.appendChild(recaptchaScript);
  }

  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const usernameInput = document.getElementById(
    "username",
  ) as HTMLInputElement | null;
  const usernameBadge = document.getElementById("username-badge");
  const emailInput = document.getElementById(
    "email",
  ) as HTMLInputElement | null;
  const emailField = document.getElementById("email-field");
  const verifyButton = document.getElementById(
    "verify-button",
  ) as HTMLButtonElement | null;
  const passwordInput = document.getElementById(
    "password",
  ) as HTMLInputElement | null;
  const submitBtn = document.getElementById(
    "signup-submit",
  ) as HTMLButtonElement | null;
  const errorBanner = document.getElementById("signup-error-banner");
  const errorMsg = document.getElementById("signup-error-message");

  // ── state ────────────────────────────────────────────────────────────────
  let usernameAvailable = false;
  let emailVerified = false;
  let challengeId: string | null = null;
  let resendCount = 0;
  let verifyButtonLockedUntil = 0;
  let pollTimer: ReturnType<typeof setInterval> | null = null;

  // The verification email opens in a *separate* tab, so this tab draws the
  // user back by briefly alternating the document title when verification
  // lands (the tab bar flashes while the tab is in the background).
  const originalPageTitle = document.title;
  let titleFlashTimer: ReturnType<typeof setInterval> | null = null;
  let titleFlashReset: ReturnType<typeof setTimeout> | null = null;

  function stopTitleFlash(): void {
    if (titleFlashTimer) {
      clearInterval(titleFlashTimer);
      titleFlashTimer = null;
    }
    if (titleFlashReset) {
      clearTimeout(titleFlashReset);
      titleFlashReset = null;
    }
    document.title = originalPageTitle;
  }

  function flashVerifiedTitle(): void {
    if (titleFlashTimer || titleFlashReset) return;
    const verifiedTitle = "✓ Email verified — finish signing up";
    let showVerified = false;
    let ticks = 0;
    titleFlashTimer = setInterval(() => {
      ticks += 1;
      if (ticks >= 10) {
        stopTitleFlash();
        return;
      }
      showVerified = !showVerified;
      document.title = showVerified ? verifiedTitle : originalPageTitle;
    }, 600);
    titleFlashReset = setTimeout(stopTitleFlash, 6500);
  }

  // The verification tab posts on this channel the moment the emailed link is
  // confirmed; the 10s status poll below is the fallback for browsers/tabs
  // that cannot share a BroadcastChannel.
  try {
    const verifyChannel = new BroadcastChannel("mygamedna:email-verification");
    verifyChannel.onmessage = (event: MessageEvent) => {
      if (event.data === "verified") {
        void checkVerificationStatus();
      }
    };
  } catch {
    /* BroadcastChannel unsupported — polling still detects verification */
  }

  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) stopTitleFlash();
  });

  function showError(message: string): void {
    if (!errorBanner || !errorMsg) return;
    errorMsg.textContent = message;
    errorBanner.classList.remove("hidden");
  }

  function executeRecaptcha(action: string): Promise<string> {
    // No configured key → dev fallback token (the DEBUG backend bypasses it).
    if (!SITE_KEY) {
      return Promise.resolve("test-recaptcha-token");
    }
    return new Promise((resolve, reject) => {
      if (!grecaptcha) {
        reject(new Error("reCAPTCHA not loaded"));
        return;
      }
      grecaptcha.ready(() => {
        grecaptcha.execute(SITE_KEY, { action }).then(resolve).catch(reject);
      });
    });
  }

  function updateSubmitState(): void {
    if (!submitBtn) return;
    const usernameOk =
      usernameInput?.value != null &&
      /^[a-zA-Z0-9_-]{4,20}$/.test(usernameInput.value) &&
      usernameAvailable;
    const passwordOk = passwordInput
      ? isPasswordStrong(passwordInput.value)
      : false;
    submitBtn.disabled = !(usernameOk && emailVerified && passwordOk);
  }

  // ── username availability ────────────────────────────────────────────────
  let usernameTimer: ReturnType<typeof setTimeout> | null = null;

  function checkUsername(): void {
    if (!usernameInput || !usernameBadge) return;
    const value = usernameInput.value;
    if (!/^[a-zA-Z0-9_-]{4,20}$/.test(value)) {
      usernameAvailable = false;
      usernameBadge.textContent =
        "Username must be 4-20 letters, numbers, _ or -.";
      usernameBadge.className = "mt-1 block min-h-4 text-xs text-muted";
      updateSubmitState();
      return;
    }

    fetch(`/api/auth/check-username?username=${encodeURIComponent(value)}`, {
      headers: { Accept: "application/json" },
    })
      .then((res) => res.json())
      .then((data: { available?: boolean }) => {
        usernameAvailable = Boolean(data.available);
        if (usernameBadge) {
          usernameBadge.textContent = usernameAvailable
            ? "Available ✓"
            : "Taken ✕";
          usernameBadge.className = usernameAvailable
            ? "mt-1 block min-h-4 text-xs text-green"
            : "mt-1 block min-h-4 text-xs text-red";
        }
        updateSubmitState();
      })
      .catch(() => {
        usernameAvailable = false;
        updateSubmitState();
      });
  }

  usernameInput?.addEventListener("input", () => {
    if (usernameTimer) clearTimeout(usernameTimer);
    usernameTimer = setTimeout(checkUsername, 300);
  });

  // ── email verification ───────────────────────────────────────────────────
  // Structural email gate: no spaces are allowed while typing (the backend
  // still trims defensively), and the Verify button stays disabled until the
  // value looks like a real address (`user@domain.tld`).  The user expects a
  // malformed address to *fail*, not to be silently rewritten.
  const EMAIL_VALID_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  // Whether a verification email was already requested for the current value;
  // drives the "Email Sent ✓ → Resend verification" label cycle.
  let emailRequested = false;
  const VERIFY_BUTTON_BASE_CLASS =
    "shrink-0 rounded-lg bg-surface-2 px-3 py-2 text-sm font-medium text-text transition-colors hover:bg-surface-3 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue disabled:opacity-50";

  function emailLooksValid(value: string): boolean {
    return EMAIL_VALID_REGEX.test(value);
  }

  function syncEmailValidityMessage(): void {
    // The custom hover tooltip replaces the browser's native bubble (whose
    // text cannot be controlled).  Flag the field so CSS shows the tooltip on
    // hover/focus only while an incomplete address is present; also reflect
    // the state on aria-invalid for assistive tech.
    if (!emailInput) return;
    const value = emailInput.value;
    const incomplete = value !== "" && !emailLooksValid(value);
    emailField?.setAttribute(
      "data-email-invalid",
      incomplete ? "true" : "false",
    );
    emailInput.setAttribute("aria-invalid", incomplete ? "true" : "false");
  }

  function renderVerifyButton(): void {
    if (!verifyButton) return;
    if (emailVerified) return; // markEmailVerified owns the verified state
    const locked = Date.now() < verifyButtonLockedUntil;
    if (locked) {
      verifyButton.textContent = "Email Sent ✓";
      verifyButton.disabled = true;
      verifyButton.className = VERIFY_BUTTON_BASE_CLASS;
      return;
    }
    const valid = emailLooksValid(emailInput?.value ?? "");
    verifyButton.disabled = !valid;
    verifyButton.textContent = emailRequested
      ? "Resend verification"
      : "Verify email";
    verifyButton.className = VERIFY_BUTTON_BASE_CLASS;
  }

  emailInput?.addEventListener("keydown", (event) => {
    if (event.key === " ") event.preventDefault();
  });

  emailInput?.addEventListener("input", () => {
    // Any edit orphans the in-flight challenge: the VERIFIED status (or the
    // pending request) belongs to the previously typed address, so drop it and
    // force a fresh verification before the submit gate can reopen.
    emailRequested = false;
    challengeId = null;
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
    if (emailVerified) {
      emailVerified = false;
    }
    syncEmailValidityMessage();
    renderVerifyButton();
    updateSubmitState();
  });

  renderVerifyButton(); // empty/invalid email starts the button disabled
  syncEmailValidityMessage(); // honour autofilled values before any typing

  async function checkVerificationStatus(): Promise<void> {
    if (!challengeId || emailVerified) return;
    try {
      const res = await fetch(
        `/api/auth/verification-status?challenge_id=${encodeURIComponent(challengeId)}`,
        { headers: { Accept: "application/json" } },
      );
      const data = (await res.json()) as { verified?: boolean };
      if (data.verified) {
        markEmailVerified();
        flashVerifiedTitle();
      }
    } catch {
      // Transient network error — the next poll tick retries.
    }
  }

  function startPolling(): void {
    if (pollTimer || !challengeId) return;
    // Check immediately so an already-verified challenge (e.g. resuming after
    // a dropoff, or a BroadcastChannel signal) flips the button without
    // waiting a full poll cycle.
    void checkVerificationStatus();
    pollTimer = setInterval(() => {
      void checkVerificationStatus();
    }, 10_000);
  }

  function markEmailVerified(): void {
    emailVerified = true;
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = null;
    if (verifyButton) {
      verifyButton.textContent = "Verified ✓";
      verifyButton.disabled = true;
      verifyButton.className =
        "shrink-0 rounded-lg bg-green px-3 py-2 text-sm font-medium text-bg";
    }
    updateSubmitState();
  }

  async function tryResumeVerification(email: string): Promise<boolean> {
    // Strict dropoff resume: reuse a stored challenge only when (a) the typed
    // email matches, (b) the current device signature matches the system that
    // requested it, and (c) the backend still reports the challenge VERIFIED.
    if (!resumeStorage) return false;
    const record = readSignupResume(resumeStorage);
    if (!record) return false;
    if (!canResume(record, email, deviceSignature)) return false;

    try {
      const res = await fetch(
        `/api/auth/verification-status?challenge_id=${encodeURIComponent(record.challengeId)}`,
        { headers: { Accept: "application/json" } },
      );
      if (!res.ok) return false;
      const data = (await res.json()) as { verified?: boolean };
      if (!data.verified) return false;

      challengeId = record.challengeId;
      markEmailVerified();
      return true;
    } catch {
      // Transient network error — fall back to the normal send flow.
      return false;
    }
  }

  verifyButton?.addEventListener("click", async () => {
    if (Date.now() < verifyButtonLockedUntil) return;
    const typedEmail = emailInput?.value ?? "";
    try {
      // Dropoff resume first: an already-verified challenge from this exact
      // system skips the email round-trip entirely (server re-validated above).
      if (await tryResumeVerification(typedEmail)) return;

      const recaptchaToken = await executeRecaptcha("signup_verify_email");
      const res = await fetch("/api/auth/verify-email-request", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: typedEmail,
          recaptcha_token: recaptchaToken,
          company_website: "",
        }),
      });
      const data = await res.json();

      if (res.status === 429) {
        setBotLockout();
        return;
      }
      if (!res.ok) {
        showError(
          data.error?.message || "Could not send the verification email.",
        );
        return;
      }

      challengeId = data.challenge_id as string;
      resendCount += 1;

      // >3 resend attempts triggers the 30-minute client-side lockout.
      if (resendCount > 3) {
        setBotLockout();
        return;
      }

      verifyButtonLockedUntil = Date.now() + 15_000;
      emailRequested = true;
      renderVerifyButton(); // "Email Sent ✓", disabled while locked

      // Remember the challenge (email + system signature) so a dropoff within
      // the 15-minute TTL can resume without sending a second email.
      if (resumeStorage) {
        writeSignupResume(resumeStorage, {
          email: normalizeEmail(typedEmail),
          challengeId: data.challenge_id as string,
          signature: deviceSignature,
          requestedAt: Date.now(),
        });
      }

      startPolling();

      setTimeout(() => {
        // Lock expired: back to an enabled button (Resend verification when
        // the value is still valid, otherwise stays disabled).
        if (!emailVerified) renderVerifyButton();
      }, 15_000);
    } catch {
      showError("Service temporarily unavailable. Please try again later.");
    }
  });

  // ── password & submit gating ─────────────────────────────────────────────
  passwordInput?.addEventListener("input", updateSubmitState);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!submitBtn || submitBtn.disabled) return;

    try {
      const recaptchaToken = await executeRecaptcha("signup_submit");
      const honeypot = form.querySelector<HTMLInputElement>(
        'input[name="company_website"]',
      )?.value;

      const res = await fetch("/api/auth/signup", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          username: usernameInput?.value ?? "",
          email: emailInput?.value ?? "",
          password: passwordInput?.value ?? "",
          challenge_id: challengeId,
          recaptcha_token: recaptchaToken,
          company_website: honeypot ?? "",
        }),
      });

      const data = await res.json();

      if (res.status === 201) {
        // The challenge was consumed server-side; drop the resume record so a
        // stale challenge can never be reused after registration.
        if (resumeStorage) clearSignupResume(resumeStorage);
        writeCachedAuthStatus({
          authenticated: true,
          username: data.username ?? null,
        });
        window.location.href = "/";
        return;
      }

      showError(data.error?.message || "Could not create your account.");
    } catch {
      showError("Service temporarily unavailable. Please try again later.");
    }
  });
</script>

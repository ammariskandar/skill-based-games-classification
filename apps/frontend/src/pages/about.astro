---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="About"
  description="MyGameDNA is a web application that classifies games across three skill-based dimensions — Micro, Mystiko, and Macro — within separate Challenge and Reward profiles."
  canonicalPath="/about"
>
  <div class="mb-8 flex flex-col gap-2">
    <h1
      class="text-3xl font-bold tracking-tight text-(--color-text) sm:text-4xl"
    >
      About
    </h1>
    <p class="max-w-4xl text-base text-muted sm:text-lg">
      MyGameDNA is a web application that classifies games across three
      skill-based dimensions — Micro, Mystiko, and Macro — within separate
      Challenge and Reward profiles.
    </p>
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildRadarHtml } from "../lib/radar-render";

export const prerender = true;

// Static sample chart: Portal 2's published classification, rendered once at
// build time into a fully static inline SVG.  Zero client-side calculation,
// zero runtime fetching, zero dynamic SSR overhead.
const SAMPLE_RADAR = buildRadarHtml({
  challenge: { micro: 50, mystiko: 30, macro: 20 },
  reward: { micro: 10, mystiko: 60, macro: 30 },
  gameTitle: "Portal 2",
  showToggle: false,
});
---

<BaseLayout
  title="Methodology"
  description="Read to understand how MyGameDNA calculates the overall Games' scores based on user submissions."
  canonicalPath="/methodology"
>
  <div class="mb-8 flex flex-col gap-2">
    <h1
      class="text-3xl font-bold tracking-tight text-(--color-text) sm:text-4xl"
    >
      Methodology
    </h1>
    <p class="max-w-4xl text-base text-muted sm:text-lg">
      Read to understand how we calculate the overall Games' scores based on
      user submissions.
    </p>
  </div>

  <!-- ── Top section: taxonomy + sample radar ─────────────────────────── -->
  <section class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-(--color-text)">
        Challenge vs. Reward
      </h2>
      <p class="mt-2 max-w-4xl text-base text-muted sm:text-lg">
        Every game receives two independent profiles. Each profile is scored
        across three dimensions — Micro, Macro, and Mystiko — and each profile
        sums independently to 100%.
      </p>

      <h3 class="mt-8 text-lg font-semibold text-(--color-text)">
        Challenge Profile
      </h3>
      <p class="mt-1 text-sm text-muted">
        Measures what specific human skills the game demands from the player to
        succeed.
      </p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          <span class="font-semibold text-(--color-micro)">Micro:</span>
          Sensorimotor reflexes, fine dexterity, millisecond mechanical timing, and
          input precision (e.g., flick shots, parry frames, rhythm execution).
        </li>
        <li>
          <span class="font-semibold text-(--color-macro)">Macro:</span>
          Long-term planning, economic efficiency, systemic build crafting, map awareness,
          and resource management.
        </li>
        <li>
          <span class="font-semibold text-(--color-mystiko)">Mystiko:</span>
          Deduction under uncertainty, predicting hidden enemy rotations, psychological
          bluffing, and game sense under fog-of-war.
        </li>
      </ul>

      <h3 class="mt-8 text-lg font-semibold text-(--color-text)">
        Reward Profile
      </h3>
      <p class="mt-1 text-sm text-muted">
        Measures what type of fulfillment, catharsis, or validation the player
        receives upon succeeding.
      </p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          <span class="font-semibold text-(--color-micro)">Micro:</span>
          Instant, localized, tactile feedback (e.g., headshot hitmarkers, combo multipliers,
          killstreak banners, round MVP awards).
        </li>
        <li>
          <span class="font-semibold text-(--color-macro)">Macro:</span>
          Permanent, outward prestige and long-term milestones (e.g., climbing competitive
          ELO ladders, rare achievements, account level progression).
        </li>
        <li>
          <span class="font-semibold text-(--color-mystiko)">Mystiko:</span>
          Cerebral, "invisible" satisfaction (e.g., the dopamine hit of a correct
          blind read, executing an unorthodox counter-strategy, discovering obscure
          narrative lore).
        </li>
      </ul>
    </div>

    <div
      class="rounded-xl border border-(--color-border-2) bg-(--color-surface) p-6"
    >
      <div class="mx-auto w-[63%]">
        <Fragment set:html={SAMPLE_RADAR} />
      </div>
      <p class="mt-4 text-center text-sm text-muted">
        Example: Portal 2 — Challenge (Micro 50 / Macro 20 / Mystiko 30) and
        Reward (Micro 10 / Macro 30 / Mystiko 60) each sum to 100%.
      </p>
    </div>
  </section>

  <!-- ── Aggregation pipelines ─────────────────────────────────────────── -->
  <section class="mt-16">
    <h2 class="text-2xl font-bold tracking-tight text-(--color-text)">
      How We Aggregate Submissions to Compute the Final Score
    </h2>
    <p class="mt-2 max-w-4xl text-base text-muted sm:text-lg">
      Three pipelines run on every classification epoch. They never run in
      isolation: Method 1 anchors the prior, while Methods 2 and 3 clean the
      population before the final consolidation step. Every method operates
      independently on the six scalar dimensions (Challenge and Reward × Micro,
      Macro, Mystiko), and each emits a continuous score that is later
      reconciled to an integer profile summing to 100 through largest-remainder
      allocation.
    </p>

    <!-- Method 1: diagram left, content right -->
    <article class="mt-12 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
      <div class="mx-auto w-[90%] rounded-lg bg-white p-2 shadow-sm">
        <img
          src="/images/methodology/method1-expert-roles.png"
          alt="Method 1: expert roles feeding into a role-weighted aggregation"
          loading="lazy"
          decoding="async"
          class="block w-full rounded"
        />
      </div>
      <div>
        <h3 class="text-xl font-bold tracking-tight text-(--color-text)">
          1. Method 1 — Expert-Sensitive Pipeline
        </h3>
        <p class="mt-1 text-sm font-medium text-muted">
          Role-weighted aggregation
        </p>
        <p class="mt-3 text-sm text-muted">
          A deterministic, role-weighted Bayesian anchor where submissions are
          prioritized based on verified domain familiarity and historical
          editorial accuracy.
        </p>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li>
            <span class="font-semibold text-(--color-text)"
              >Superuser / Staff:</span
            >
            Initial calibration weight ensuring foundational anchor stability during
            catalogue bootstrapping.
          </li>
          <li>
            <span class="font-semibold text-(--color-text)"
              >Domain / Genre Experts:</span
            >
            High weight assigned to verified players with deep mechanical mastery
            in the respective genre.
          </li>
          <li>
            <span class="font-semibold text-(--color-text)"
              >Community Contributors:</span
            >
            Base weight for open submissions, aggregating broad player sentiment.
          </li>
        </ul>
        <p class="mt-3 text-sm text-muted">
          Method 1 solves the cold-start problem when a game has few submissions
          (<code class="font-mono text-xs">N &lt; 10</code>). As the expert base
          expands, this system evolves toward the
          <strong class="text-(--color-text)"
            >Multiplicative Weights Update Method (MWUM)</strong
          >, dynamically penalizing inaccurate predictions and rewarding
          consistent calibration.
        </p>
        <a
          href="https://en.wikipedia.org/wiki/Multiplicative_weight_update_method"
          class="mt-4 inline-block text-sm font-medium text-blue hover:underline"
        >
          Learn more about Multiplicative Weights Update Method (MWUM)
        </a>
      </div>
    </article>

    <!-- Method 2: content left, diagram right -->
    <article class="mt-12 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
      <div class="lg:order-2">
        <div class="mx-auto w-[90%] rounded-lg bg-white p-2 shadow-sm">
          <img
            src="/images/methodology/isolation-forest.png"
            alt="Isolation Forest: anomalous data points isolated with fewer random partitions"
            loading="lazy"
            decoding="async"
            class="block w-full rounded"
          />
        </div>
      </div>
      <div class="lg:order-1">
        <h3 class="text-xl font-bold tracking-tight text-(--color-text)">
          2. Method 2 — Global Population Filtering
        </h3>
        <p class="mt-1 text-sm font-medium text-muted">
          Isolation Forest (iForest)
        </p>
        <p class="mt-3 text-sm text-muted">
          An unsupervised anomaly detection model that isolates global outliers
          across the six scalar dimensions without assuming normal
          distributions. Each dimension is scored by its own one-dimensional
          forest of
          <code class="font-mono text-xs">t = 512</code> isolation trees built on
          a subsample of
          <code class="font-mono text-xs">ψ = min(256, N)</code> submissions drawn
          without replacement, with each tree capped at height
          <code class="font-mono text-xs">ℓ = ⌈log₂ ψ⌉</code>.
        </p>
        <p class="mt-3 text-sm text-muted">
          Outliers are isolated using recursive random orthogonal partitioning
          trees: anomalous points (extreme coordinate swings) require
          significantly fewer splits to isolate. A submission's mean path length
          <code class="font-mono text-xs">h̄</code> across the forest yields the canonical
          anomaly score
          <code class="font-mono text-xs">s = 2^(−h̄ / c(ψ))</code> — short paths drive
          the score toward 1, a score near 0.5 matches the expected reference depth,
          and there is no contamination quota or forced rejection rate.
        </p>
        <p class="mt-3 text-sm text-muted">
          A submission is flagged in a dimension only when
          <code class="font-mono text-xs">s &gt; 0.60</code> — strictly greater-than,
          so a score of exactly 0.60 is retained. If at least
          <strong class="text-(--color-text)">2 of the 6 dimensions</strong>
          flag, the entire submission is rejected; every surviving submission carries
          equal weight (1.0) downstream. The run is fully seeded (<code
            class="font-mono text-xs">seed = 42</code
          >), so identical input populations reproduce identical flags within a
          calculation version.
        </p>
        <p class="mt-3 text-sm text-muted">
          Method 2 protects the dataset against chaotic haymakers, griefers,
          troll submissions, and bad-faith single-dimension flooding (e.g.,
          scoring a tactical game as 100/0/0 Micro out of spite).
        </p>
        <a
          href="https://en.wikipedia.org/wiki/Isolation_forest"
          class="mt-4 inline-block text-sm font-medium text-blue hover:underline"
        >
          Learn more about Isolation Forest
        </a>
      </div>
    </article>

    <!-- Method 3: diagram left, content right -->
    <article class="mt-12 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
      <div class="mx-auto w-[90%] rounded-lg bg-white p-2 shadow-sm">
        <img
          src="/images/methodology/loop-outliers.svg"
          alt="LoOP: a local density-based outlier diagram showing a point that clashes with its immediate neighborhood"
          loading="lazy"
          decoding="async"
          class="block w-full rounded"
        />
      </div>
      <div>
        <h3 class="text-xl font-bold tracking-tight text-(--color-text)">
          3. Method 3 — Global Population Density
        </h3>
        <p class="mt-1 text-sm font-medium text-muted">
          Local Outlier Probabilities (LoOP)
        </p>
        <p class="mt-3 text-sm text-muted">
          A local density-based statistical filter that calculates an outlier
          probability based on a submission's local neighborhood rather than
          global distance. It runs independently on each of the six scalar
          dimensions using the absolute distance
          <code class="font-mono text-xs">d = |x − y|</code>, a tie-inclusive
          <code class="font-mono text-xs">k = 10</code> nearest-neighbor neighborhood,
          and a standard-deviation extent
          <code class="font-mono text-xs">λ = 3</code>.
        </p>
        <p class="mt-3 text-sm text-muted">
          The pipeline computes each submission's probabilistic distance
          <code class="font-mono text-xs">pdist = λσ</code>, the neighborhood
          reference <code class="font-mono text-xs">pdist̄</code>, and the
          Probabilistic Local Outlier Factor
          <code class="font-mono text-xs">PLOF = pdist / pdist̄ − 1</code> — the relative
          excess local spread around a submission. Scores are normalized by
          <code class="font-mono text-xs">nPLOF = λ·√(Σ PLOF² / |F|)</code> and mapped
          into [0, 1] via the Gauss error function:
          <code class="font-mono text-xs"
            >LoOP = max[0, erf(PLOF / (nPLOF·√2))]</code
          >. A submission is flagged only when
          <code class="font-mono text-xs">LoOP &gt; 0.75</code> — strictly greater-than,
          so a score of exactly 0.75 is retained — and the same universal 2-of-6 rejection
          rule applies across the six dimensions.
        </p>
        <p class="mt-3 text-sm text-muted">
          <strong class="text-(--color-text)"
            >How it differs from iForest:</strong
          >
        </p>
        <ul class="mt-2 space-y-2 text-sm text-muted">
          <li>
            <span class="font-semibold text-(--color-text)"
              >iForest analogy:</span
            >
            Spotting a lone skyscraper in the middle of open farmland — an obvious
            global outlier.
          </li>
          <li>
            <span class="font-semibold text-(--color-text)">LoOP analogy:</span>
            Spotting a single suburban single-family home placed inside dense downtown
            Manhattan — it looks normal in isolation, but completely clashes with
            the density of its immediate neighbors.
          </li>
        </ul>
        <p class="mt-3 text-sm text-muted">
          Method 3 captures subtle sub-population disagreements. If a cluster of
          players agrees a game is Mystiko-heavy but a sub-cluster scores it as
          pure Macro within an otherwise cohesive local group, LoOP calculates
          the local reachability density and downweights the anomalous local
          cluster without discarding valid minority consensus.
        </p>
        <a
          href="https://en.wikipedia.org/wiki/Local_outlier_factor"
          class="mt-4 inline-block text-sm font-medium text-blue hover:underline"
        >
          Learn more about Local Outlier Factor (LOF) &amp; LoOP
        </a>
      </div>
    </article>
  </section>

  <!-- ── Architectural & statistical deep dives ───────────────────────── -->
  <section class="mt-16">
    <h2 class="text-2xl font-bold tracking-tight text-(--color-text)">
      Architectural &amp; Statistical Deep Dives
    </h2>

    <article class="mt-8 max-w-4xl">
      <h3 class="text-lg font-semibold text-(--color-text)">
        Why employ two different methods of removing outliers?
      </h3>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          <span class="font-semibold text-(--color-text)"
            >iForest strengths:</span
          >
          Efficient at catching wild, non-linear global outliers — 512 trees per dimension
          over a
          <code class="font-mono text-xs">min(256, N)</code> subsample, with no pairwise
          distance calculations at all.
        </li>
        <li>
          <span class="font-semibold text-(--color-text)"
            >iForest weaknesses:</span
          >
          Blind to local density variation; a small but legitimate consensus cluster
          that sits far from the global mass can be pruned as if it were noise. Its
          binary flag (
          <code class="font-mono text-xs">s &gt; 0.60</code> strict) says nothing
          about how far past the threshold an observation lies.
        </li>
        <li>
          <span class="font-semibold text-(--color-text)">LoOP strengths:</span>
          Produces a mathematically calibrated probability score
          <code class="font-mono text-xs">[0, 1]</code> from local neighborhood density
          (tie-inclusive
          <code class="font-mono text-xs">k = 10</code>, extent
          <code class="font-mono text-xs">λ = 3</code>), so a niche playstyle
          that is coherent within its own neighborhood survives even when it
          differs from the global majority.
        </li>
        <li>
          <span class="font-semibold text-(--color-text)">LoOP weaknesses:</span
          >
          Computationally intensive (<code class="font-mono text-xs">O(N²)</code
          >
          pairwise distance checks) and sensitive to the neighborhood size
          <code class="font-mono text-xs">k</code>. Its flag is also strictly
          greater-than (<code class="font-mono text-xs">LoOP &gt; 0.75</code>),
          and a LoOP probability is a relative anomaly measure, not a posterior
          probability that a submitter is wrong.
        </li>
      </ul>
      <p class="mt-3 text-sm text-muted">
        The reality of data &amp; hardware: combining global tree-based
        isolation with local density probabilities ensures the platform is
        protected against malicious vandalism without erasing genuine subjective
        nuance. Neither engine is a popularity vote, and neither engine can
        unilaterally decide a classification — each only prunes submissions
        before the BHPCM consolidation stage.
      </p>
    </article>

    <article class="mt-10 max-w-4xl">
      <h3 class="text-lg font-semibold text-(--color-text)">
        In what scenarios would Method 1 ever "beat" Methods 2 and 3 in
        reliability?
      </h3>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          <span class="font-semibold text-(--color-text)"
            >The cold-start trap:</span
          >
          Methods 2 and 3 are only invoked once a population reaches
          <code class="font-mono text-xs">N ≥ 20</code>; below that threshold
          the statistical engines are dormant and the anchored prior is the
          entire calculation. Even in the 20–50 range, small samples lack the
          statistical power to distinguish a genuine niche opinion from an
          anomaly, so outlier rejection can misclassify valid minority
          viewpoints.
        </li>
        <li>
          <span class="font-semibold text-(--color-text)"
            >Expert calibration:</span
          >
          In early classification epochs, a single verified expert submission anchored
          via Method 1 provides a mathematically grounded baseline that prevents uncalibrated
          public sentiment from skewing the initial index. As N grows, the anchor's
          influence is diluted rather than removed — it remains represented but ceases
          to dominate.
        </li>
      </ul>
    </article>

    <article class="mt-10 max-w-4xl">
      <h3 class="text-lg font-semibold text-(--color-text)">
        Why is "Superuser" even a role in Method 1?
      </h3>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          <span class="font-semibold text-(--color-text)"
            >Operational checks &amp; balances:</span
          >
          Serves strictly as a bootstrapping mechanism to establish ground-truth anchors
          across initial catalogue releases.
        </li>
        <li>
          <span class="font-semibold text-(--color-text)"
            >Classification ≠ quality judgments:</span
          >
          MyGameDNA measures <em>what kind of game a title is</em>, not whether
          it is <em>good or bad</em>. A Superuser bias has zero moral or
          commercial impact on review aggregates — it merely anchors mechanical
          categorization.
        </li>
        <li>
          <span class="font-semibold text-(--color-text)"
            >Pledge of impartiality:</span
          >
          Staff classifications pledge strict adherence to observable mechanical inputs.
          As the contributor and expert dataset matures, the Superuser weighting phase-out
          is baked into the convergence algorithm. Feedback is continuously welcome.
        </li>
      </ul>
    </article>

    <article class="mt-10 max-w-4xl">
      <h3 class="text-lg font-semibold text-(--color-text)">
        How are the three methods consolidated into a single score?
      </h3>
      <p class="mt-3 text-sm text-muted">
        <span class="font-semibold text-(--color-text)">
          Bayesian Hierarchical Pluralistic Consensus Model (BHPCM):
        </span>
        rather than computing an arithmetic mean (which is vulnerable to residual
        skew), BHPCM treats a skill profile as a composition and works in
        <span class="text-(--color-text)"
          >isometric log-ratio (ilr / Aitchison) geometry</span
        >, where the six components are embedded in a five-dimensional log-ratio
        space and distances between profiles are measured with the Aitchison
        distance — never Euclidean distance on raw percentages. Method 1
        supplies the
        <span class="text-(--color-text)">expertise-sensitive prior</span>;
        Methods 2 and 3 provide the cleaned
        <span class="text-(--color-text)">population likelihood</span>, treated
        as correlated perspectives on the same submissions rather than
        independent votes. A stratified bootstrap resamples the submission
        population to propagate uncertainty through both perspectives, and the
        posterior distribution of the governed compromise yields the unified
        score plus a mathematical
        <span class="text-(--color-text)">Confidence Level</span>.
      </p>
      <p class="mt-3 text-sm text-muted">
        <span class="font-semibold text-(--color-text)">
          Why BHPCM beats simple or weighted averages:
        </span>
      </p>
      <ul class="mt-2 space-y-2 text-sm text-muted">
        <li>
          <span class="font-semibold text-(--color-text)"
            >Variance shrinkage:</span
          >
          Automatically pulls extreme scores toward the consensus mean when sample
          variance is high.
        </li>
        <li>
          <span class="font-semibold text-(--color-text)"
            >Dynamic uncertainty weighting:</span
          >
          The influence of the expertise perspective is bounded by explicit governance
          parameters — a permitted minimum and maximum. If Methods 2 and 3 show high
          inter-method agreement, the model reduces the prior's influence toward its
          minimum, transitioning smoothly from expert-led to community-led governance;
          strong expert–population disagreement similarly tamps the expert anchor
          down rather than letting either side win by default.
        </li>
        <li>
          <span class="font-semibold text-(--color-text)"
            >Integer reconciliation:</span
          >
          The posterior is a continuous composition; the published profile is recovered
          by largest-remainder allocation so each profile sums to exactly 100, with
          a fixed tie priority (Micro wins a 0.5/0.5 Micro–Mystiko remainder tie).
        </li>
      </ul>
    </article>
  </section>
</BaseLayout>

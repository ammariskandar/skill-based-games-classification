---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import FormField from "../components/ui/FormField.astro";
import TextInput from "../components/ui/TextInput.astro";
import SelectInput from "../components/ui/SelectInput.astro";
import TextArea from "../components/ui/TextArea.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import DataTable from "../components/ui/DataTable.astro";
import ItemList from "../components/ui/ItemList.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import LoadingState from "../components/ui/LoadingState.astro";
import ErrorState from "../components/ui/ErrorState.astro";

export const prerender = true;
---

<BaseLayout
  title="UI Foundations"
  description="Internal component showcase for the MyGameDNA design system."
  robots="noindex, nofollow"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">UI Foundations</h1>
  <p class="mt-2 text-muted">
    Internal component showcase. Not linked in primary navigation.
  </p>

  <!-- ── Buttons ── -->
  <section class="mt-10">
    <h2 class="text-xl font-semibold">Button</h2>
    <div class="mt-4 flex flex-wrap items-end gap-3">
      <Button>Primary</Button>
      <Button variant="secondary">Secondary</Button>
      <Button variant="ghost">Ghost</Button>
      <Button variant="danger">Danger</Button>
    </div>
    <div class="mt-3 flex flex-wrap items-end gap-3">
      <Button disabled>Disabled</Button>
      <Button loading>Loading</Button>
      <Button fullWidth>Full Width</Button>
    </div>
  </section>

  <!-- ── Form ── -->
  <section class="mt-10">
    <h2 class="text-xl font-semibold">Form Controls</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-2">
      <FormField
        label="Username"
        for="demo-user"
        required
        helpText="Choose a unique username."
      >
        <TextInput
          id="demo-user"
          name="username"
          placeholder="e.g. player1"
          describedBy="help-demo-user"
        />
      </FormField>
      <FormField label="Email" for="demo-email">
        <TextInput
          id="demo-email"
          name="email"
          type="email"
          placeholder="you@example.com"
        />
      </FormField>
      <FormField
        label="Password"
        for="demo-pass"
        error="Must be at least 8 characters."
      >
        <TextInput
          id="demo-pass"
          name="password"
          type="password"
          invalid
          describedBy="error-demo-pass"
        />
      </FormField>
      <FormField label="Role" for="demo-role">
        <SelectInput id="demo-role" name="role">
          <option>Contributor</option>
          <option>Moderator</option>
          <option>Admin</option>
        </SelectInput>
      </FormField>
      <FormField label="Bio" for="demo-bio" helpText="Brief introduction.">
        <TextArea
          id="demo-bio"
          name="bio"
          placeholder="Tell us about yourself…"
          describedBy="help-demo-bio"
        />
      </FormField>
      <FormField label="Disabled" for="demo-dis">
        <TextInput
          id="demo-dis"
          name="disabled"
          placeholder="Cannot edit"
          disabled
        />
      </FormField>
    </div>
  </section>

  <!-- ── Card ── -->
  <section class="mt-10">
    <h2 class="text-xl font-semibold">Card</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <Card>
        <h3 class="font-semibold text-text">Default card</h3>
        <p class="mt-1 text-sm text-muted">
          Cards work in fluid grids and adapt to column counts.
        </p>
      </Card>
      <Card>
        <h3 class="font-semibold text-text">With more content</h3>
        <p class="mt-1 text-sm text-muted">
          A longer description to show how cards handle varying content heights
          naturally.
        </p>
      </Card>
      <Card>
        <p class="text-sm text-muted">
          Cards have no mandatory header. Content is flexible.
        </p>
      </Card>
    </div>
  </section>

  <!-- ── Badge ── -->
  <section class="mt-10">
    <h2 class="text-xl font-semibold">Badge</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      <Badge>Neutral</Badge>
      <Badge variant="positive">Positive</Badge>
      <Badge variant="warning">Warning</Badge>
      <Badge variant="negative">Negative</Badge>
      <Badge variant="info">Info</Badge>
    </div>
  </section>

  <!-- ── DataTable ── -->
  <section class="mt-10">
    <h2 class="text-xl font-semibold">Data Table</h2>
    <div class="mt-4">
      <DataTable caption="Example game data">
        <thead>
          <tr class="text-left text-xs uppercase text-muted">
            <th scope="col" class="px-4 py-3 font-medium">Game</th>
            <th scope="col" class="px-4 py-3 font-medium">Year</th>
            <th scope="col" class="px-4 py-3 font-medium">Micro</th>
            <th scope="col" class="px-4 py-3 font-medium">Mystiko</th>
            <th scope="col" class="px-4 py-3 font-medium">Macro</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr class="even:bg-surface/50">
            <td class="px-4 py-2.5 text-text">Apex Legends</td>
            <td class="px-4 py-2.5 text-muted">2019</td>
            <td class="px-4 py-2.5">9.1</td>
            <td class="px-4 py-2.5">2.8</td>
            <td class="px-4 py-2.5">4.2</td>
          </tr>
          <tr class="even:bg-surface/50">
            <td class="px-4 py-2.5 text-text">Civilization VI</td>
            <td class="px-4 py-2.5 text-muted">2016</td>
            <td class="px-4 py-2.5">2.3</td>
            <td class="px-4 py-2.5">5.7</td>
            <td class="px-4 py-2.5">9.4</td>
          </tr>
          <tr class="even:bg-surface/50">
            <td class="px-4 py-2.5 text-text">Elden Ring</td>
            <td class="px-4 py-2.5 text-muted">2022</td>
            <td class="px-4 py-2.5">7.5</td>
            <td class="px-4 py-2.5">4.2</td>
            <td class="px-4 py-2.5">4.8</td>
          </tr>
        </tbody>
      </DataTable>
    </div>
  </section>

  <!-- ── ItemList ── -->
  <section class="mt-10">
    <h2 class="text-xl font-semibold">Item List</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-2">
      <div>
        <h3 class="text-sm font-medium text-text">Unordered</h3>
        <ItemList class="mt-2">
          <li>Mechanical execution</li>
          <li>Timing and precision</li>
          <li>Reaction speed</li>
        </ItemList>
      </div>
      <div>
        <h3 class="text-sm font-medium text-text">Ordered</h3>
        <ItemList type="ol" class="mt-2">
          <li>Select a game</li>
          <li>Review its classification</li>
          <li>Compare profiles</li>
        </ItemList>
      </div>
    </div>
  </section>

  <!-- ── States ── -->
  <section class="mt-10">
    <h2 class="text-xl font-semibold">States</h2>
    <div class="mt-4 space-y-6">
      <Card>
        <h3 class="font-semibold text-text">Empty State</h3>
        <EmptyState
          title="No games found"
          description="Try adjusting your search or filters."
        >
          <Button variant="secondary">Clear filters</Button>
        </EmptyState>
      </Card>
      <Card>
        <h3 class="font-semibold text-text">Loading State</h3>
        <LoadingState text="Fetching game data…" />
      </Card>
      <Card>
        <h3 class="font-semibold text-text">Error State</h3>
        <ErrorState
          title="Failed to load games"
          message="The server returned an unexpected error. Please try again."
        >
          <Button variant="secondary">Retry</Button>
        </ErrorState>
      </Card>
    </div>
  </section>
</BaseLayout>

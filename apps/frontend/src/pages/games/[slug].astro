---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClassificationDisplay from "../../components/classification/ClassificationDisplay.astro";
import GameInformation from "../../components/game/GameInformation.astro";
import {
  GameNotFoundError,
  getGameDetail,
  type GameDetailResponse,
} from "../../lib/server/api/games";

const slug = Astro.params.slug;

if (!slug) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

let detail: GameDetailResponse;
try {
  detail = await getGameDetail(slug);
} catch (error: unknown) {
  if (error instanceof GameNotFoundError) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }
  throw error;
}

const { game, classification } = detail;
const description = game.description.trim();
---

<BaseLayout
  title={game.name}
  description={description || undefined}
  canonicalPath={`/games/${game.slug}`}
>
  <article>
    <header>
      <p class="text-sm font-semibold uppercase tracking-wider text-muted">
        {game.source === "steam" ? "Steam" : "Manual"}
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
        {game.name}
      </h1>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[3fr_2fr] lg:items-start">
      <div>
        {
          game.image_url && (
            <div class="overflow-hidden rounded-lg border border-border bg-surface">
              <img
                src={game.image_url}
                alt={`${game.name} cover image`}
                class="aspect-video h-auto w-full object-cover"
                loading="lazy"
              />
            </div>
          )
        }
      </div>

      <div class="space-y-8">
        <GameInformation game={game} />
        <ClassificationDisplay classification={classification} />
      </div>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameDetailBody from "../../components/game/GameDetailBody.astro";
import ErrorState from "../../components/ui/ErrorState.astro";
import {
  GameNotFoundError,
  getGameDetail,
  type GameDetailResponse,
} from "../../lib/server/api/games";
import {
  buildCanonicalUrl,
  buildVideoGameJsonLd,
  resolveSiteOrigin,
} from "../../lib/seo";

const slug = Astro.params.slug;

if (!slug) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

type PageState =
  { kind: "game"; detail: GameDetailResponse } | { kind: "service-error" };

let state: PageState;
try {
  state = {
    kind: "game",
    detail: await getGameDetail(slug, { signal: Astro.request.signal }),
  };
} catch (error: unknown) {
  if (error instanceof GameNotFoundError) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }
  // Timeout, network failure, Django 5xx, or a malformed response all mean the
  // service is unavailable: render a real 5xx — never a 404, and never a 200
  // "error page" that would mislead users and crawlers about availability.
  // 503 (Service Unavailable) reflects that the outage is upstream-dependent.
  Astro.response.status = 503;
  state = { kind: "service-error" };
}

const game = state.kind === "game" ? state.detail.game : null;
const classification =
  state.kind === "game" ? state.detail.classification : null;
const title = game ? game.name : "Something went wrong";

const siteOrigin = resolveSiteOrigin(import.meta.env.PUBLIC_SITE_URL);

const persistedDescription = game
  ? game.description.trim() || undefined
  : undefined;
const description = game
  ? (persistedDescription ??
    `Explore the Challenge and Reward skill profiles for ${game.name} across Micro, Mystiko, and Macro on MyGameDNA.`)
  : undefined;

const canonicalPath = game ? `/games/${game.slug}` : undefined;

const image = game ? game.image_url.trim() || undefined : undefined;
const imageAlt = game && image ? `${game.name} cover image` : undefined;

const jsonLd = game
  ? buildVideoGameJsonLd({
      name: game.name,
      url: buildCanonicalUrl(siteOrigin, `/games/${game.slug}`),
      description: persistedDescription,
      image,
      datePublished: game.release_date ?? undefined,
    })
  : undefined;

const robots = game ? undefined : "noindex, nofollow";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  robots={robots}
  image={image}
  imageAlt={imageAlt}
  jsonLd={jsonLd}
>
  {
    game === null ? (
      <ErrorState
        title="We couldn't load this game right now."
        message="Please try again in a moment."
        code="SERVICE_UNAVAILABLE"
        headingLevel="h1"
      >
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={Astro.url.pathname}
            class="text-sm font-medium text-blue hover:underline"
          >
            Try again →
          </a>
          <a href="/" class="text-sm font-medium text-blue hover:underline">
            Go Home →
          </a>
        </div>
      </ErrorState>
    ) : (
      <GameDetailBody game={game} classification={classification} />
    )
  }
</BaseLayout>

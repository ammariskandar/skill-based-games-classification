---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Dev-only test fixture (SBGC-226). Renders the real site header plus a
// deliberately long, scrollable body, a sticky page-inset bar, and a native
// modal so the Playwright suite can assert navbar stickiness, the z-index
// hierarchy, and top-layer dialog behavior without a Django backend. Not
// linked from any production page.
export const prerender = true;
---

<BaseLayout title="Navbar fixture" robots="noindex, nofollow">
  <div class="mx-auto max-w-3xl">
    <div
      data-sticky-inset
      class="sticky top-16 z-sticky-inset rounded-lg border border-border bg-surface-2 px-4 py-3 text-sm text-text"
    >
      Sticky filter bar
    </div>

    <div class="mt-6 flex items-center gap-3">
      <p class="text-sm text-muted">
        Scroll down to verify the navbar stays pinned above this sticky bar.
      </p>
      <button
        id="fixture-dialog-open"
        type="button"
        class="rounded-lg border border-border bg-surface-2 px-3 py-1.5 text-sm text-text"
      >
        Open dialog
      </button>
    </div>

    <dialog
      id="fixture-dialog"
      class="fixed inset-0 m-auto w-[min(92vw,28rem)] rounded-xl border border-border bg-surface p-6 text-text backdrop:bg-black/60"
    >
      <p class="text-sm text-text">Fixture modal (top layer)</p>
      <form method="dialog" class="mt-4 flex justify-end">
        <button
          id="fixture-dialog-close"
          type="submit"
          class="rounded-lg bg-blue px-3 py-1.5 text-sm font-semibold text-white"
        >
          Close
        </button>
      </form>
    </dialog>

    <div class="mt-6 space-y-6" data-tall-content>
      {
        Array.from({ length: 120 }, (_, index) => (
          <div class="rounded-lg border border-border bg-surface p-4 text-sm text-muted">
            Scroll content row {index + 1}
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const openButton = document.getElementById(
    "fixture-dialog-open",
  ) as HTMLButtonElement | null;
  const dialog = document.getElementById(
    "fixture-dialog",
  ) as HTMLDialogElement | null;
  openButton?.addEventListener("click", () => dialog?.showModal());
</script>

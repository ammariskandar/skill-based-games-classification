---
import "../../styles/global.css";
import ProfileAvatar from "../../components/profile/ProfileAvatar.astro";
import ProfileBioCard from "../../components/profile/ProfileBioCard.astro";
import ProfileHeader from "../../components/profile/ProfileHeader.astro";
import EditProfileModal from "../../components/profile/EditProfileModal.astro";

// Dev-only test fixture (SBGC-222). Renders the real profile components with
// static owner data so the Playwright suite can assert the edit-profile modal
// behaviour without the Django backend. Not linked from any production page.
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit-profile fixture</title>
  </head>
  <body>
    <main class="shell-gutter mx-auto max-w-7xl py-8">
      <ProfileHeader
        username="fixture-user"
        firstName="Fixture"
        lastName="User"
        isOwner={true}
      />

      <div
        class="flex flex-col items-center gap-6 md:flex-row md:items-start md:gap-8"
      >
        <div class="flex flex-col items-center gap-4">
          <ProfileAvatar avatarKey="male_1" borderType="NONE" />
        </div>
        <ProfileBioCard bio="" bioMode="PLAIN" />
      </div>

      <EditProfileModal
        username="fixture-user"
        firstName="Fixture"
        lastName="User"
        bio=""
        bioMode="PLAIN"
        avatarKey="male_1"
        borderType="NONE"
        borderPresetId={null}
        borderColor=""
      />
    </main>
  </body>
</html>

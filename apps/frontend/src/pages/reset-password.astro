---
import BaseLayout from "../layouts/BaseLayout.astro";
import PasswordStrengthMeter from "../components/ui/PasswordStrengthMeter.astro";

// SSR only: the emailed token is exchanged for a one-chance session nonce
// client-side (via the BFF) the moment the human opens the page.
export const prerender = false;

const token = Astro.url.searchParams.get("token") ?? "";
const hasToken = token.length > 0;

// Honeypot field name is randomized per page render so browser / password-
// manager autofill cannot populate the trap and turn a real user into a "bot".
const honeypotName = `honey_${Date.now().toString(36)}${Math.random()
  .toString(36)
  .slice(2, 8)}`;
---

<BaseLayout
  title="Reset Password - MyGameDNA"
  description="Set a new password for your MyGameDNA account."
  robots="noindex, follow"
  showSpamWarning
>
  <main
    class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center px-4 py-12"
  >
    <div
      id="reset-password-card"
      class="rounded-xl border border-border bg-surface p-8 shadow-sm"
    >
      <header class="mb-6 text-center">
        <h1 class="text-2xl font-bold tracking-tight text-text">
          Set a New Password
        </h1>
        <p class="mt-1 text-sm text-muted">
          {
            hasToken
              ? "This link works once — do not refresh this page."
              : "Invalid or missing reset token."
          }
        </p>
      </header>

      {
        !hasToken && (
          <div
            class="rounded-lg border border-red/30 bg-red/10 p-4 text-sm text-red"
            role="alert"
          >
            <p>
              This reset link is invalid or has expired. Please request a new
              one.
            </p>
            <a
              href="/reset"
              class="mt-3 inline-flex items-center rounded-lg bg-blue px-4 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
            >
              Request a new reset link
            </a>
          </div>
        )
      }

      <div
        id="reset-checking"
        class="hidden text-center text-sm text-muted"
        role="status"
      >
        <p>Checking your reset link…</p>
      </div>

      <div
        id="reset-expired"
        class="hidden rounded-lg border border-red/30 bg-red/10 p-4 text-sm text-red"
        role="alert"
      >
        <p class="font-medium">
          This reset link has expired or has already been used.
        </p>
        <p class="mt-1">
          Please request a new one — each link can only be used once.
        </p>
        <a
          href="/reset"
          class="mt-3 inline-flex items-center rounded-lg bg-blue px-4 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
        >
          Request a new reset link
        </a>
      </div>

      <div
        id="reset-error-banner"
        role="alert"
        class="mb-6 hidden rounded-lg border border-red/30 bg-red/10 p-3 text-sm text-red"
      >
        <span id="reset-error-message">Something went wrong.</span>
      </div>

      <form id="reset-password-form" class="hidden flex-col gap-4" novalidate>
        <!-- Honeypot trap (off-screen, randomized name) -->
        <input
          type="text"
          id="reset-hp-trap"
          name={honeypotName}
          tabindex="-1"
          autocomplete="off"
          class="hidden-field"
          style="position: absolute; left: -9999px;"
          aria-hidden="true"
        />

        <div>
          <label for="new-password" class="block text-sm font-medium text-text">
            New password
          </label>
          <input
            id="new-password"
            name="new_password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-dim focus:border-blue focus:outline-none focus:ring-1 focus:ring-blue"
          />
          <PasswordStrengthMeter inputId="new-password" />
        </div>

        <div>
          <label
            for="confirm-password"
            class="block text-sm font-medium text-text"
          >
            Re-confirm new password
          </label>
          <input
            id="confirm-password"
            name="confirm_password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            onpaste="return false;"
            oncopy="return false;"
            oncut="return false;"
            class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-dim focus:border-blue focus:outline-none focus:ring-1 focus:ring-blue"
          />
          <span
            id="confirm-password-hint"
            class="mt-1 block min-h-4 text-xs text-muted"></span>
        </div>

        <button
          id="reset-password-submit"
          type="submit"
          disabled
          class="mt-2 flex w-full items-center justify-center rounded-lg bg-blue px-4 py-2.5 text-sm font-semibold text-bg shadow-sm transition-opacity hover:opacity-90 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue disabled:opacity-50"
        >
          <span>Reset Password</span>
        </button>
      </form>
    </div>
  </main>
</BaseLayout>

<script>
  import { isPasswordStrong } from "../lib/password-strength";

  // One-chance session nonce, received after the token is claimed.  While it
  // is held and the form has not been submitted, leaving this page burns it on
  // the server (reload, back-navigation, or tab close cannot replay the token).
  let sessionNonce: string | null = null;
  let formSubmitted = false;

  // reCAPTCHA v3 is opt-in: without a site key the page skips it and sends a
  // `test-recaptcha-token` the DEBUG backend accepts.
  const SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || "";

  type Recaptcha = {
    ready: (cb: () => void) => void;
    execute: (siteKey: string, opts: { action: string }) => Promise<string>;
  };
  const grecaptcha = (window as unknown as { grecaptcha?: Recaptcha })
    .grecaptcha;

  function showError(message: string): void {
    const banner = document.getElementById("reset-error-banner");
    const msg = document.getElementById("reset-error-message");
    if (!banner || !msg) return;
    msg.textContent = message;
    banner.classList.remove("hidden");
    banner.classList.add("flex");
  }

  function showExpiredState(): void {
    const expired = document.getElementById("reset-expired");
    const form = document.getElementById("reset-password-form");
    form?.classList.add("hidden");
    form?.classList.remove("flex");
    expired?.classList.remove("hidden");
  }

  function executeRecaptcha(action: string): Promise<string> {
    if (!SITE_KEY) return Promise.resolve("test-recaptcha-token");
    return new Promise((resolve, reject) => {
      if (!grecaptcha) {
        reject(new Error("reCAPTCHA not loaded"));
        return;
      }
      grecaptcha.ready(() => {
        grecaptcha.execute(SITE_KEY, { action }).then(resolve).catch(reject);
      });
    });
  }

  async function verifyToken(token: string): Promise<void> {
    try {
      const res = await fetch("/api/auth/verify-reset-token", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token }),
      });
      const data = (await res.json()) as {
        valid?: boolean;
        session_nonce?: string | null;
      };

      if (res.ok && data.valid && data.session_nonce) {
        sessionNonce = data.session_nonce;
        const checking = document.getElementById("reset-checking");
        const form = document.getElementById("reset-password-form");
        checking?.classList.add("hidden");
        form?.classList.remove("hidden");
        form?.classList.add("flex");
        return;
      }
      showExpiredState();
    } catch {
      showError("Service temporarily unavailable. Please try again later.");
    }
  }

  // ── password gating ──────────────────────────────────────────────────────
  const form = document.getElementById("reset-password-form");
  const passwordInput = document.getElementById(
    "new-password",
  ) as HTMLInputElement | null;
  const confirmInput = document.getElementById(
    "confirm-password",
  ) as HTMLInputElement | null;
  const confirmHint = document.getElementById("confirm-password-hint");
  const submitBtn = document.getElementById(
    "reset-password-submit",
  ) as HTMLButtonElement | null;

  function syncSubmitGate(): void {
    const password = passwordInput?.value ?? "";
    const confirm = confirmInput?.value ?? "";
    const strong = isPasswordStrong(password);
    const matches = confirm !== "" && password === confirm;

    if (submitBtn) {
      submitBtn.disabled = !(strong && matches);
    }
    if (confirmHint) {
      if (confirm === "") {
        confirmHint.textContent = "";
      } else if (!matches) {
        confirmHint.textContent = "Passwords do not match.";
        confirmHint.className = "mt-1 block min-h-4 text-xs text-red";
      } else if (!strong) {
        confirmHint.textContent = "Password is not strong enough yet.";
        confirmHint.className = "mt-1 block min-h-4 text-xs text-red";
      } else {
        confirmHint.textContent = "Passwords match.";
        confirmHint.className = "mt-1 block min-h-4 text-xs text-green";
      }
    }
  }

  passwordInput?.addEventListener("input", syncSubmitGate);
  confirmInput?.addEventListener("input", syncSubmitGate);

  // ── anti-abandonment burn ────────────────────────────────────────────────
  window.addEventListener("beforeunload", () => {
    if (sessionNonce && !formSubmitted) {
      navigator.sendBeacon(
        "/api/auth/burn-reset-token",
        new Blob([JSON.stringify({ session_nonce: sessionNonce })], {
          type: "application/json",
        }),
      );
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!submitBtn || submitBtn.disabled) return;

    // Stop the beforeunload burn: the token is being redeemed now.
    formSubmitted = true;

    try {
      const recaptchaToken = await executeRecaptcha("reset_password").catch(
        () => {
          showError("Could not verify you are human. Please try again.");
          formSubmitted = false;
          return null;
        },
      );
      if (recaptchaToken === null) return;

      const honeypot = (
        document.getElementById("reset-hp-trap") as HTMLInputElement | null
      )?.value;

      const res = await fetch("/api/auth/reset-password-confirm", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          session_nonce: sessionNonce,
          new_password: passwordInput?.value ?? "",
          recaptcha_token: recaptchaToken,
          company_website: honeypot ?? "",
        }),
      });
      const data = (await res.json()) as {
        error?: { code?: string; message?: string };
      };

      if (res.status === 400 && data.error?.code === "EXPIRED_RESET_TOKEN") {
        // The nonce was already consumed (e.g. a stale duplicate submit).
        sessionNonce = null;
        showExpiredState();
        return;
      }
      if (!res.ok) {
        showError(data.error?.message || "Could not reset your password.");
        formSubmitted = false; // Leaving now burns the remaining nonce.
        return;
      }

      // Success: land on the home page (logged out) with the reset toast.
      sessionNonce = null;
      window.location.href = "/";
    } catch {
      showError("Service temporarily unavailable. Please try again later.");
      formSubmitted = false;
    }
  });

  // ── boot ─────────────────────────────────────────────────────────────────
  const params = new URLSearchParams(window.location.search);
  const token = params.get("token");

  if (token) {
    // Server already rendered the missing-token state when there is no token.
    if (SITE_KEY) {
      const recaptchaScript = document.createElement("script");
      recaptchaScript.src = `https://www.google.com/recaptcha/api.js?render=${SITE_KEY}`;
      recaptchaScript.async = true;
      document.head.appendChild(recaptchaScript);
    }

    const checking = document.getElementById("reset-checking");
    checking?.classList.remove("hidden");
    void verifyToken(token);
  }
</script>
